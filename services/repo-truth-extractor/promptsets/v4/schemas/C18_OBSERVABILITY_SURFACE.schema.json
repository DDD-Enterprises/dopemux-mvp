{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "promptsets/v4/schemas/C18_OBSERVABILITY_SURFACE.schema.json",
  "title": "OBSERVABILITY_SURFACE@v1",
  "type": "object",
  "required": ["schema", "items"],
  "properties": {
    "schema": { "const": "OBSERVABILITY_SURFACE@v1" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "surface_type", "mechanism", "path", "line_range", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "surface_type": {
            "type": "string",
            "enum": ["logger_config", "structured_logger", "metric_emitter", "health_endpoint", "readiness_endpoint", "metrics_endpoint", "otel_instrumentation"]
          },
          "mechanism": { "type": "string" },
          "path": { "type": "string" },
          "line_range": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
          "evidence": { "type": "array", "minItems": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
