{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "promptsets/v4/schemas/C8_SECRETS_RISK_LOCATIONS.schema.json",
  "title": "SECRETS_RISK_LOCATIONS@v1",
  "type": "object",
  "required": [
    "schema",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "SECRETS_RISK_LOCATIONS@v1"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "risk_type",
          "severity",
          "affected_symbol",
          "secret_category",
          "exposure_vector",
          "mitigation_present",
          "path",
          "line_range",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "risk_type": {
            "type": "string",
            "enum": [
              "hardcoded_secret",
              "env_var_no_default",
              "secret_in_log",
              "secret_in_url",
              "unencrypted_storage",
              "weak_credential",
              "exposed_in_error"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "affected_symbol": {
            "type": "string"
          },
          "secret_category": {
            "type": "string",
            "enum": [
              "api_key",
              "oauth_token",
              "db_password",
              "jwt_secret",
              "encryption_key",
              "webhook_secret",
              "generic_credential"
            ]
          },
          "exposure_vector": {
            "type": "string"
          },
          "mitigation_present": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "line_range": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "line_range",
                "excerpt"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line_range": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
