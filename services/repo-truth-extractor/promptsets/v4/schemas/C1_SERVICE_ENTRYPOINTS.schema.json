{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "promptsets/v4/schemas/C1_SERVICE_ENTRYPOINTS.schema.json",
  "title": "SERVICE_ENTRYPOINTS@v1",
  "type": "object",
  "required": [
    "schema",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "SERVICE_ENTRYPOINTS@v1"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "service_id",
          "entrypoint_type",
          "invocation",
          "module_path",
          "path",
          "line_range",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "service_id": {
            "type": "string"
          },
          "entrypoint_type": {
            "type": "string",
            "enum": [
              "uvicorn",
              "gunicorn",
              "cli_click",
              "cli_typer",
              "cli_argparse",
              "script_direct",
              "docker_cmd",
              "docker_entrypoint",
              "console_script",
              "makefile_target",
              "compose_command"
            ]
          },
          "invocation": {
            "type": "string"
          },
          "module_path": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line_range": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "line_range",
                "excerpt"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line_range": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
