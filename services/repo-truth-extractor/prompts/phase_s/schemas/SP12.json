{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "hashes", "counts"],
  "properties": {
    "status": {"type": "string", "enum": ["OK", "FAIL_CLOSED"]},
    "normalization": {
      "type": "object",
      "properties": {
        "sorted_keys": {"type": "boolean"},
        "stable_lists": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section", "hash_alg", "hash"],
        "properties": {
          "section": {"type": "string"},
          "hash_alg": {"type": "string"},
          "hash": {"type": "string"}
        }
      }
    },
    "counts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "count"],
        "properties": {
          "name": {"type": "string"},
          "count": {"type": "integer"}
        }
      }
    }
  }
}
