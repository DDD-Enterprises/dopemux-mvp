# Dope-Memory Service - Docker Configuration
# Temporal chronicle and working-context manager for Dopemux
#
# Port: 3020 (per registry.yaml)
# Health: /health
#
FROM python:3.11-slim

# Labels
LABEL maintainer="dopemux"
LABEL service="dope-memory"
LABEL version="1.0.0"

# Environment
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PORT=3020
ENV DOPE_MEMORY_PORT=3020
ENV LOG_LEVEL=INFO
ENV ENVIRONMENT=production

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy dependency manifests first for better caching
COPY pyproject.toml .
COPY src/dopemux/__init__.py src/dopemux/__init__.py

# Install Python dependencies from centralized manifest
RUN pip install --no-cache-dir .[services]

# Copy application code (relative to root build context)
COPY services/working-memory-assistant/chronicle/ ./chronicle/
COPY services/working-memory-assistant/promotion/ ./promotion/
COPY services/working-memory-assistant/mcp/ ./mcp/
COPY services/working-memory-assistant/reflection/ ./reflection/
COPY services/working-memory-assistant/trajectory/ ./trajectory/
COPY services/working-memory-assistant/canonical_ledger.py .
COPY services/working-memory-assistant/dope_memory_main.py .
COPY services/working-memory-assistant/eventbus_consumer.py .
COPY services/working-memory-assistant/postgres_mirror_sync.py .


# Create non-root user
RUN useradd --create-home --shell /bin/bash dopememory \
    && mkdir -p /home/dopememory/.dope-memory \
    && chown -R dopememory:dopememory /app /home/dopememory/.dope-memory

USER dopememory

# Data volume for SQLite databases
VOLUME ["/home/dopememory/.dope-memory"]

# Health check per registry contract
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Expose port
EXPOSE ${PORT}

# Start the application
CMD ["python", "dope_memory_main.py"]
