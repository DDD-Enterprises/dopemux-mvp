{
  "schema_version": "1.0",
  "classifier_id": "EXEC012-TOOL-EVENT-CLASSIFIER-028",
  "applies_to": [
    "ROUTE_A",
    "ROUTE_D"
  ],
  "stream": "codex exec --json JSONL event stream on child stdout",
  "policy": "FAIL_CLOSED_ALLOWLIST",
  "policy_note": "Anything not explicitly allowlisted is an unapproved native tool event. A new or renamed item type therefore fails the route rather than passing unnoticed.",
  "vocabulary_source": "ThreadItem variant set extracted from the codex-darwin-arm64 0.153.4 binary plus the envelope set already parsed by the frozen Route A adapter.",
  "allowed_envelope_types": [
    "thread.started",
    "turn.started",
    "item.completed",
    "turn.completed"
  ],
  "allowed_item_types": [
    "agent_message",
    "reasoning"
  ],
  "error_envelope": {
    "type": "error",
    "disposition": "ALLOWED_ONLY_IF_SAME_ROUTE_RECOVERY",
    "note": "Retained from the frozen adapter. An error envelope is never evidence of tool use, but it is not a completion either."
  },
  "turn_failed": {
    "type": "turn.failed",
    "disposition": "ROUTE_FAILURE_NOT_TOOL_USE",
    "note": "Observed during runner-availability probing (usage_limit_exceeded). Fails the route without setting FAIL_UNAPPROVED_NATIVE_TOOL_USE."
  },
