    }
  ],
  "verdict_contract": {
    "on_any_forbidden_event": {
      "ROUTE_STATUS": "FAIL_UNAPPROVED_NATIVE_TOOL_USE",
      "RERUN": "NO",
      "note": "The route result remains benchmark evidence."
    },
    "on_zero_forbidden_events": {
      "UNAPPROVED_NATIVE_TOOL_EVENT_COUNT": 0,
      "RUNTIME_TOOL_POLICY": "PASS"
    }
  },
  "approved_retrieval": "Benchmark-owned Parallel Search broker only, outside the model's native tool plane. Broker traffic never appears in this stream."
