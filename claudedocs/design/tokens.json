{
  "_meta": {
    "version": "0.3.0-direction-b",
    "direction": "B — Electric Refresh",
    "description": "neon-electric palette with structurally-correct ANSI anchors. error→red-family (was pink), success→green-family (was cyan-colliding mint). All status tokens WCAG AA on base. Gremlin-pink demoted to non-semantic brand accent.",
    "surfaces": "dark-only",
    "verified": "2026-06-03",
    "aa_floor": 4.5,
    "ansi16_map": {
      "success": "green",
      "error":   "red",
      "warning": "yellow",
      "info":    "cyan",
      "aftercare": "blue"
    }
  },
  "color": {
    "base":          { "hex": "#020617", "role": "page background / ink-black" },
    "raised":        { "hex": "#041628", "role": "card / panel surface" },
    "overlay":       { "hex": "#081832", "role": "modal / elevated overlay" },
    "border":        { "hex": "#1E2A3A", "role": "subtle border" },
    "border_strong": { "hex": "#2E3F54", "role": "visible border / divider" },

    "brand":         { "hex": "#2FFFF0", "role": "primary brand teal — headers, links, focus rings", "ansi16": "cyan", "contrast_on_base": 16.03 },
    "brand_dim":     { "hex": "#00C9B8", "role": "dimmed brand — borders, table headers, bar complete" },

    "success":  { "hex": "#00FF85", "role": "DONE / PASS / healthy", "ansi16": "green",  "contrast_on_base": 15.03 },
    "error":    { "hex": "#FF2255", "role": "FAIL / BLOCKED / danger", "ansi16": "red",   "contrast_on_base": 5.39 },
    "warning":  { "hex": "#FFE600", "role": "WARN / degraded / caution", "ansi16": "yellow", "contrast_on_base": 15.92 },
    "info":     { "hex": "#00E5FF", "role": "INFO / running / neutral state", "ansi16": "cyan",  "contrast_on_base": 13.11 },
    "aftercare":{ "hex": "#C07BFF", "role": "AFTERCARE / deferred / soft state", "ansi16": "blue", "contrast_on_base": 7.22 },

    "gremlin_pink": { "hex": "#FF00CC", "role": "NON-SEMANTIC brand accent — wordmark glow, banners, personality only. Never a status indicator." },

    "text_primary":   { "hex": "#E2E8F0", "role": "primary readable text", "contrast_on_base": 16.36 },
    "text_secondary": { "hex": "#94A3B8", "role": "secondary / labels / metadata", "contrast_on_base": 7.87 },
    "text_muted":     { "hex": "#808DA0", "role": "muted / timestamps / hints", "contrast_on_base": 5.99 },
    "text_disabled":  { "hex": "#475569", "role": "disabled (WCAG-exempt)", "contrast_on_base": 2.66 },
    "text_inverse":   { "hex": "#020617", "role": "dark text on filled bright chips" }
  },
  "hue": {
    "display":  "Space Grotesk",
    "body":     "Inter",
    "mono":     "JetBrains Mono",
    "scale":    [12, 14, 16, 20, 24, 32, 48]
  },
  "spacing": {
    "xs":  4,
    "sm":  8,
    "md":  16,
    "lg":  24,
    "xl":  32,
    "unit": "px"
  },
  "radius": {
    "sm":   6,
    "md":   10,
    "pill": 999,
    "unit": "px"
  },
  "elevation": {
    "subtle":  "0 1px 3px rgba(0,0,0,0.4)",
    "overlay": "0 8px 24px rgba(0,0,0,0.55)"
  },
  "glyph": {
    "success":   "✓",
    "error":     "✗",
    "warning":   "⚠",
    "info":      "●",
    "running":   "◉",
    "aftercare": "◈",
    "blocked":   "⊘"
  }
}
