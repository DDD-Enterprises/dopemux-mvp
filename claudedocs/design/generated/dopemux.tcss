/* Auto-generated Textual CSS vars — Direction B Electric Refresh */
:root {
    --hue-display: Space Grotesk;
    --hue-body:    Inter;
    --hue-mono:    JetBrains Mono;
    --base:           #020617;
    --raised:         #041628;
    --overlay:        #081832;
    --border:         #1E2A3A;
    --border-strong:  #2E3F54;
    --brand:          #2FFFF0;
    --brand-dim:      #00C9B8;
    --success:        #00FF85;
    --error:          #FF2255;
    --warning:        #FFE600;
    --info:           #00E5FF;
    --aftercare:      #C07BFF;
    --accent:         #FF00CC;
    --text:           #E2E8F0;
    --text-dim:       #94A3B8;
    --text-muted:     #808DA0;
    --text-disabled:  #475569;
    --text-inverse:   #020617;
    --sp-xs:  4px;
    --sp-sm:  8px;
    --sp-md:  16px;
    --sp-lg:  24px;
    --sp-xl:  32px;
    --radius-sm:   6px;
    --radius-md:   10px;
    --radius-pill: 999px;
}