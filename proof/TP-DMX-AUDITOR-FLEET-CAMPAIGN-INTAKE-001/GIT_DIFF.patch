+      - "OBSERVED in config/pricing.yaml: gpt-5.5"
+      - "Codex CLI model selector format and available model names require VERIFY_WITH_VENDOR_DOCS"
+
+  opencode:
+    cheap_read: VERIFY_WITH_VENDOR_DOCS    # tier intent: cheap_fast
