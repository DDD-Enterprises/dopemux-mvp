index 000000000..510b705b1
--- /dev/null
+++ b/.taskorchestrator/config.yaml
@@ -0,0 +1,628 @@
+# .taskorchestrator/config.yaml
+#
+# Dopemux task-orchestrator schema configuration (Option A: soft gates,
+# broad coverage via traits composability).
+#
+# Authority: ADR docs/90-adr/adr-task-orchestrator-claude-surface-integration.md
+#            ADR docs/90-adr/adr-task-orchestrator-as-workflow-authority.md (accepted)
+#            AGENTS.md §5 (PAL chains), §6 (boundaries + contract-sensitive surfaces), §9 (proof and finality)
+#
+# Implementation plan: ~/.claude/plans/on-a-new-branch-sleepy-robin.md
+#
+# CONTRACT-SENSITIVE SURFACE per AGENTS.md §6 — schema/trait changes
+# require canonical-writer inspection and ADR linkage. Treat edits as
+# breaking-by-implication unless verified non-breaking via workflow guide §9.
+#
+# Matching rules (workflow guide §3):
+#   1. Type-first: item.type matched directly against work_item_schemas keys.
+#   2. Tag-fallback: if no type match, item tags checked (substring match).
+#   3. Default: if no type/tag match, the `default` schema applies (defined below).
+#
+# Gate enforcement applies on advance_item triggers:
+#   - start (queue→work): required queue-phase notes must be filled
+#   - start (work→review or terminal): required work-phase notes must be filled
+#   - complete (any non-terminal → terminal): all required notes across all phases must be filled
+#   - cancel/reopen: bypasses gates
+#
+# Posture: soft gates. Most notes carry rich `description` + `guidance` +
+# `skill` but `required: false`. Only `proof-bundle` in review is `required: true`.
+# This gates `complete` (proof-bundle must be filled) without blocking
+# start/work transitions. Reversible upward: flip per-trait `required: false`
+# → `required: true` as discipline matures.
+
+# ─── Schema metadata (Dopemux extension for genealogy) ─────────────────
+schemas_metadata:
+  version: "1.0.0"
+  updated_at: "2026-05-27"
+  posture: "Option-A-soft-gates-broad-coverage"
+  retro_id: null  # Set when a retro produces a schema change (TP-CS-126).
+  superseded_keys: []
+  notes: |
+    First-ship schema config for DMX-ORCH-CLAUDE-SURFACE Phase 2.
+    Six schemas + default fallback compose from five traits.
+    Required-notes posture: queue/work mostly advisory; proof-bundle is the
+    sole hard gate (review phase). Reversible per-trait by editing
+    `required: false` → `required: true`.
+
+# ─── Composable traits (workflow guide §3) ─────────────────────────────
+# Traits are reusable note bundles. Schemas compose by listing trait keys
+# under `traits:`. PAL chain definitions live in ONE place
+# (pal-chain-codex + pal-chain-risky) and apply across multiple schemas.
+# Per H7 fix: this is the DRY mechanism that avoids per-schema duplication.
+
+traits:
+  # Codex minimum chain per AGENTS.md §5: analyze → planner → codereview → precommit
+  pal-chain-codex:
+    - key: analyze
+      role: queue
+      required: false
+      description: "Output of pal/analyze — runtime flow, invariants, canonical writers identified."
+      guidance: |
+        Run mcp__pal__analyze (or read its output). State concretely:
+        - Runtime path inspected
+        - Invariants the change must preserve
+        - Canonical writer for each touched surface
+        - Hidden coupling identified
+        - What is still UNKNOWN
+      skill: pal:analyze
+
+    - key: planner
+      role: queue
+      required: false
+      description: "Output of pal/planner — phased plan, blast radius, contract surfaces, validation strategy, rollback path."
+      guidance: |
+        Run mcp__pal__planner. Capture:
+        - Phases (commit-sized slices)
+        - Blast radius per phase
+        - Contract surfaces touched (schemas, manifests, event payloads, MCP tools)
+        - Validation strategy per phase (which tests, which checks)
+        - Rollback path (specific command(s))
+      skill: pal:planner
+
+    - key: codereview
+      role: review
+      required: false
+      description: "Output of pal/codereview — issues with severity, recommendations."
+      guidance: |
+        Run mcp__pal__codereview on the slice's diff. Capture:
+        - Issues with severity (critical/high/medium/low)
+        - Recommended fixes per issue
+        - Files reviewed (absolute paths)
+        - Anything ruled out and why
+      skill: pal:codereview
+
+    - key: precommit
+      role: review
+      required: false
+      description: "Output of pal/precommit — diff scope, schema drift, generated junk, rollback feasibility."
+      guidance: |
+        Run mcp__pal__precommit. Capture:
+        - Diff scope confirmation
+        - Schema drift detection (any contract-sensitive files changed?)
+        - Generated artifacts present (should be ignored or committed?)
+        - Rollback feasibility check
+        - Any pre-commit hook output
+      skill: pal:precommit
+
+  # Risky / architecture-sensitive chain per AGENTS.md §5
+  # Activated via tag `risky` or `architecture-sensitive` (apply default_traits manually).
+  # Composes ON TOP of pal-chain-codex.
+  pal-chain-risky:
+    - key: thinkdeep
+      role: queue
+      required: false
+      description: "Output of pal/thinkdeep — second-order effects, replay safety, rollback semantics."
+      guidance: |
+        Run mcp__pal__thinkdeep for risky / architecture-sensitive work.
+        Capture: second-order effects, replay safety, rollback semantics,
+        operational drift, failure visibility, security implications.
+      skill: pal:thinkdeep
+
+    - key: challenge-pre-plan
+      role: queue
+      required: false
+      description: "Output of pal/challenge — adversarial pass on the analysis before planner."
+      guidance: |
+        Run mcp__pal__challenge against the analyze + thinkdeep output.
+        Capture: attack-surface assumptions, race conditions, replay hazards,
+        security gaps, nondeterminism.
+      skill: pal:challenge
+
+    - key: challenge-post-plan
+      role: queue
+      required: false
+      description: "Output of pal/challenge — adversarial review of the chosen plan."
+      guidance: |
+        Run mcp__pal__challenge against the planner output. Capture:
+        planning assumptions attacked, hidden consumers, schema hazards,
+        nondeterminism risks, premature optimization, scope creep risks.
+      skill: pal:challenge
+
+    - key: challenge-post-implement
+      role: work
+      required: false
+      description: "Output of pal/challenge — adversarial pass on the implementation slice before codereview (M13 fix)."
+      guidance: |
+        Run mcp__pal__challenge against the implementation diff (not just
+        the plan). Capture: regression risk, partial-failure modes,
+        race conditions in actual code, deployment hazards.
+      skill: pal:challenge
+
+    - key: challenge-post-review
+      role: review
+      required: false
+      description: "Output of pal/challenge — final adversarial pass after precommit, before complete."
+      guidance: |
+        Run mcp__pal__challenge against the precommit + codereview output.
+        Capture: residual risks, untested paths, deployment hazards,
+        post-merge surprises.
+      skill: pal:challenge
+
+  # The complete-gate. Required for items that produce real changes.
+  proof-bundle:
+    - key: proof-bundle
+      role: review
+      required: true
+      description: "Full AGENTS.md §9 proof bundle. THE COMPLETE-GATE."
+      guidance: |
+        REQUIRED for any item that ships repo changes. Populate ALL fields:
+        - TP path/ID
+        - worktree path
+        - branch
+        - repo identity result (DDD-Enterprises/dopemux-mvp)
+        - slices completed
+        - files changed (with line counts)
+        - validations with exit codes — bucket as PASS / FAIL / NOT_RUN
+        - codereview status
+        - precommit status
+        - commit SHA(s)
+        - PR URL or exact blocker
+        - residual risks
+        - UNKNOWNs
+        - cleanup status (worktree removed? temp files deleted?)
+
+        Per AGENTS.md §9 (Proof and Finality): no proof means incomplete.
+        This is the mechanical complete-gate.
+      skill: verify
+
+  # Work-phase audit trail (used by all schemas that produce code).
+  implementation-evidence:
+    - key: implementation-evidence
+      role: work
+      required: false
+      description: "Files changed, slices completed, validation exit codes — running notes."
+      guidance: |
+        Capture concretely as you work:
+        - Files touched (relative paths)
+        - Commit SHA of each slice
+        - Exit codes of any validation runs
+        - What changed approach mid-flight and why
+        This is the work-phase audit trail; proof-bundle aggregates this at review.
+
+  # Retrospective action proposals (used only by retrospective schema).
+  retrospective-actions:
+    - key: schema-updates-proposed
+      role: review
+      required: false
+      description: "Schema/trait changes proposed by this retro."
+      guidance: "List schemas/traits to add/change/remove. Each item becomes a child TP via the action-feedback convention (Plan §9.12 TP-CS-125)."
+
+    - key: commands-updates-proposed
+      role: review
+      required: false
+      description: "Slash command changes proposed."
+      guidance: "List /dx: commands to add/change/remove. One child TP per change."
+
+    - key: agent-updates-proposed
+      role: review
+      required: false
+      description: "Agent doc changes proposed."
+      guidance: |
+        Files in scope: .claude/agents/*, AGENTS.md, .github/copilot-instructions.md,
+        config/instructions/agents.instructions.md, .claude/personas/*.agent.md.
+        Per cross-agent applicability §6.1 in the plan.
+
+    - key: hook-updates-proposed
+      role: review
+      required: false
+      description: "Hook changes proposed."
+      guidance: ".claude/hooks/* and .claude/settings.json (via update-config skill, not direct edit)."
+
+    - key: instructions-updates-proposed
+      role: review
+      required: false
+      description: "Cross-agent instruction surface changes that touch multiple files."
+
+# ─── Work item schemas (workflow guide §3) ─────────────────────────────
+# Each schema enumerates its expected notes EXPLICITLY in `notes:`. The
+# top-level `traits:` registry above is informational only — v3.8.0 does
+# not auto-compose trait notes into schemas, so we inline them per schema.
+# Comment lines below each schema name list the equivalent trait
+# composition for traceability.
+#
+# Schema selection:
+#   1. Type-first: item.type matched directly against work_item_schemas keys.
+#      Set type="task-packet" on items for reliable selection.
+#   2. Tag-fallback: per upstream manage-schemas docs, tag-fallback only
+#      hits `note_schemas:` (legacy format). For work_item_schemas matching
+#      via tag-fallback, set the item's `type` field explicitly.
+#   3. Default: items with no type/tag match fall through to the `default`
+#      schema below.
+
+work_item_schemas:
+  # ── task-packet ──────────────────────────────────────────────────────
+  # Atomic repo-changing work unit (AGENTS.md §4 Task Packet).
+  # Trait equivalent: pal-chain-codex + proof-bundle + implementation-evidence
+  task-packet:
+    lifecycle: AUTO  # Parent auto-cascades to terminal when all children terminal
+    notes:
+      # === pal-chain-codex (AGENTS.md §5 Codex minimum) ===
+      - key: analyze
+        role: queue
+        required: false
+        description: "Output of pal/analyze — runtime flow, invariants, canonical writers identified."
+        guidance: |
+          Run mcp__pal__analyze (or read its output). State concretely:
+          - Runtime path inspected
+          - Invariants the change must preserve
+          - Canonical writer for each touched surface
+          - Hidden coupling identified
+          - What is still UNKNOWN
+        skill: pal:analyze
+
+      - key: planner
+        role: queue
+        required: false
+        description: "Output of pal/planner — phased plan, blast radius, contract surfaces, validation strategy, rollback path."
+        guidance: |
+          Run mcp__pal__planner. Capture:
+          - Phases (commit-sized slices)
+          - Blast radius per phase
+          - Contract surfaces touched (schemas, manifests, event payloads, MCP tools)
+          - Validation strategy per phase (which tests, which checks)
+          - Rollback path (specific command(s))
+        skill: pal:planner
+
+      - key: codereview
+        role: review
+        required: false
+        description: "Output of pal/codereview — issues with severity, recommendations."
+        guidance: |
+          Run mcp__pal__codereview on the slice's diff. Capture:
+          - Issues with severity (critical/high/medium/low)
+          - Recommended fixes per issue
+          - Files reviewed (absolute paths)
+        skill: pal:codereview
+
+      - key: precommit
+        role: review
+        required: false
+        description: "Output of pal/precommit — diff scope, schema drift, generated junk, rollback feasibility."
+        guidance: |
+          Run mcp__pal__precommit. Capture:
+          - Diff scope confirmation
+          - Schema drift detection
+          - Generated artifacts present
+          - Rollback feasibility check
+        skill: pal:precommit
+
+      # === implementation-evidence ===
+      - key: implementation-evidence
+        role: work
+        required: false
+        description: "Files changed, slices completed, validation exit codes — running notes."
+        guidance: "Capture concretely: files touched, commit SHAs per slice, exit codes of validation runs."
+
+      # === proof-bundle (THE COMPLETE-GATE) ===
+      - key: proof-bundle
+        role: review
+        required: true
+        description: "Full AGENTS.md §9 proof bundle. THE COMPLETE-GATE."
+        guidance: |
+          REQUIRED. Populate ALL fields:
+          - TP path/ID
+          - worktree path, branch, repo identity
+          - slices completed, files changed (with line counts)
+          - validations with exit codes — PASS / FAIL / NOT_RUN buckets
+          - codereview status, precommit status
+          - commit SHA(s), PR URL or exact blocker
+          - residual risks, UNKNOWNs, cleanup status
+          Per AGENTS.md §9: no proof means incomplete.
+        skill: verify
+
+  # ── feature-implementation ──────────────────────────────────────────
+  # Multi-TP feature container.
+  # Trait equivalent: pal-chain-codex + proof-bundle + implementation-evidence
+  feature-implementation:
+    lifecycle: MANUAL  # Don't auto-cascade — feature ship is an explicit decision
+    notes:
+      - key: feature-brief
+        role: queue
+        required: false
+        description: "Problem statement + acceptance criteria + scope boundaries."
+        guidance: |
+          Describe:
+          - What problem this feature solves
+          - 3-5 testable acceptance criteria
+          - Explicit out-of-scope items (what we are NOT doing)
+
+      - key: phased-plan
+        role: queue
+        required: false
+        description: "Phase breakdown into child TPs."
+        guidance: "List child TPs, their order, and which can ship in parallel."
+
+      # PAL chain notes (same as task-packet)
+      - key: analyze
+        role: queue
+        required: false
+        description: "Output of pal/analyze — runtime flow, invariants, canonical writers."
+        skill: pal:analyze
+      - key: planner
+        role: queue
+        required: false
+        description: "Output of pal/planner — phased plan, blast radius, validation, rollback."
+        skill: pal:planner
+      - key: implementation-evidence
+        role: work
+        required: false
+        description: "Files changed, slices completed, validation exit codes — running notes."
+      - key: codereview
+        role: review
+        required: false
+        description: "Output of pal/codereview — issues with severity, recommendations."
+        skill: pal:codereview
+      - key: precommit
+        role: review
+        required: false
+        description: "Output of pal/precommit."
+        skill: pal:precommit
+      - key: proof-bundle
+        role: review
+        required: true
+        description: "Full AGENTS.md §9 proof bundle. THE COMPLETE-GATE."
+        skill: verify
+
+  # ── bug-fix ─────────────────────────────────────────────────────────
+  # Bug fix variant: emphasizes repro + root cause + regression test.
+  # Trait equivalent: pal-chain-codex + proof-bundle + implementation-evidence
+  bug-fix:
+    lifecycle: AUTO
+    notes:
+      - key: repro
+        role: queue
+        required: false
+        description: "How to reproduce — failing test or manual steps."
+        guidance: |
+          Minimal repro. Include:
+          - Stack trace if applicable
+          - Commit SHA where bug was observed
+          - Environment / config that triggers it
+
+      - key: root-cause
+        role: work
+        required: false
+        description: "The ACTUAL cause, not just the fix."
+        guidance: "Output of mcp__pal__debug. Underlying cause, not the symptom that disappeared. Include why the bug went undetected."
+        skill: pal:debug
+
+      - key: regression-test
+        role: work
+        required: false
+        description: "New test that would have caught this bug. File path + assertion."
+
+      # PAL chain notes
+      - key: analyze
+        role: queue
+        required: false
+        description: "Output of pal/analyze."
+        skill: pal:analyze
+      - key: planner
+        role: queue
+        required: false
+        description: "Output of pal/planner."
+        skill: pal:planner
+      - key: implementation-evidence
+        role: work
+        required: false
+        description: "Files changed, slices completed, validation exit codes."
+      - key: codereview
+        role: review
+        required: false
+        description: "Output of pal/codereview."
+        skill: pal:codereview
+      - key: precommit
+        role: review
+        required: false
+        description: "Output of pal/precommit."
+        skill: pal:precommit
+      - key: proof-bundle
+        role: review
+        required: true
+        description: "Full AGENTS.md §9 proof bundle. THE COMPLETE-GATE."
+        skill: verify
+
+  # ── rfc-proposal ────────────────────────────────────────────────────
+  # RFC proposal (consensus-building doc).
+  # Trait equivalent: implementation-evidence (doc file change tracking)
+  rfc-proposal:
+    lifecycle: MANUAL  # RFC consensus + decision is explicit
+    notes:
+      - key: problem-statement
+        role: queue
+        required: true
+        description: "What needs to be decided and why."
+        guidance: "Define the problem precisely. Include constraints, deadlines, and stakeholders."
+
+      - key: alternatives
+        role: queue
+        required: true
+        description: "Alternatives considered with pros/cons."
+        guidance: "Minimum 2 alternatives. For each: summary, pros, cons, why-rejected."
+
+      - key: consensus
+        role: work
+        required: false
+        description: "Output of pal/consensus or documented human consensus process."
+        skill: pal:consensus
+
+      - key: implementation-evidence
+        role: work
+        required: false
+        description: "Doc file created/edited — path + commit SHA."
+
+      - key: chosen-approach
+        role: review
+        required: true
+        description: "The decision + rationale + binding invariants."
+
+      - key: adr-document
+        role: review
+        required: true
+        description: "Path to the resulting ADR file in docs/90-adr/ (and ConPort decision ID if logged)."
+
+  # ── audit-pack ──────────────────────────────────────────────────────
+  # Audit pack (RTE-style phased audit work).
+  # Trait equivalent: implementation-evidence
+  audit-pack:
+    lifecycle: AUTO_REOPEN  # Audit phases can re-issue against new HEAD
+    notes:
+      - key: audit-prompt
+        role: queue
+        required: true
+        description: "The audit prompt and scope (HEAD SHA, files, phase number)."
+
+      - key: findings-register
+        role: work
+        required: true
+        description: "Findings with severity buckets (CRIT/HIGH/MED/LOW/OBS)."
+        guidance: |
+          Each finding: ID (e.g. F1-CRIT-1), severity, summary, evidence (file:line),
+          recommended action. Group by severity. Mark RESOLVED on rerun.
+
+      - key: implementation-evidence
+        role: work
+        required: false
+        description: "Audit artifacts produced — claudedocs/ paths, evidence files."
+
+      - key: verdict
+        role: review
+        required: true
+        description: "Final verdict (READY / NOT_READY / RUNNABLE-BOUNDED / etc.)"
+        guidance: "Include CRIT counts, what blocks shipping, recommended next phase."
+
+  # ── sprint-goal ─────────────────────────────────────────────────────
+  # Sprint goal (top-level container; never auto-terminates).
+  sprint-goal:
+    lifecycle: PERMANENT  # Sprint goals don't auto-cascade or auto-terminate
+    notes:
+      - key: goal-definition
+        role: queue
+        required: true
+        description: "What the sprint achieves and why."
+        guidance: "Sprint ID (S-YYYY.MM). Goal in one sentence. Linked stories/features. Definition of done."
+
+      - key: progress-summary
+        role: work
+        required: false
+        description: "Running progress notes for the sprint (weekly updates)."
+
+  # ── retrospective ───────────────────────────────────────────────────
+  # Retrospective work item (Phase 6 / TP-CS-120).
+  # Trait equivalent: retrospective-actions
+  retrospective:
+    lifecycle: AUTO
+    notes:
+      - key: scope
+        role: queue
+        required: true
+        description: "What window, items, theme is this retro covering?"
+        guidance: "Time window (e.g. 30 days), items in scope, thematic focus if any."
+
+      - key: triggering-event
+        role: queue
+        required: false
+        description: "What fired this retro — schedule, anti-pattern signal, manual operator request."
+
+      - key: metrics-snapshot
+        role: queue
+        required: false
+        description: "Output of scripts/orchestrator/collect_metrics.py at retro creation time."
+
+      - key: observations
+        role: work
+        required: true
+        description: "What was observed during the window."
+        guidance: "Group as: what worked, what didn't, anomalies, surprises. Reference specific TP IDs / commit SHAs / dates."
+
+      - key: findings
+        role: work
+        required: true
+        description: "Patterns extracted from observations."
+        guidance: "Each finding: pattern statement, evidence, severity / leverage."
+
+      # === retrospective-actions trait inlined ===
+      - key: schema-updates-proposed
+        role: review
+        required: false
+        description: "Schema/trait changes proposed by this retro."
+        guidance: "Each item becomes a child TP via the action-feedback convention (Plan §9.12 TP-CS-125)."
+
+      - key: commands-updates-proposed
+        role: review
+        required: false
+        description: "Slash command changes proposed."
+
+      - key: agent-updates-proposed
+        role: review
+        required: false
+        description: "Agent doc changes proposed."
+        guidance: "Files in scope: .claude/agents/*, AGENTS.md, .github/copilot-instructions.md, config/instructions/agents.instructions.md, .claude/personas/*.agent.md."
+
+      - key: hook-updates-proposed
+        role: review
+        required: false
+        description: "Hook changes proposed (.claude/hooks/* and .claude/settings.json)."
+
+      - key: instructions-updates-proposed
+        role: review
+        required: false
+        description: "Cross-agent instruction surface changes that touch multiple files."
+
+      - key: next-retro-conditions
+        role: review
+        required: false
+        description: "When should the NEXT retro fire?"
+        guidance: "Schedule, metric threshold, or anti-pattern signal."
+
+  # ── default ─────────────────────────────────────────────────────────
+  # Fallback for items not matching any type or tag (M10 fix).
+  # Trait equivalent: proof-bundle (items that ship changes still need proof)
+  default:
+    lifecycle: AUTO
+    notes:
+      - key: proof-bundle
+        role: review
+        required: true
+        description: "Full AGENTS.md §9 proof bundle for any change-producing work."
+        skill: verify
+
+# ─── Status labels (workflow guide §6) ─────────────────────────────────
+# Maps role transitions to human-readable status strings.
+#
+# Precedence rules (M12 fix per planner findings):
+#   1. Resolution label WINS for `cancel` (always "cancelled") and `reopen`
+#      (always null/cleared). Config CANNOT override these.
+#   2. For other triggers, config-driven status_labels override defaults.
+#   3. `resume` preserves the pre-block label automatically — do NOT
+#      configure resume here; the orchestrator handles it.
+#
+# Triggers not listed get no label override (null).
+status_labels:
+  # Keep defaults; can customize later per operator preference.
+  # Example custom: complete: "shipped" (Dopemux-friendly).
+  start: "in-progress"
+  complete: "done"
+  block: "blocked"
+  # cancel and reopen are handled by resolution-label rules (do not override).
+  cascade: "done"  # When parent auto-cascades to terminal because all children terminal.
