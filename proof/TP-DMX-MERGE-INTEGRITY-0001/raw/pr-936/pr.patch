+    monkeypatch.setattr(
+        gate, "ledger_columns", lambda *_args: {"name", "rank", "checksum", "status"}
+    )
+
+    code = gate.main(
+        [
+            "verify",
+            "--database-url",
+            "postgresql://user:pass@localhost/db",
+            "--migrations-dir",
+            str(tmp_path),
