+    catalog = _launcher_catalog()
+    old = {
+        "conport": {
+            "type": "sse",
+            "url": "http://localhost:${CONPORT_MCP_PORT:-3005}/sse",
+        },
+    }
+
+    merged, planned, _preserved = plan_mcp_json_repairs(
+        old, catalog, mcp_json_path=".mcp.json", include_defaults=False
