+    foreign = (tmp_path / "foreign").resolve()
+    _git_init(main)
+    _git_init(foreign)
+    linked = (tmp_path / "linked").resolve()
+    subprocess.run(
+        ["git", "worktree", "add", str(linked)],
+        cwd=main,
+        check=True,
+        capture_output=True,
+    )
+    return SimpleNamespace(main=main, foreign=foreign, linked=linked)
+
