+        ("DO $$ BEGIN PERFORM f(); END $$;", True),
+        (  # read-only checks pass, even with a write verb inside a message
+            "DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM users) THEN"
+            " RAISE WARNING 'may need to update or create rows'; END IF; END $$;",
+            False,
+        ),
