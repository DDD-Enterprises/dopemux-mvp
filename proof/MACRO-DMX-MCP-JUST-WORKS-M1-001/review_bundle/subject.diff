+    leases = PortLeaseRegistry.load(runtime / "port-leases.json", create_missing=True)
+    leases.upsert_lease(_lease(wt, "conport", 3100))
+    leases.upsert_lease(
+        _lease(wt, "task-orchestrator", 7890)
