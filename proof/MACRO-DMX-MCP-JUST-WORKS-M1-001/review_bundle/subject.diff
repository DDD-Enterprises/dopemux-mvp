+@pytest.mark.parametrize(
+    "sql, flagged",
+    [
+        (
+            "DO $$ BEGIN CREATE TRIGGER t BEFORE UPDATE ON x"
+            " FOR EACH ROW EXECUTE FUNCTION f(); END $$;",
+            True,
+        ),
+        (
+            "DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM users) THEN"
+            " INSERT INTO users (id) VALUES ('x'); END IF; END $$;",
+            True,
