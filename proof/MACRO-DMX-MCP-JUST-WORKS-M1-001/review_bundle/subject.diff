+@pytest.mark.parametrize("ps_rc", [1, 124])
+def test_a_container_candidate_whose_pair_check_fails_is_stale(
+    tmp_path: Path, runtime: Path, ps_rc: int
+):
+    """(c) unavailable docker, or `run_cmd`'s timeout exit code: fail closed."""
