+                returncode=0, stdout="DPMX_TABLES=decisions\n", stderr=""
+            )
+        if "DPMX_COUNT=" in sql:
+            return SimpleNamespace(returncode=0, stdout="DPMX_COUNT=3\n", stderr="")
+        return SimpleNamespace(returncode=0, stdout="", stderr="")
