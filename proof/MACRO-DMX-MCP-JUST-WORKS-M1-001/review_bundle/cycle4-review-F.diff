+def test_a_worktree_hash_without_a_scope_label_is_another_worktree(
+    tmp_path, paths, monkeypatch
+):
+    repo = _repo(tmp_path)
+    first = _start(tmp_path, repo, paths)
+    conport = next(s for s in first.services if s["service"] == "conport")
