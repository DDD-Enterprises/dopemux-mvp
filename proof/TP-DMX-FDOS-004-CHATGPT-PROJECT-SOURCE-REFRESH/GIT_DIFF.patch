.py","additions":111,"deletions":0,"changeType":"ADDED"},{"path":"tests/unit/test_mcp_profile_policy.py","additions":279,"deletions":0,"changeType":"ADDED"},{"path":"tests/unit/test_mcp_profile_rendering.py","additions":71,"deletions":0,"changeType":"ADDED"}],"headRefName":"feat/TP-DMX-MCPPROF-001-profiled-tool-plane","headRefOid":"e41d134b5b0f32b5475ab5f094274bfac2259601","isDraft":false,"mergeStateStatus":"DIRTY","number":1128,"state":"OPEN","title":"feat(mcp): profile-selected tool plane and repo-domain read contract","updatedAt":"2026-07-27T00:49:18Z","url":"https://github.com/DDD-Enterprises/dopemux-mvp/pull/1128"}
