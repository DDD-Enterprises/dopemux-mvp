+++def sanitize_text(text: str, home_dir: Optional[str] = None) -> str:
+++    if not text:
+++        return ""
+++    if home_dir and home_dir in text:
+++        text = text.replace(home_dir, "/HOME_DIR")
+++    for pattern, replacement in REDACTION_PATTERNS:
