+import type { On, RenderElement } from 'claude-code'
+import { expect, mock, test } from 'claude-code/testing'
+import type { Engine, MockClock } from 'claude-code/testing'
+
+const MIN = 60_000
+const URL = 'http://127.0.0.1:3025/api/v1/state'
+
+const BAND = {
+  plugin: 'dopemux-pulse',
+  component: 'AbovePrompt',
+  props: {
+    hasSurvey: false,
+    isWorking: false,
+    maxRows: 10,
+    bodyColumns: 80,
+    scroll: { offset: 0, bodyRows: 10 },
+    view: {},
+  },
+} as const
+
+type Behaviour =
+  | { kind: 'ok'; body: unknown }
+  | { kind: 'raw'; text: string }
+  | { kind: 'status'; code: number }
+  | { kind: 'down' }
+  | { kind: 'slow' }
+
+// Everything beneath the plugin is mocked here: the clock, the engine's HTTP
+// answer, and the display calls the plugin makes (recorded, never drawn).
+function harness($: Engine, on: On, first: Behaviour) {
+  const clock: MockClock = mock.clock(on)
+  const world = {
+    clock,
+    behaviour: first,
+    statuses: [] as (string | undefined)[],
+    toasts: [] as string[],
+    urls: [] as string[],
+    registered: [] as string[],
+    get status() {
+      return world.statuses[world.statuses.length - 1]
+    },
+  }
+
+  // Beneath the plugin the engine draws its own band; a hook that passes
+  // (`next(e)`) therefore shows this text.
+  on('ui.render', ($, e) => {
+    const { Text } = $.ui.resolve(e)
+    return h$(Text, 'engine band')
+  })
+  on('session.start', (_, e) => ({ cwd: e.cwd }))
+  on('session.end', (_, e) => ({ sessionId: e.sessionId }))
+  on('command.register', (_, e) => {
+    world.registered.push(e.name)
+    return { value: { command: e.name } }
+  })
+  on('ui.status', (_, e) => {
+    world.statuses.push(e.text)
+    return { value: undefined }
+  })
+  on('ui.toast', (_, e) => {
+    world.toasts.push(e.text)
+    return { value: undefined }
+  })
+  on('http.fetch', async (_, e) => {
+    world.urls.push(e.url)
+    const b = world.behaviour
+    if (b.kind === 'down') return { deny: 'connection refused' }
+    if (b.kind === 'slow') await clock.sleep(10 * MIN)
+    const status = b.kind === 'status' ? b.code : 200
+    const text =
+      b.kind === 'ok' ? JSON.stringify(b.body) : b.kind === 'raw' ? b.text : ''
+    return {
+      value: { status, ok: status >= 200 && status < 300, headers: {}, text },
+    }
+  })
+
+  return {
+    world,
+    set: (b: Behaviour) => {
+      world.behaviour = b
+    },
+    async start() {
+      await $.session.start({ cwd: '/', surface: 'terminal', isInteractive: true })
+      await clock.settle()
+    },
+    async end(reason: 'clear' | 'resume' | 'logout' | 'prompt_input_exit' | 'other' = 'other') {
+      await $.session.end({
+        reason,
+        sessionId: 's1',
+        resume: { sessionId: 's1' } as never,
+      })
+      await clock.settle()
+    },
+    async run(command: string, args = '') {
+      return $.command.run({
+        command,
+        args,
+        origin: { kind: 'composer' },
+        presentation: { isFullscreen: false, columns: 80 },
+      })
+    },
+  }
+}
+
+const HEALTHY = { kind: 'ok', body: { energy: 'medium', attention: 'focused' } } as const
+
+test('status line shows energy, attention and mod-counted session minutes', async ($, on) => {
+  const h = harness($, on, HEALTHY)
+  await h.start()
+
+  expect(h.world.urls[0]).toBe(URL)
+  expect(h.world.status).toBe('🎯 idle · ⚡ medium · 🧠 focused · ⏱ 0m')
+
+  await h.world.clock.advance(61 * MIN)
+  expect(h.world.status).toBe('🎯 idle · ⚡ medium · 🧠 focused · ⏱ 61m')
+})
+
+test('status line falls back to the alias keys', async ($, on) => {
+  const h = harness($, on, {
+    kind: 'ok',
+    body: { energy_level: 'low', attention_state: 'scattered', session_minutes: 0 },
+  })
+  await h.start()
+  expect(h.world.status).toBe('🎯 idle · ⚡ low · 🧠 scattered · ⏱ 0m')
+})
+
+test('the current keys win over the aliases', async ($, on) => {
+  const h = harness($, on, {
+    kind: 'ok',
+    body: { energy: 'high', attention: 'focused', energy_level: 'low', attention_state: 'scattered' },
+  })
+  await h.start()
+  expect(h.world.status).toBe('🎯 idle · ⚡ high · 🧠 focused · ⏱ 0m')
+})
+
+test('status line says so when the engine is down, errors or answers garbage', async ($, on) => {
+  const h = harness($, on, { kind: 'down' })
+  await h.start()
+  expect(h.world.status).toBe('🎯 idle · 🔌 ADHD engine unreachable · ⏱ 0m')
+
+  h.set({ kind: 'status', code: 503 })
+  await h.world.clock.advance(MIN)
+  expect(h.world.status).toBe('🎯 idle · 🔌 ADHD engine unreachable (HTTP 503) · ⏱ 1m')
+
+  h.set({ kind: 'raw', text: '<html>not json</html>' })
+  await h.world.clock.advance(MIN)
+  expect(h.world.status).toBe('🎯 idle · ⚠ ADHD engine state malformed · ⏱ 2m')
+
+  h.set({ kind: 'ok', body: { energy: 7, attention: null } })
+  await h.world.clock.advance(MIN)
+  expect(h.world.status).toBe('🎯 idle · ⚠ ADHD engine state malformed · ⏱ 3m')
+
+  h.set({ kind: 'ok', body: { energy: 'low' } })
+  await h.world.clock.advance(MIN)
+  expect(h.world.status).toBe('🎯 idle · ⚡ low · 🧠 ? · ⏱ 4m')
+})
+
+test('a hung engine times out instead of wedging the poll', async ($, on) => {
+  const h = harness($, on, { kind: 'slow' })
+  await h.start()
+  await h.world.clock.advance(2_100)
+  expect(h.world.status).toBe('🎯 idle · 🔌 ADHD engine unreachable · ⏱ 0m')
+})
+
+test('toasts once on up to down and once on recovery, not every poll', async ($, on) => {
+  const h = harness($, on, HEALTHY)
+  await h.start()
+  expect(h.world.toasts).toEqual([])
+
+  h.set({ kind: 'down' })
+  await h.world.clock.advance(MIN)
+  await h.world.clock.advance(MIN)
+  await h.world.clock.advance(MIN)
+  expect(h.world.toasts).toEqual(['ADHD engine unreachable'])
+
+  h.set(HEALTHY)
+  await h.world.clock.advance(MIN)
+  await h.world.clock.advance(MIN)
+  expect(h.world.toasts).toEqual(['ADHD engine unreachable', 'ADHD engine is back'])
+})
+
+test('an engine that was never up is one status line, not a toast', async ($, on) => {
+  const h = harness($, on, { kind: 'down' })
+  await h.start()
+  await h.world.clock.advance(3 * MIN)
+  expect(h.world.toasts).toEqual([])
+})
+
+// `/focus` is a name Claude Code ships; `$.command.register` refuses it, so the
+// mod serves the focus clock as `/pulse-focus`.
+test('registers /pulse-focus, /break and /done and never a built-in name', async ($, on) => {
+  const h = harness($, on, HEALTHY)
+  await h.start()
+  expect(h.world.registered).toEqual(['pulse-focus', 'break', 'done'])
+})
+
+test('/pulse-focus defaults to 25 minutes and the band counts it down', async ($, on) => {
+  const h = harness($, on, HEALTHY)
+  await h.start()
+
+  const answer = await h.run('pulse-focus')
+  expect(answer.text).toMatch(/25/)
+
+  await h.world.clock.advance(10 * MIN)
+  const ui = await $.ui.mount({ ...BAND, surface: 'terminal' })
+  expect((await ui.find({ type: 'Text', text: /15 min left/ }))?.text).toMatch(/of 25/)
+  await ui.unmount()
+
+  await h.world.clock.advance(MIN)
+  expect(h.world.status).toBe('🎯 11/25 · ⚡ medium · 🧠 focused · ⏱ 11m')
+})
+
+test('/pulse-focus takes 5-120 minutes and refuses the rest', async ($, on) => {
+  const h = harness($, on, HEALTHY)
+  await h.start()
+
+  for (const bad of ['4', '0', '-5', '121', '1000', 'abc', '12.5', '25 30']) {
+    const answer = await h.run('pulse-focus', bad)
+    expect(answer.text, `args "${bad}"`).toMatch(/5-120/)
+  }
+  // Nothing started: the band is idle.
+  await h.world.clock.advance(MIN)
+  expect(h.world.status).toMatch(/^🎯 idle/)
+
+  for (const [good, left] of [['5', 5], ['120', 120], [' 45 ', 45]] as const) {
+    await h.run('pulse-focus', good)
+    const ui = await $.ui.mount({ ...BAND, surface: 'terminal' })
+    expect(await ui.find({ type: 'Text', text: new RegExp(`${left} min left`) })).toBeDefined()
+    await ui.unmount()
+  }
+})
+
+test('a toast at the limit, then a gentler nudge at 90 continuous minutes', async ($, on) => {
+  const h = harness($, on, HEALTHY)
+  await h.start()
+
+  await h.run('pulse-focus', '5')
+  await h.world.clock.advance(4 * MIN)
+  expect(h.world.toasts).toEqual([])
+  await h.world.clock.advance(MIN)
+  expect(h.world.toasts).toHaveLength(1)
+  expect(h.world.toasts[0]).toMatch(/5-minute focus block is up/)
+
+  // Past the limit and still no /break: the band says so.
+  const ui = await $.ui.mount({ ...BAND, surface: 'terminal' })
+  expect(await ui.find({ type: 'Text', text: /\/break/ })).toBeDefined()
+  await ui.unmount()
+
+  // Chaining blocks without a break keeps the continuous-focus clock running.
+  await h.run('pulse-focus', '120')
+  await h.world.clock.advance(84 * MIN)
+  expect(h.world.toasts).toHaveLength(1)
+  await h.world.clock.advance(MIN)
+  expect(h.world.toasts).toHaveLength(2)
+  expect(h.world.toasts[1]).toMatch(/90 minutes/)
+
+  // Neither toast repeats.
+  await h.world.clock.advance(60 * MIN)
+  expect(h.world.toasts.filter(t => /90 minutes/.test(t))).toHaveLength(1)
+})
+
+test('/break and /done end the block and cancel its toasts', async ($, on) => {
+  const h = harness($, on, HEALTHY)
+  await h.start()
+
+  await h.run('pulse-focus', '5')
+  const broke = await h.run('break')
+  expect(broke.text).toMatch(/break/i)
+  await h.world.clock.advance(10 * MIN)
+  expect(h.world.toasts).toEqual([])
+
+  await h.run('pulse-focus', '5')
+  const done = await h.run('done')
+  expect(done.text).toMatch(/done/i)
+  await h.world.clock.advance(10 * MIN)
+  expect(h.world.toasts).toEqual([])
+
+  // With nothing running, both say so rather than failing.
+  expect((await h.run('done')).text).toMatch(/no focus block/i)
+  expect((await h.run('break')).text).toMatch(/break/i)
+})
+
+test('a break resets the 90-minute continuous-focus clock', async ($, on) => {
+  const h = harness($, on, HEALTHY)
+  await h.start()
+
+  await h.run('pulse-focus', '60')
+  await h.world.clock.advance(60 * MIN)
+  await h.run('break')
+  await h.run('pulse-focus', '60')
+  await h.world.clock.advance(60 * MIN)
+  expect(h.world.toasts.filter(t => /90 minutes/.test(t))).toEqual([])
+})
+
+test('session.end cancels the poll and every focus timer', async ($, on) => {
+  const h = harness($, on, HEALTHY)
+  await h.start()
+  await h.run('pulse-focus', '5')
+
+  await h.end()
+  const polls = h.world.urls.length
+  const toasts = h.world.toasts.length
+  await h.world.clock.advance(200 * MIN)
+
+  expect(h.world.urls).toHaveLength(polls)
+  expect(h.world.toasts).toHaveLength(toasts)
+})
+
+for (const reason of ['resume', 'logout', 'prompt_input_exit'] as const) {
+  test(`session.end (${reason}) cancels the poll and the focus timers`, async ($, on) => {
+    const h = harness($, on, HEALTHY)
+    await h.start()
+    await h.run('pulse-focus', '5')
+    await h.end(reason)
+    const polls = h.world.urls.length
+    const toasts = h.world.toasts.length
+    await h.world.clock.advance(200 * MIN)
+    expect(h.world.urls).toHaveLength(polls)
+    expect(h.world.toasts).toHaveLength(toasts)
+  })
+}
+
+// /clear ends the conversation but not the process: session.end fires with
+// reason 'clear' and no session.start follows, so the mod must keep running.
+test('session.end with reason clear leaves the poll, status and focus block running', async ($, on) => {
+  const h = harness($, on, HEALTHY)
+  await h.start()
+  await h.run('pulse-focus', '5')
+
+  await h.end('clear')
+  expect(h.world.status).toBeDefined()
+
+  // The next poll still happens and still updates the status line.
+  const polls = h.world.urls.length
+  h.set({ kind: 'ok', body: { energy: 'low', attention: 'scattered' } })
+  await h.world.clock.advance(MIN)
+  expect(h.world.urls.length).toBeGreaterThan(polls)
+  expect(h.world.status).toBe('🎯 1/5 · ⚡ low · 🧠 scattered · ⏱ 1m')
+
+  // The focus block survived: the band still counts it and the limit toast fires.
+  const ui = await $.ui.mount({ ...BAND, surface: 'terminal' })
+  expect(await ui.find({ type: 'Text', text: /4 min left of 5/ })).toBeDefined()
+  await ui.unmount()
+  await h.world.clock.advance(4 * MIN)
+  expect(h.world.toasts.filter(t => /5-minute focus block is up/.test(t))).toHaveLength(1)
+
+  // And a real end afterwards still cancels everything.
+  await h.end('other')
+  const after = h.world.urls.length
+  await h.world.clock.advance(200 * MIN)
+  expect(h.world.urls).toHaveLength(after)
+})
+
+test('the 90-minute nudge survives a /clear', async ($, on) => {
+  const h = harness($, on, HEALTHY)
+  await h.start()
+  await h.run('pulse-focus', '120')
+  await h.end('clear')
+  await h.world.clock.advance(90 * MIN)
+  expect(h.world.toasts.filter(t => /90 minutes/.test(t))).toHaveLength(1)
+})
+
+test('the band is idle (next) when no focus block runs', async ($, on) => {
+  const h = harness($, on, HEALTHY)
+  await h.start()
+
+  const ui = await $.ui.mount({ ...BAND, surface: 'terminal' })
+  expect((await ui.find({ type: 'Text', text: /engine band/ }))?.text).toBe('engine band')
+  expect(await ui.find({ type: 'Text', text: /min left/ })).toBeUndefined()
+  await ui.unmount()
+})
+
+test('the band yields to a survey and to a settled idle state after /done', async ($, on) => {
+  const h = harness($, on, HEALTHY)
+  await h.start()
+  await h.run('pulse-focus')
+  let ui = await $.ui.mount({ ...BAND, props: { ...BAND.props, hasSurvey: true }, surface: 'terminal' })
+  expect(await ui.find({ type: 'Text', text: /engine band/ })).toBeDefined()
+  await ui.unmount()
+
+  await h.run('done')
+  ui = await $.ui.mount({ ...BAND, surface: 'terminal' })
+  expect(await ui.find({ type: 'Text', text: /engine band/ })).toBeDefined()
+  await ui.unmount()
+})
+
+test('the plugin makes no call beyond one GET of the configured URL', async ($, on) => {
+  const h = harness($, on, HEALTHY)
+  on('process.run', () => {
+    throw new Error('the mod must not run processes')
+  })
+  await h.start()
+  await h.run('pulse-focus')
+  await h.world.clock.advance(30 * MIN)
+  expect(new Set(h.world.urls)).toEqual(new Set([URL]))
+})
+
+test('the engine URL option is honoured and a trailing slash is dropped', { options: { engineUrl: 'http://10.0.0.5:9999/' } }, async ($, on) => {
+  const h = harness($, on, HEALTHY)
+  await h.start()
+  expect(h.world.urls[0]).toBe('http://10.0.0.5:9999/api/v1/state')
+})
+
+test('a non-http engine URL is refused and nothing is fetched', { options: { engineUrl: 'file:///etc/passwd' } }, async ($, on) => {
+  const h = harness($, on, HEALTHY)
+  await h.start()
+  expect(h.world.urls).toEqual([])
+  expect(h.world.status).toBe('🎯 idle · ⚠ ADHD engine URL is not http(s) · ⏱ 0m')
+})
+
+// `h` (the JSX factory) is a global the engine provides; a .ts test calls it
+// directly. Named h$ so it does not collide with the harness variable `h`.
+function h$(tag: Parameters<typeof h>[0], ...children: unknown[]) {
+  return h(tag, null, ...children) as RenderElement
+}
diff --git a/plugins/dopemux-pulse/hooks/register.tsx b/plugins/dopemux-pulse/hooks/register.tsx
new file mode 100644
index 000000000..65900c830
--- /dev/null
+++ b/plugins/dopemux-pulse/hooks/register.tsx
@@ -0,0 +1,374 @@
+import type { EngineInterface, Register, Timer } from 'claude-code'
+
+// dopemux-pulse: a read-only ADHD status line and focus clock.
+//
+// The only network call is one GET of `<engineUrl>/api/v1/state`. No process,
+// no file write, no prompt or tool hook, no model call. Every hook body is
+// wrapped so an exception never reaches the person.
+//
+// The engine's static reader follows `$` only through functions declared at
+// the top of this file, so the helpers below take `$` and the session's state
+// object as arguments instead of closing over them.
+
+const DEFAULT_ENGINE_URL = 'http://127.0.0.1:3025'
+const MINUTE = 60_000
+const POLL_MS = MINUTE
+const FETCH_TIMEOUT_MS = 2_000
+const DEFAULT_FOCUS_MINUTES = 25
+const MIN_FOCUS_MINUTES = 5
+const MAX_FOCUS_MINUTES = 120
+const NUDGE_AFTER_MINUTES = 90
+
+type EngineView =
+  | { kind: 'connecting' }
+  | { kind: 'ok'; energy: string; attention: string }
+  | { kind: 'down'; httpStatus?: number }
+  | { kind: 'malformed' }
+  | { kind: 'bad-url' }
+
+type FocusBlock = { startedAt: number; minutes: number; timers: Timer[] }
+
+// One module load's state. Module-local on purpose: a reload starts fresh and
+// nothing is persisted.
+type Pulse = {
+  baseUrl: string | undefined
+  sessionStartedAt: number | undefined
+  isEnded: boolean
+  isPolling: boolean
+  view: EngineView
+  wasUp: boolean | undefined
+  pollTimer: Timer | undefined
+  focus: FocusBlock | undefined
+  continuousSince: number | undefined
+  nudgeTimer: Timer | undefined
+}
+
+// The engine's own words, shown as given but never trusted: letters, digits,
+// space, `_` and `-`, at most 24 of them.
+function word(value: unknown): string | undefined {
+  if (typeof value !== 'string') return undefined
+  const clean = value.replace(/[^\p{L}\p{N} _-]/gu, '').trim().slice(0, 24)
+  return clean === '' ? undefined : clean
+}
+
+// `energy` and `attention` are the engine's current keys; `energy_level` and
+// `attention_state` are the aliases a coordinated engine fix adds.
+function parseState(text: string): EngineView {
+  let body: unknown
+  try {
+    body = JSON.parse(text)
+  } catch {
+    return { kind: 'malformed' }
+  }
+  if (typeof body !== 'object' || body === null || Array.isArray(body)) {
+    return { kind: 'malformed' }
+  }
+  const state = body as Record<string, unknown>
+  const energy = word(state.energy) ?? word(state.energy_level)
+  const attention = word(state.attention) ?? word(state.attention_state)
+  if (energy === undefined && attention === undefined) return { kind: 'malformed' }
+  return { kind: 'ok', energy: energy ?? '?', attention: attention ?? '?' }
+}
+
+// Whole minutes only: `/pulse-focus` takes "", "25", " 45 " and nothing else.
+function parseMinutes(args: string): number | undefined {
+  const trimmed = args.trim()
+  if (trimmed === '') return DEFAULT_FOCUS_MINUTES
+  if (!/^\d{1,4}$/.test(trimmed)) return undefined
+  const minutes = Number(trimmed)
+  return minutes >= MIN_FOCUS_MINUTES && minutes <= MAX_FOCUS_MINUTES ? minutes : undefined
+}
+
+function engineUrl(option: unknown): string | undefined {
+  const raw = option === undefined ? DEFAULT_ENGINE_URL : option
+  if (typeof raw !== 'string') return undefined
+  const trimmed = raw.trim().replace(/\/+$/, '')
+  return /^https?:\/\/[^\s/]+/i.test(trimmed) ? trimmed : undefined
+}
+
+async function renderStatus($: EngineInterface, s: Pulse): Promise<void> {
+  if (s.isEnded) return
+  const now = await $.clock.now()
+  const parts: string[] = []
+
+  if (s.focus === undefined) {
+    parts.push('🎯 idle')
+  } else {
+    const elapsed = Math.floor((now - s.focus.startedAt) / MINUTE)
+    parts.push(
+      elapsed >= s.focus.minutes
+        ? `🎯 ${s.focus.minutes}/${s.focus.minutes} done`
+        : `🎯 ${elapsed}/${s.focus.minutes}`,
+    )
+  }
+
+  const view = s.view
+  switch (view.kind) {
+    case 'ok':
+      parts.push(`⚡ ${view.energy}`, `🧠 ${view.attention}`)
+      break
+    case 'down':
+      parts.push(
+        view.httpStatus === undefined
+          ? '🔌 ADHD engine unreachable'
+          : `🔌 ADHD engine unreachable (HTTP ${view.httpStatus})`,
+      )
+      break
+    case 'malformed':
+      parts.push('⚠ ADHD engine state malformed')
+      break
+    case 'bad-url':
+      parts.push('⚠ ADHD engine URL is not http(s)')
+      break
+    case 'connecting':
+      parts.push('⏳ ADHD engine: connecting')
+      break
+  }
+
+  const sessionMinutes =
+    s.sessionStartedAt === undefined ? 0 : Math.floor((now - s.sessionStartedAt) / MINUTE)
+  parts.push(`⏱ ${sessionMinutes}m`)
+
+  $.ui.status(parts.join(' · '))
+}
+
+async function fetchState($: EngineInterface, s: Pulse): Promise<EngineView> {
+  if (s.baseUrl === undefined) return { kind: 'bad-url' }
+  let timer: Timer | undefined
+  try {
+    const timeout = new Promise<'timeout'>(resolve => {
+      timer = $.clock.after(FETCH_TIMEOUT_MS, () => resolve('timeout'))
+    })
+    const response = await Promise.race([$.http.fetch(`${s.baseUrl}/api/v1/state`), timeout])
+    if (response === 'timeout') return { kind: 'down' }
+    if (!response.ok) return { kind: 'down', httpStatus: response.status }
+    return parseState(response.text)
+  } catch {
+    return { kind: 'down' }
+  } finally {
+    timer?.cancel()
+  }
+}
+
+async function poll($: EngineInterface, s: Pulse): Promise<void> {
+  if (s.isEnded || s.isPolling) return
+  s.isPolling = true
+  try {
+    const next = await fetchState($, s)
+    if (s.isEnded) return
+    s.view = next
+
+    // Toast on a real transition only; a never-up engine is just the status.
+    if (next.kind !== 'bad-url') {
+      const isUp = next.kind === 'ok'
+      if (s.wasUp === true && !isUp) {
+        $.ui.toast(
+          next.kind === 'malformed' ? 'ADHD engine state malformed' : 'ADHD engine unreachable',
+        )
+      } else if (s.wasUp === false && isUp) {
+        $.ui.toast('ADHD engine is back')
+      }
+      s.wasUp = isUp
+    }
+    await renderStatus($, s)
+  } catch {
+    // A failed poll must never surface.
+  } finally {
+    s.isPolling = false
+  }
+}
+
+function stopFocus(s: Pulse): void {
+  for (const timer of s.focus?.timers ?? []) timer.cancel()
+  s.focus = undefined
+}
+
+function stopContinuous(s: Pulse): void {
+  s.nudgeTimer?.cancel()
+  s.nudgeTimer = undefined
+  s.continuousSince = undefined
+}
+
+function redraw($: EngineInterface, s: Pulse): void {
+  try {
+    $.ui.invalidate('ui.render')
+    void renderStatus($, s).catch(() => undefined)
+  } catch {
+    // never surface
+  }
+}
+
+export const register: Register = (on, options) => {
+  const s: Pulse = {
+    baseUrl: engineUrl(options.engineUrl),
+    sessionStartedAt: undefined,
+    isEnded: false,
+    isPolling: false,
+    view: { kind: 'connecting' },
+    wasUp: undefined,
+    pollTimer: undefined,
+    focus: undefined,
+    continuousSince: undefined,
+    nudgeTimer: undefined,
+  }
+
+  on('session.start', async ($, e, next) => {
+    try {
+      s.sessionStartedAt = await $.clock.now()
+      await renderStatus($, s)
+
+      // One refused registration must not stop the status line.
+      await $.command
+        .register({
+          name: 'pulse-focus',
+          description: 'Start a focus block (5-120 minutes, default 25).',
+          argumentHint: '[minutes]',
+        })
+        .catch(() => undefined)
+      await $.command
+        .register({ name: 'break', description: 'End the focus block and take a break.' })
+        .catch(() => undefined)
+      await $.command
+        .register({ name: 'done', description: 'Finish the focus block.' })
+        .catch(() => undefined)
+
+      // The first poll must not hold the session start; its answer lands in
+      // the status line when it arrives.
+      void poll($, s)
+      s.pollTimer = $.clock.every(POLL_MS, () => {
+        void poll($, s)
+      })
+    } catch {
+      // Never surface a failure from setup.
+    }
+    return next(e)
+  })
+
+  on('command.run', { command: 'pulse-focus' }, async ($, e) => {
+    try {
+      const minutes = parseMinutes(e.args)
+      if (minutes === undefined) {
+        return {
+          text: `Focus minutes must be a whole number from ${MIN_FOCUS_MINUTES}-${MAX_FOCUS_MINUTES} (default ${DEFAULT_FOCUS_MINUTES}). Nothing started.`,
+        }
+      }
+
+      const now = await $.clock.now()
+      const isRestart = s.focus !== undefined
+      stopFocus(s)
+
+      const timers: Timer[] = [
+        $.clock.after(minutes * MINUTE, () => {
+          try {
+            $.ui.toast(
+              `🎯 Your ${minutes}-minute focus block is up. /break to rest, or /done to finish.`,
+              { timeoutMs: 10_000 },
+            )
+            redraw($, s)
+          } catch {
+            // never surface
+          }
+        }),
+        // One tick a minute keeps the band and the status line current.
+        $.clock.every(MINUTE, () => redraw($, s)),
+      ]
+      s.focus = { startedAt: now, minutes, timers }
+
+      // Continuous focus runs from the first block after a break (or the
+      // session start) until /break or /done; chained blocks do not reset it.
+      if (s.continuousSince === undefined) {
+        s.continuousSince = now
+        s.nudgeTimer = $.clock.after(NUDGE_AFTER_MINUTES * MINUTE, () => {
+          try {
+            $.ui.toast(
+              `You have been focused for ${NUDGE_AFTER_MINUTES} minutes straight. A short break now will help the next stretch. /break when you are ready.`,
+              { timeoutMs: 10_000 },
+            )
+          } catch {
+            // never surface
+          }
+        })
+      }
+
+      redraw($, s)
+      return {
+        text: `${isRestart ? 'Restarted: ' : ''}Focus block started for ${minutes} minutes. /break to rest, /done to finish.`,
+      }
+    } catch {
+      return { text: 'dopemux-pulse: could not start the focus block.' }
+    }
+  })
+
+  on('command.run', { command: 'break' }, async $ => {
+    try {
+      stopFocus(s)
+      stopContinuous(s)
+      redraw($, s)
+      return {
+        text: 'Break time. Stand up, drink some water, look away from the screen. /pulse-focus when you are ready.',
+      }
+    } catch {
+      return { text: 'dopemux-pulse: could not record the break.' }
+    }
+  })
+
+  on('command.run', { command: 'done' }, async $ => {
+    try {
+      if (s.focus === undefined) return { text: 'No focus block is running.' }
+      const now = await $.clock.now()
+      const elapsed = Math.floor((now - s.focus.startedAt) / MINUTE)
+      stopFocus(s)
+      stopContinuous(s)
+      redraw($, s)
+      return { text: `Focus block done after ${elapsed} minutes. Nice work.` }
+    } catch {
+      return { text: 'dopemux-pulse: could not finish the focus block.' }
+    }
+  })
+
+  on('ui.render', { component: 'AbovePrompt' }, async ($, e, next) => {
+    let line: string | undefined
+    try {
+      if (!e.props.hasSurvey && s.focus !== undefined) {
+        const now = await $.clock.now()
+        const leftMs = s.focus.minutes * MINUTE - (now - s.focus.startedAt)
+        line =
+          leftMs > 0
+            ? `🎯 Focus: ${Math.ceil(leftMs / MINUTE)} min left of ${s.focus.minutes} · /break · /done`
+            : `🎯 Focus block done (+${Math.floor(-leftMs / MINUTE)} min). /break to rest or /done to finish.`
+      }
+    } catch {
+      line = undefined
+    }
+    if (line === undefined) return next(e)
+
+    try {
+      const { Box, Text } = $.ui.resolve(e)
+      return (
+        <Box>
+          <Text dimColor>{line}</Text>
+        </Box>
+      )
+    } catch {
+      return next(e)
+    }
+  })
+
+  on('session.end', async ($, e, next) => {
+    // /clear fires session.end with reason 'clear' but the process goes on and
+    // no session.start follows, so the poll, status line and focus block must
+    // keep running. Every other reason is a real end: cancel everything.
+    if (e.reason === 'clear') return next(e)
+    try {
+      s.isEnded = true
+      s.pollTimer?.cancel()
+      s.pollTimer = undefined
+      stopFocus(s)
+      stopContinuous(s)
+      $.ui.status(undefined)
+    } catch {
+      // never surface
+    }
+    return next(e)
+  })
+}
