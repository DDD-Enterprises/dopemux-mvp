+    replacement = lc._resolve_ports(identity, selected, _catalog(), lease_path=paths.leases,
+                                    env={k: str(v) for k, v in old.items()},
+                                    is_free_fn=lambda p: True)
+    assert all(replacement[k] != old[k] for k in old)
