{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "control_tower.execution_binding.v1"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "const": "NONE"
    },
    "authority_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_packet_ref": {
          "type": "string",
          "minLength": 1
        },
        "operator_gate_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "task_packet_ref",
        "operator_gate_refs"
      ]
    },
    "policy_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dcp_route_decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "dcp_status": {
          "enum": [
            "PASS",
            "BLOCKED",
            "UNKNOWN",
            "NOT_RUN"
          ]
        },
        "dcp_risk_class": {
          "enum": [
            "R0_READ",
            "R1_LOW",
            "R2_MEDIUM",
            "R3_HIGH",
            "RED_LANE",
            "UNKNOWN",
            "NOT_RUN"
          ]
        },
        "task_orchestrator_state_ref": {
          "type": "string",
          "minLength": 1
        },
        "universal_router_recommendation_ref": {
          "type": "string",
          "minLength": 1
        },
        "audit_broker_certification_ref": {
          "type": "string",
          "minLength": 1
        },
        "context_packet_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "dcp_route_decision_ref",
        "dcp_status",
        "dcp_risk_class",
        "task_orchestrator_state_ref",
        "universal_router_recommendation_ref",
        "audit_broker_certification_ref",
        "context_packet_ref"
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "risk_lane": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3"
          ]
        }
      },
      "required": [
        "risk_lane"
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "runner_availability": {
          "enum": [
            "PROVEN",
            "PROPOSED",
            "UNKNOWN"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "minLength": 1
        },
        "connector": {
          "type": "string",
          "minLength": 1
        },
        "configured_identity": {
          "type": "string",
          "minLength": 1
        },
        "response_claimed_identity": {
          "type": "string",
          "minLength": 1
        },
        "provider_attested_identity": {
          "type": "string",
          "minLength": 1
        },
        "containment_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "runner",
        "runner_availability",
        "model",
        "effort",
        "connector",
        "configured_identity",
        "response_claimed_identity",
        "provider_attested_identity",
        "containment_evidence"
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "custody_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "context_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "allowed_actions",
        "forbidden_actions",
        "stop_conditions",
        "custody_constraints",
        "context_constraints"
      ]
    },
    "justification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "why_runner": {
          "type": "string",
          "minLength": 1
        },
        "why_model": {
          "type": "string",
          "minLength": 1
        },
        "why_effort": {
          "type": "string",
          "minLength": 1
        },
        "alternatives_considered": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "route": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "route",
              "disposition",
              "reason"
            ]
          }
        },
        "cost_latency_tradeoff": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "why_runner",
        "why_model",
        "why_effort",
        "alternatives_considered",
        "cost_latency_tradeoff",
        "evidence"
      ]
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "effective_required": {
          "type": "boolean"
        },
        "effective_requirement_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "upstream_obligations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_ref": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "source_ref",
              "required"
            ]
          }
        },
        "selected_auditor_binding": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "effective_required",
        "effective_requirement_sources",
        "upstream_obligations",
        "selected_auditor_binding"
      ]
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runner": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "effort": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "runner",
            "model",
            "effort"
          ]
        }
      },
      "required": [
        "allowed",
        "trigger",
        "binding"
      ]
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "legacy_source": {
          "type": "string",
          "minLength": 1
        },
        "legacy_record": {
          "type": "object"
        }
      },
      "required": [
        "legacy_source",
        "legacy_record"
      ]
    },
    "macro_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "stage",
    "authority",
    "authority_refs",
    "policy_refs",
    "delivery",
    "selection",
    "constraints",
    "justification",
    "audit",
    "fallback"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "required": [
        "packet_id"
      ]
    },
    {
      "required": [
        "macro_id"
      ]
    }
  ]
}
