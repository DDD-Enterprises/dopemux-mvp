# Dopemux Configuration Template
# Copy this file to .env and fill in your actual values

# Database
# REQUIRED: generate with: openssl rand -hex 32
AGE_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32_placeholder

# Redis
# REQUIRED: generate with: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32_placeholder

# Vector Database
# REQUIRED: generate with: openssl rand -hex 32
QDRANT_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32_placeholder

# API Keys
# REQUIRED: generate with: openssl rand -hex 32
ADHD_ENGINE_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32_placeholder
# REQUIRED: generate with: openssl rand -hex 32
TASK_ORCHESTRATOR_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32_placeholder
# Optional provider keys; leave blank to defer that provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Canonical Gemini key for Dopemux is GEMINI_API_KEY.
# Do not add GOOGLE_API_KEY to this file.
GEMINI_API_KEY=
XAI_API_KEY=
VOYAGE_API_KEY=
TAVILY_API_KEY=

# Alternative Provider (ALTP) Tier-Specific Keys
# These keys are used when --altp flag is enabled for model routing
# Each tier can use a different provider/API key
ALTP_OPUS_KEY=  # For altp-opus tier (high thinking tasks)
ALTP_SONNET_KEY=  # For altp-sonnet tier (balanced tasks)
ALTP_HAIKU_KEY=  # For altp-haiku tier (fast tasks)

# Frontend
FRONTEND_API_URL=http://localhost:8000

# Optional Service URLs
LEANTIME_URL=http://leantime:80
LEANTIME_TOKEN=

# Serena MCP Service
# HOME is a required OS environment variable used for Serena bind mounts
# (e.g. ${HOME}/.serena and ${HOME}/code). Ensure HOME is set in your shell
# before running `docker compose up`. On Linux/macOS this is set automatically.
# On Windows use WSL or set USERPROFILE manually.
# HOST_CODE_PARENT_DIR sets the host parent directory mounted as /workspaces in Serena.
HOST_CODE_PARENT_DIR=
# HOST_PROJECT_RELATIVE_PATH is the relative path within HOST_CODE_PARENT_DIR for the current project.
HOST_PROJECT_RELATIVE_PATH=

# Environment
ENVIRONMENT=development
LOG_LEVEL=info
