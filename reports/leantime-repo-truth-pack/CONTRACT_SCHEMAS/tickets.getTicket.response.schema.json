{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Leantime Ticket Object",
  "description": "Response shape for leantime.rpc.tickets.tickets.getTicket. Derived from app/Domain/Tickets/Models/Tickets.php and app/Domain/Tickets/Repositories/Tickets.php.",
  "type": "object",
  "properties": {
    "id": { "type": ["integer", "string"], "description": "Ticket ID (auto-increment PK)" },
    "headline": { "type": ["string", "null"], "description": "Ticket title" },
    "type": { "type": ["string", "null"], "enum": ["task", "subtask", "story", "bug", "feature", "epic", "documentation", "improvement", "research", "milestone", null], "description": "Ticket type" },
    "description": { "type": ["string", "null"], "description": "HTML content from Tiptap editor" },
    "projectId": { "type": ["integer", "string", "null"] },
    "status": { "type": ["integer", "string", "null"], "description": "3=NEW, 1=BLOCKED, 4=IN_PROGRESS, 2=WAITING_FOR_APPROVAL, 0=DONE, -1=ARCHIVED" },
    "priority": { "type": ["integer", "string", "null"], "description": "1=Critical, 2=High, 3=Medium, 4=Low, 5=Lowest" },
    "storypoints": { "type": ["number", "string", "null"], "description": "Effort: 0.5, 1, 2, 3, 5, 8, 13" },
    "sprint": { "type": ["integer", "string", "null"], "description": "Sprint ID" },
    "milestoneid": { "type": ["integer", "string", "null"], "description": "Milestone ticket ID" },
    "userId": { "type": ["integer", "string", "null"], "description": "Creator user ID" },
    "editorId": { "type": ["integer", "string", "null"], "description": "Assignee user ID" },
    "date": { "type": ["string", "null"], "description": "Creation date (YYYY-MM-DD HH:MM:SS UTC)" },
    "dateToFinish": { "type": ["string", "null"], "description": "Due date" },
    "editFrom": { "type": ["string", "null"], "description": "Timeline start" },
    "editTo": { "type": ["string", "null"], "description": "Timeline end" },
    "planHours": { "type": ["number", "string", "null"], "description": "Planned hours" },
    "hourRemaining": { "type": ["number", "string", "null"], "description": "Remaining hours" },
    "bookedHours": { "type": ["number", "string", "null"], "description": "Logged hours" },
    "acceptanceCriteria": { "type": ["string", "null"], "description": "HTML content" },
    "tags": { "type": ["string", "null"], "description": "Comma-separated tags" },
    "url": { "type": ["string", "null"], "description": "External URL reference" },
    "dependingTicketId": { "type": ["integer", "string", "null"], "description": "Dependency (not enforced)" },
    "sortIndex": { "type": ["integer", "string", "null"] },
    "modified": { "type": ["string", "null"], "description": "Last modification timestamp" },
    "userFirstname": { "type": ["string", "null"] },
    "userLastname": { "type": ["string", "null"] },
    "editorFirstname": { "type": ["string", "null"] },
    "editorLastname": { "type": ["string", "null"] },
    "projectName": { "type": ["string", "null"] },
    "clientName": { "type": ["string", "null"] },
    "milestoneHeadline": { "type": ["string", "null"] },
    "milestoneColor": { "type": ["string", "null"] },
    "percentDone": { "type": ["number", "string", "null"] },
    "children": { "type": ["array", "null"], "description": "Sub-tickets array" },
    "collaborators": { "type": ["array", "null"] }
  }
}
