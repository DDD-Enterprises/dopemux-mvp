{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Leantime Project Object",
  "description": "Response shape for leantime.rpc.projects.projects.getProject. Derived from app/Domain/Projects/Models/Project.php and app/Domain/Projects/Repositories/Projects.php.",
  "type": "object",
  "properties": {
    "id": { "type": ["integer", "string"], "description": "Project ID (auto-increment PK)" },
    "name": { "type": ["string", "null"] },
    "clientId": { "type": ["integer", "string", "null"] },
    "clientName": { "type": ["string", "null"] },
    "details": { "type": ["string", "null"], "description": "Project description (HTML)" },
    "state": { "type": ["integer", "string", "null"], "description": "0=OPEN, 1=CLOSED" },
    "type": { "type": ["string", "null"] },
    "menuType": { "type": ["string", "null"] },
    "start": { "type": ["string", "null"], "description": "Start date" },
    "end": { "type": ["string", "null"], "description": "End date" },
    "hourBudget": { "type": ["number", "string", "null"] },
    "dollarBudget": { "type": ["number", "string", "null"] },
    "sortIndex": { "type": ["integer", "string", "null"] },
    "progress": { "type": ["number", "null"], "description": "Progress percentage" },
    "numberOfTickets": { "type": ["integer", "null"] },
    "milestones": { "type": ["array", "null"] },
    "lastUpdate": { "type": ["string", "null"] },
    "report": { "description": "Report data (mixed)" },
    "status": { "description": "Status indicator (mixed)" },
    "isFavorite": { "type": ["boolean", "null"] },
    "modified": { "type": ["string", "null"] },
    "created": { "type": ["string", "null"] },
    "avatar": { "type": ["string", "null"] },
    "cover": { "type": ["string", "null"] },
    "parent": { "type": ["integer", "string", "null"] },
    "psettings": { "type": ["string", "null"], "description": "Project settings JSON" }
  }
}
