+def _get_execution_step_filter(args: argparse.Namespace) -> Optional[str]:
+    raw = str(getattr(args, "step", "") or "").strip()
+    if not raw:
+        return None
+    normalized = raw.upper()
+    if "," in normalized:
+        raise RuntimeError("Execution step filtering accepts exactly one step id.")
