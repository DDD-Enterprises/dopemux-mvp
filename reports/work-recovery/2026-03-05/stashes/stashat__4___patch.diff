+    output_dir: Path,
+    max_retries: int = 3,
+    retry_delay: int = 5
+) -> Dict[str, Dict[str, Any]]:
+    """
+    Retrieve multiple Gemini batches and download their results.
+    
+    Args:
+        api_key: Gemini API key
+        batch_ids: List of batch IDs to retrieve
+        output_dir: Directory to save output/error files
+        max_retries: Maximum number of retries for failed downloads
+        retry_delay: Delay between retries in seconds
+        
+    Returns:
+        Dictionary mapping batch_id -> result_dict
+    """
+    output_dir.mkdir(exist_ok=True)
+    results = {}
+    
+    for batch_id in batch_ids:
+        success, result = retrieve_gemini_batch(
+            api_key, batch_id, output_dir, max_retries, retry_delay
+        )
+        results[batch_id] = result
+    
+    # Summary statistics
+    completed = sum(1 for r in results.values() if ("succeeded" in r["status"] or "done" in r["status"] or "completed" in r["status"]))
+    failed = sum(1 for r in results.values() if ("failed" in r["status"] or "expired" in r["status"]))
+    errors = sum(1 for r in results.values() if r["error"])
+    
+    logger.info(f"\nGemini Batch Retrieval Summary:")
+    logger.info(f"  Completed: {completed}")
+    logger.info(f"  Failed/Expired: {failed}")
+    logger.info(f"  Errors: {errors}")
+    logger.info(f"  Total: {len(results)}")
+    
+    return results
+
