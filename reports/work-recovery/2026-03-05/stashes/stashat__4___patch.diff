+def _apply_mode(mode_value: str, reload_services: bool) -> None:
+    manager = LaunchdServiceManager.get_instance()
+    config = manager.routing_config.load()
+    requested = mode_value.lower()
+    current_mode = config.get("mode")
+    if current_mode == requested:
+        click.echo(f"⚠️  Routing mode is already '{requested}'.")
+        return
+
+    config["mode"] = requested
+    config_path = manager.routing_config.config_path
+    with open(config_path, "w", encoding="utf-8") as f:
+        yaml.safe_dump(config, f, sort_keys=False)
+    manager.routing_config._loaded = False
+    manager.routing_config.load()
+    click.echo(f"✅ Routing mode switched to '{requested}'.")
+    if reload_services:
+        click.echo("🔄 Reloading launchd services...")
+        manager.reload_services()
+        click.echo("✅ Launchd services reloaded.")
+
+
+@routing.command("set-mode")
+@click.argument("mode", type=click.Choice(["subscription", "api"], case_sensitive=False))
+@click.option("--reload", "reload_services", is_flag=True, default=False, help="Reload launchd services after switching modes.")
+def set_mode(mode: str, reload_services: bool) -> None:
+    """Switch routing configuration between subscription and API modes."""
+    try:
+        _apply_mode(mode, reload_services)
+    except Exception as e:
+        logger.error(f"Failed to set routing mode: {e}")
+        click.echo(f"❌ Error: {e}", err=True)
+        raise
+
+
+@routing.command()
+@click.option("--reload", "reload_services", is_flag=True, default=False, help="Reload launchd services after switching to API mode.")
+def api(reload_services: bool) -> None:
+    """Shortcut for `routing set-mode api`."""
+    try:
+        _apply_mode("api", reload_services)
+    except Exception as e:
+        logger.error(f"Failed to set routing mode to API: {e}")
+        click.echo(f"❌ Error: {e}", err=True)
+        raise
+
+
+@routing.command()
+@click.option("--reload", "reload_services", is_flag=True, default=False, help="Reload launchd services after switching to subscription mode.")
+def plan(reload_services: bool) -> None:
+    """Shortcut for `routing set-mode subscription`."""
+    try:
+        _apply_mode("subscription", reload_services)
+    except Exception as e:
+        logger.error(f"Failed to set routing mode to subscription: {e}")
+        click.echo(f"❌ Error: {e}", err=True)
+        raise
+
+
