+                            for batch_result in batch_results:
+                                result_dict = {
+                                    "custom_id": batch_result.custom_id,
+                                    "output_text": batch_result.output_text,
+                                    "error": batch_result.error,
+                                    "meta": batch_result.meta
+                                }
+                                f.write(json.dumps(result_dict, ensure_ascii=False) + "\n")
+                        
+                        result["output_file"] = str(output_path)
+                        logger.info(f"  ↓ Downloaded output to {output_path}")
+                    break
+                    
+                except Exception as e:
+                    if attempt == max_retries - 1:
+                        result["error"] = f"Failed to download results after {max_retries} attempts: {e}"
