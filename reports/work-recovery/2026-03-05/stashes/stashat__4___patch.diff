+        - error_file: Path to error file if downloaded
+        - error: Error message if any
+    """
+    client = GeminiBatchClient(api_key=api_key)
+    result = {
+        "batch_id": batch_id,
+        "status": "unknown",
+        "output_file": None,
+        "error_file": None,
+        "error": None
+    }
+    
+    try:
+        # Get batch status
+        status = client.poll(batch_id)
+        result["status"] = status
+        
+        logger.info(f"Gemini Batch {batch_id}: status={status}")
+        
+        # Download results if completed
+        # Gemini returns status like "jobstate.job_state_succeeded"
+        if "succeeded" in status or "done" in status or "completed" in status:
+            for attempt in range(max_retries):
+                try:
+                    batch_results = client.fetch_results(batch_id)
+                    if batch_results:
+                        # Replace slashes in batch ID for filename safety
+                        safe_batch_id = batch_id.replace("/", "_")
+                        output_path = output_dir / f"{safe_batch_id}_output.jsonl"
