  "red_lane_policy": {
    "policy_ref": null,
    "default_on_unknown": "BLOCK",
    "lanes": ["rdcp-proof-pointer", "rdcp-source-ledger", "rdcp-review-sensor", "rdcp-task-orchestrator"]
  },
  "forbidden_paths": [
    {"glob": "data/**", "reason": "runtime and client data are outside the artifact-only bridge", "result": "BLOCKED_RUNTIME_DB"},
    {"glob": "src/dnh_crm/runtime/**", "reason": "runtime service plane is not authorized", "result": "NEEDS_SUPERVISOR"},
    {"glob": "**/*token*", "reason": "credentials and tokens are never planner evidence", "result": "BLOCKED_NO_WRITE_CONTRACT"}
  ],
  "export_mode": "ARTIFACT_ONLY",
  "unknown_policy": "FAIL_CLOSED"
}
