{
  "schema_version": "pcp.project_profile.v0",
  "project_id": "DDD-Enterprises/dnh-crm",
  "project_kind": "DNH_CRM",
  "repo": {
    "name": "dnh-crm",
    "root_marker": "AGENTS.md",
