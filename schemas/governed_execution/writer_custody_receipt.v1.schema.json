{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dopemux.dev/schemas/governed_execution/writer_custody_receipt.v1.schema.json",
  "title": "Governed Execution Contract v2 - WriterCustodyReceipt",
  "description": "Records the identity, lease, allowlist and filesystem scope of the single mutating implementer holding custody of a Task Packet's write surface. authority is const NONE: schema-valid does not imply authority-valid.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "dopemux.governed_execution.writer_custody_receipt.v1"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "repo_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin_url": { "type": "string", "minLength": 1 },
        "toplevel": { "type": "string", "minLength": 1 }
      },
      "required": ["origin_url", "toplevel"]
    },
    "worktree_path": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "base_sha": { "$ref": "enums.v1.schema.json#/definitions/git_oid" },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowlist_digest": { "$ref": "enums.v1.schema.json#/definitions/sha256" },
    "writer_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runner": { "type": "string", "minLength": 1 },
        "session_ref": { "type": "string", "minLength": 1 },
        "agent_role": { "type": "string", "minLength": 1 }
      },
      "required": ["runner", "session_ref", "agent_role"]
    },
    "writer_lease": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issued_at": { "$ref": "enums.v1.schema.json#/definitions/rfc3339_utc" },
        "expires_at": { "$ref": "enums.v1.schema.json#/definitions/rfc3339_utc" },
        "lease_id": { "type": "string", "minLength": 1 }
      },
      "required": ["issued_at", "expires_at", "lease_id"]
    },
    "diff_provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_sha": { "$ref": "enums.v1.schema.json#/definitions/git_oid" },
        "head_sha": { "$ref": "enums.v1.schema.json#/definitions/git_oid" },
        "patch_sha256": { "$ref": "enums.v1.schema.json#/definitions/sha256" }
      },
      "required": ["base_sha", "head_sha", "patch_sha256"]
    },
    "rollback_locality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": { "$ref": "enums.v1.schema.json#/definitions/rollback_strategy" },
        "boundary": { "type": "string", "minLength": 1 }
      },
      "required": ["strategy", "boundary"]
    },
    "filesystem_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "outside_root_writes": { "const": false }
      },
      "required": ["root", "outside_root_writes"]
    },
    "custody_state": { "$ref": "enums.v1.schema.json#/definitions/custody_state" },
    "authority": { "const": "NONE" }
  },
  "required": [
    "schema_version",
    "packet_id",
    "repo_identity",
    "worktree_path",
    "branch",
    "base_sha",
    "allowed_paths",
    "allowlist_digest",
    "writer_identity",
    "writer_lease",
    "diff_provenance",
    "rollback_locality",
    "filesystem_scope",
    "custody_state",
    "authority"
  ]
}
