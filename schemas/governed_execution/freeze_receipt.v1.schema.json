{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dopemux.dev/schemas/governed_execution/freeze_receipt.v1.schema.json",
  "title": "Governed Execution Contract v2 - FreezeReceipt",
  "description": "Records a content freeze of a Task Packet's substantive paths prior to any audit. no_audit_before_freeze is always true: no audit receipt may predate the freeze it evaluates. authority is const NONE: schema-valid does not imply authority-valid.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "dopemux.governed_execution.freeze_receipt.v1"
    },
    "packet_id": { "type": "string", "minLength": 1 },
    "macro_id": { "type": "string", "minLength": 1 },
    "repo_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin_url": { "type": "string", "minLength": 1 },
        "toplevel": { "type": "string", "minLength": 1 }
      },
      "required": ["origin_url", "toplevel"]
    },
    "base_sha": { "$ref": "enums.v1.schema.json#/definitions/git_oid" },
    "head_sha": { "$ref": "enums.v1.schema.json#/definitions/git_oid" },
    "tree_sha": { "$ref": "enums.v1.schema.json#/definitions/git_oid" },
    "substantive_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "substantive_path_digest": { "$ref": "enums.v1.schema.json#/definitions/sha256" },
    "candidate_digest": { "$ref": "enums.v1.schema.json#/definitions/sha256" },
    "validation_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "enums.v1.schema.json#/definitions/sha256" }
        },
        "required": ["path", "sha256"]
      }
    },
    "review_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "enums.v1.schema.json#/definitions/sha256" }
        },
        "required": ["path", "sha256"]
      }
    },
    "frozen_at": { "$ref": "enums.v1.schema.json#/definitions/rfc3339_utc" },
    "freeze_state": { "$ref": "enums.v1.schema.json#/definitions/freeze_state" },
    "supersedes_freeze_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "enums.v1.schema.json#/definitions/sha256" }
      },
      "required": ["path", "sha256"]
    },
    "no_audit_before_freeze": { "const": true },
    "authority": { "const": "NONE" }
  },
  "required": [
    "schema_version",
    "packet_id",
    "macro_id",
    "repo_identity",
    "base_sha",
    "head_sha",
    "tree_sha",
    "substantive_paths",
    "substantive_path_digest",
    "candidate_digest",
    "validation_refs",
    "review_refs",
    "frozen_at",
    "freeze_state",
    "no_audit_before_freeze",
    "authority"
  ]
}
