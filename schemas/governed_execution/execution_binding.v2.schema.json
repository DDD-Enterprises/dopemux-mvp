{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dopemux.dev/schemas/governed_execution/execution_binding.v2.schema.json",
  "title": "Governed Execution Contract v2 - ExecutionBinding",
  "description": "Additive successor of .control-tower/schemas/execution_binding.schema.json (control_tower.execution_binding.v1, untouched). Every v1 property is retained with identical type; new fields are additive and required. authority remains const NONE: schema-valid does not imply authority-valid.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "dopemux.governed_execution.execution_binding.v2"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "macro_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "const": "NONE"
    },
    "authority_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_packet_ref": {
          "type": "string",
          "minLength": 1
        },
        "operator_gate_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["task_packet_ref", "operator_gate_refs"]
    },
    "policy_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dcp_route_decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "dcp_status": {
          "$ref": "enums.v1.schema.json#/definitions/dcp_status"
        },
        "dcp_risk_class": {
          "$ref": "enums.v1.schema.json#/definitions/dcp_risk_class"
        },
        "task_orchestrator_state_ref": {
          "type": "string",
          "minLength": 1
        },
        "universal_router_recommendation_ref": {
          "type": "string",
          "minLength": 1
        },
        "audit_broker_certification_ref": {
          "type": "string",
          "minLength": 1
        },
        "context_packet_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "dcp_route_decision_ref",
        "dcp_status",
        "dcp_risk_class",
        "task_orchestrator_state_ref",
        "universal_router_recommendation_ref",
        "audit_broker_certification_ref",
        "context_packet_ref"
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "risk_lane": {
          "$ref": "enums.v1.schema.json#/definitions/risk_lane"
        }
      },
      "required": ["risk_lane"]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "runner_availability": {
          "$ref": "enums.v1.schema.json#/definitions/runner_availability"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "minLength": 1
        },
        "connector": {
          "type": "string",
          "minLength": 1
        },
        "configured_identity": {
          "type": "string",
          "minLength": 1
        },
        "response_claimed_identity": {
          "type": "string",
          "minLength": 1
        },
        "provider_attested_identity": {
          "type": "string",
          "minLength": 1
        },
        "containment_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "runner",
        "runner_availability",
        "model",
        "effort",
        "connector",
        "configured_identity",
        "response_claimed_identity",
        "provider_attested_identity",
        "containment_evidence"
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_actions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_actions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "stop_conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "custody_constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "context_constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": [
        "allowed_actions",
        "forbidden_actions",
        "stop_conditions",
        "custody_constraints",
        "context_constraints"
      ]
    },
    "justification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "why_runner": { "type": "string", "minLength": 1 },
        "why_model": { "type": "string", "minLength": 1 },
        "why_effort": { "type": "string", "minLength": 1 },
        "alternatives_considered": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "route": { "type": "string", "minLength": 1 },
              "disposition": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            },
            "required": ["route", "disposition", "reason"]
          }
        },
        "cost_latency_tradeoff": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": [
        "why_runner",
        "why_model",
        "why_effort",
        "alternatives_considered",
        "cost_latency_tradeoff",
        "evidence"
      ]
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "effective_required": { "type": "boolean" },
        "effective_requirement_sources": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "upstream_obligations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_ref": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" }
            },
            "required": ["source_ref", "required"]
          }
        },
        "selected_auditor_binding": { "type": "string", "minLength": 1 }
      },
      "required": [
        "effective_required",
        "effective_requirement_sources",
        "upstream_obligations",
        "selected_auditor_binding"
      ]
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": { "type": "boolean" },
        "trigger": { "type": "string", "minLength": 1 },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runner": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "effort": { "type": "string", "minLength": 1 }
          },
          "required": ["runner", "model", "effort"]
        }
      },
      "required": ["allowed", "trigger", "binding"]
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "legacy_source": { "type": "string", "minLength": 1 },
        "legacy_record": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "required": ["legacy_source", "legacy_record"]
    },
    "runner_version": {
      "type": "string",
      "minLength": 1
    },
    "effort_requested": {
      "type": "string",
      "minLength": 1
    },
    "effort_observed": {
      "type": "string",
      "minLength": 1
    },
    "auth_profile_ref": {
      "type": "string",
      "minLength": 1
    },
    "network_posture": {
      "type": "string",
      "minLength": 1
    },
    "containment_posture": {
      "type": "string",
      "minLength": 1
    },
    "fallback_outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fallback_used": { "type": "boolean" },
        "fallback_reason": { "type": "string", "minLength": 1 }
      },
      "required": ["fallback_used", "fallback_reason"]
    },
    "response_claimed_model": {
      "type": "string",
      "minLength": 1
    },
    "provider_attested_model": {
      "type": "string",
      "minLength": 1
    },
    "independence_class": {
      "$ref": "enums.v1.schema.json#/definitions/independence_class"
    },
    "qualification_receipt_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "macro_id",
    "stage",
    "authority",
    "authority_refs",
    "policy_refs",
    "delivery",
    "selection",
    "constraints",
    "justification",
    "audit",
    "fallback",
    "runner_version",
    "effort_requested",
    "effort_observed",
    "auth_profile_ref",
    "network_posture",
    "containment_posture",
    "fallback_outcome",
    "response_claimed_model",
    "provider_attested_model",
    "independence_class",
    "qualification_receipt_ref"
  ]
}
