{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dopemux.dev/schemas/governed_execution/task_packet.v2.schema.json",
  "title": "Governed Execution Contract v2 - TaskPacket",
  "description": "Superset of docs/03-reference/spec/dopetask/dopetask-canonical-spec.json (untouched predecessor): every v1 field and the v1 required set are retained; new fields are additive and required. authority is const NONE: schema-valid does not imply authority-valid.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "project": { "type": "string" },
    "target": { "type": "string" },
    "invariants": {
      "type": "array",
      "items": { "type": "string" }
    },
    "depends_on": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "repo_binding": {
      "type": "object",
      "properties": {
        "project_id": { "type": "string" },
        "repo_marker": { "type": "string" },
        "origin_hint": { "type": "string" },
        "require_identity_match": { "type": "boolean" }
      },
      "required": ["project_id", "repo_marker", "require_identity_match"],
      "additionalProperties": false
    },
    "series": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "base_branch": { "type": "string" },
        "parent_tp_id": { "type": ["string", "null"] },
        "final_packet": { "type": "boolean" }
      },
      "required": ["id", "base_branch", "parent_tp_id", "final_packet"],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "agent": {
          "$ref": "enums.v1.schema.json#/definitions/execution_agent"
        },
        "branch": { "type": "string" },
        "base_branch": { "type": "string" },
        "stacked_because": { "type": "string" }
      },
      "required": ["agent"],
      "additionalProperties": false
    },
    "commit": {
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "allowlist": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "verify": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["message", "allowlist"],
      "additionalProperties": false
    },
    "pr": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "base": { "type": "string" }
      },
      "required": ["title", "body", "base"],
      "additionalProperties": false
    },
    "pal_chain": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "required": ["enabled", "steps"],
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "task": { "type": "string" },
          "requirements": {
            "type": "array",
            "items": { "type": "string" }
          },
          "commands": {
            "type": "array",
            "items": { "type": "string" }
          },
          "expected_files": {
            "type": "array",
            "items": { "type": "string" }
          },
          "validation": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "context_files": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["id", "task", "validation"],
        "additionalProperties": false
      }
    },
    "schema_version": {
      "const": "dopemux.governed_execution.task_packet.v2"
    },
    "macro_id": { "type": "string", "minLength": 1 },
    "workstream_id": { "type": "string", "minLength": 1 },
    "risk_lane": { "$ref": "enums.v1.schema.json#/definitions/risk_lane" },
    "audit_group": { "type": "string", "minLength": 1 },
    "execution_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_route": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runner": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "effort": { "type": "string", "minLength": 1 }
          },
          "required": ["runner", "model", "effort"]
        },
        "allowed_fallbacks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "runner": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "effort": { "type": "string", "minLength": 1 }
            },
            "required": ["runner", "model", "effort"]
          }
        },
        "binding": { "const": "LIVE_PROOF_REQUIRED" },
        "auditor_independence": {
          "$ref": "enums.v1.schema.json#/definitions/independence_class"
        }
      },
      "required": ["preferred_route", "allowed_fallbacks", "binding", "auditor_independence"]
    },
    "write_surface": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "A literal path or a terminal directory prefix ending in '/'."
      }
    },
    "canonical_writers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "semantic_scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rollback_boundary": { "type": "string", "minLength": 1 },
    "operator_gate_required": { "type": "boolean" },
    "receipt_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "enums.v1.schema.json#/definitions/sha256" }
          },
          "required": ["path", "sha256"]
        },
        "writer_custody": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "enums.v1.schema.json#/definitions/sha256" }
          },
          "required": ["path", "sha256"]
        },
        "freeze": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "enums.v1.schema.json#/definitions/sha256" }
          },
          "required": ["path", "sha256"]
        },
        "finality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "enums.v1.schema.json#/definitions/sha256" }
          },
          "required": ["path", "sha256"]
        }
      }
    },
    "authority": { "const": "NONE" }
  },
  "required": [
    "id",
    "project",
    "target",
    "repo_binding",
    "series",
    "commit",
    "pr",
    "steps",
    "schema_version",
    "macro_id",
    "workstream_id",
    "risk_lane",
    "audit_group",
    "execution_requirements",
    "write_surface",
    "canonical_writers",
    "semantic_scope",
    "rollback_boundary",
    "operator_gate_required",
    "receipt_refs",
    "authority"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "agent": { "const": "gemini" }
            },
            "required": ["agent"]
          }
        },
        "required": ["execution"]
      },
      "then": {
        "required": ["pal_chain"],
        "properties": {
          "pal_chain": {
            "properties": {
              "enabled": { "const": true }
            }
          }
        }
      }
    }
  ]
}
