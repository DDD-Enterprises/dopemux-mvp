{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dopemux.dev/schemas/governed_execution/macro_packet.v2.schema.json",
  "title": "Governed Execution Contract v2 - SupervisorMacroPacket",
  "description": "Additive successor of .control-tower/schemas/supervisor_macro_packet.schema.json (control_tower.supervisor_macro_packet.v1, untouched). Every v1 property is retained with identical type; new fields are additive and required. Scope, not authority: schema-valid does not imply authority-valid.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "dopemux.governed_execution.macro_packet.v2"
    },
    "macro_id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "base_policy": { "type": "string", "minLength": 1 },
    "issued_by": { "const": "control_tower_supervisor" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operator_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "global_allowed_actions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "global_forbidden_actions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "global_stop_conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": [
        "operator_refs",
        "global_allowed_actions",
        "global_forbidden_actions",
        "global_stop_conditions"
      ]
    },
    "execution_authority": { "const": "NONE" },
    "team_lead": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_binding_ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "enums.v1.schema.json#/definitions/sha256" }
          },
          "required": ["path", "sha256"]
        },
        "authority_ceiling": { "type": "string", "minLength": 1 },
        "may_delegate": { "const": true },
        "may_create_canonical_packets": { "const": false },
        "may_merge": { "const": false },
        "may_activate": { "const": false },
        "binding_policy": { "type": "string", "minLength": 1 }
      },
      "required": [
        "execution_binding_ref",
        "authority_ceiling",
        "may_delegate",
        "may_create_canonical_packets",
        "may_merge",
        "may_activate",
        "binding_policy"
      ]
    },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workstream_id": { "type": "string", "minLength": 1 },
          "task_packet_ref": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "enums.v1.schema.json#/definitions/sha256" }
            },
            "required": ["path", "sha256"]
          },
          "objective": { "type": "string", "minLength": 1 },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "parallel_group": { "type": "string", "minLength": 1 },
          "mutating": { "type": "boolean" },
          "write_surface": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "canonical_writers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semantic_scope": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "allowed_actions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "forbidden_actions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "rollback_boundary": { "type": "string", "minLength": 1 },
          "delivery_risk_lane": { "$ref": "enums.v1.schema.json#/definitions/risk_lane" },
          "dcp_route_ref": { "type": "string", "minLength": 1 },
          "dcp_status": { "$ref": "enums.v1.schema.json#/definitions/dcp_status" },
          "dcp_risk_class": { "$ref": "enums.v1.schema.json#/definitions/dcp_risk_class" },
          "task_orchestrator_ref": { "type": "string", "minLength": 1 },
          "execution_route": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "preferred": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "runner": { "type": "string", "minLength": 1 },
                  "model": { "type": "string", "minLength": 1 },
                  "effort": { "type": "string", "minLength": 1 }
                },
                "required": ["runner", "model", "effort"]
              },
              "allowed_fallbacks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "runner": { "type": "string", "minLength": 1 },
                    "model": { "type": "string", "minLength": 1 },
                    "effort": { "type": "string", "minLength": 1 }
                  },
                  "required": ["runner", "model", "effort"]
                }
              }
            },
            "required": ["preferred", "allowed_fallbacks"]
          },
          "audit": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "required": { "type": "boolean" },
              "final_subject": { "type": "string", "minLength": 1 }
            },
            "required": ["required", "final_subject"]
          },
          "return_fields": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "audit_group": { "type": "string", "minLength": 1 },
          "return_contract": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "workstream_id",
          "task_packet_ref",
          "objective",
          "dependencies",
          "parallel_group",
          "mutating",
          "write_surface",
          "canonical_writers",
          "semantic_scope",
          "allowed_actions",
          "forbidden_actions",
          "rollback_boundary",
          "delivery_risk_lane",
          "dcp_route_ref",
          "dcp_status",
          "dcp_risk_class",
          "task_orchestrator_ref",
          "execution_route",
          "audit",
          "return_fields",
          "audit_group",
          "return_contract"
        ]
      }
    },
    "joins": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "join_id": { "type": "string", "minLength": 1 },
              "requires": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "condition": { "type": "string", "minLength": 1 },
              "join_type": {
                "allOf": [
                  { "$ref": "enums.v1.schema.json#/definitions/join_type" },
                  { "const": "QUORUM" }
                ]
              },
              "quorum": { "type": "integer", "minimum": 1 }
            },
            "required": ["join_id", "requires", "condition", "join_type", "quorum"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "join_id": { "type": "string", "minLength": 1 },
              "requires": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "condition": { "type": "string", "minLength": 1 },
              "join_type": {
                "allOf": [
                  { "$ref": "enums.v1.schema.json#/definitions/join_type" },
                  { "not": { "const": "QUORUM" } }
                ]
              }
            },
            "required": ["join_id", "requires", "condition", "join_type"]
          }
        ]
      }
    },
    "parallelism": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_mutating_workstreams": { "type": "integer" },
        "one_mutating_implementer_per_workstream": { "const": true },
        "overlap_policy": { "const": "fail_closed" }
      },
      "required": [
        "max_mutating_workstreams",
        "one_mutating_implementer_per_workstream",
        "overlap_policy"
      ]
    },
    "evidence_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intermediate_model_audits": { "const": 0 },
        "final_audit_policy": { "type": "string", "minLength": 1 },
        "proof_transport": { "type": "string", "minLength": 1 }
      },
      "required": ["intermediate_model_audits", "final_audit_policy", "proof_transport"]
    },
    "return_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aggregate_return_required": { "const": true },
        "immediate_return_triggers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["aggregate_return_required", "immediate_return_triggers"]
    }
  },
  "required": [
    "schema_version",
    "macro_id",
    "objective",
    "repository",
    "base_policy",
    "issued_by",
    "authority",
    "execution_authority",
    "team_lead",
    "workstreams",
    "joins",
    "parallelism",
    "evidence_budget",
    "return_contract"
  ]
}
