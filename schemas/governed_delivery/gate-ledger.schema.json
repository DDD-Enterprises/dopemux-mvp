{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dopemux.dev/schemas/governed_delivery/gate-ledger.v1.schema.json",
  "title": "GateLedger v1",
  "description": "Derived projection of gate satisfaction against an exact subject. SATISFIED records that a gate's evidence is present and current; it never confers execution, merge or activation authority. UNKNOWN and CONFLICTING fail closed for consequential next actions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_id", "project_id", "repository_id", "subject_digest_or_head", "gates"],
  "properties": {
    "schema_version": { "type": "string", "const": "governed-delivery.gate-ledger.v1" },
    "ledger_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "repository_id": { "type": "string", "minLength": 1 },
    "subject_digest_or_head": { "type": "string", "minLength": 1 },
    "gates": { "type": "array", "items": { "$ref": "#/definitions/gate_entry" } }
  },
  "definitions": {
    "gate_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id", "gate_class", "state", "policy_owner", "policy_version",
        "evidence_refs", "subject_digest_or_head", "producer_identity",
        "observed_at", "blocking_actions", "reason"
      ],
      "properties": {
        "gate_id": { "type": "string", "minLength": 1 },
        "gate_class": {
          "type": "string",
          "description": "Gate classes enumerated by DMX-GOV-WORKFLOW-OPT-001 section 05.",
          "enum": [
            "IDENTITY", "AUTHORITY", "PACKET", "SCOPE", "VALIDATION", "FREEZE",
            "AUDIT", "PROOF", "PR", "CI", "REVIEW", "PR_STEWARD",
            "MERGE_AUTHORITY", "POST_MERGE", "ACTIVATION"
          ]
        },
        "state": {
          "type": "string",
          "enum": ["NOT_APPLICABLE", "PENDING", "SATISFIED", "UNSATISFIED", "STALE", "BLOCKED", "UNKNOWN", "CONFLICTING"]
        },
        "policy_owner": { "type": "string", "minLength": 1 },
        "policy_version": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "https://dopemux.dev/schemas/governed_delivery/evidence-reference.v1.schema.json" }
        },
        "subject_digest_or_head": { "type": "string", "minLength": 1 },
        "producer_identity": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string" },
        "valid_until": { "type": ["string", "null"] },
        "blocking_actions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Actions this gate blocks while unsatisfied. Absence of a blocked action is not permission to act."
        },
        "reason": {
          "type": "string",
          "description": "Why the gate holds this state. Required even for SATISFIED so the ledger is never a bare boolean."
        }
      }
    }
  }
}
