{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dopemux.local/dcp_extension/proof_family.schema.json",
  "title": "DCP Proof Family Projection Mapping",
  "description": "Projection-only mapping from Dopemux proof roots to PCP proof pointers. This extension schema does not own generic PCP proof semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extension_id",
    "project_id",
    "proof_family_id",
    "pcp_proof_pointer_schema",
    "proof_roots",
    "artifact_manifest_paths",
    "head_sha_binding_required",
    "freshness_values",
    "unknown_behavior",
    "source_truth_refs",
    "must_not_own",
    "is_authority",
    "projection_only",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "dcp.proof_family.v0"
    },
    "extension_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "proof_family_id": {
      "type": "string",
      "minLength": 1
    },
    "pcp_proof_pointer_schema": {
      "type": "string",
      "minLength": 1
    },
    "proof_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact_manifest_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "head_sha_binding_required": {
      "type": "boolean",
      "const": true
    },
    "freshness_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["FRESH", "STALE", "MISSING", "UNKNOWN"]
      }
    },
    "unknown_behavior": {
      "type": "string",
      "const": "BLOCK_OR_ESCALATE"
    },
    "source_truth_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "must_not_own": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "is_authority": {
      "type": "boolean",
      "const": false
    },
    "projection_only": {
      "type": "boolean",
      "const": true
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_check_required", "negative_fixture_required"],
      "properties": {
        "schema_check_required": { "type": "boolean", "const": true },
        "negative_fixture_required": { "type": "boolean", "const": true }
      }
    }
  }
}