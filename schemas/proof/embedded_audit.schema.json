{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Embedded Audit Proof Object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "required",
    "status",
    "auditor_tool",
    "auditor_model",
    "invocation",
    "exit_code",
    "report_path",
    "findings",
    "fixes_applied",
    "remaining_risks",
    "skip_reason"
  ],
  "properties": {
    "required": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "PASS_WITH_RISKS",
        "FAIL",
        "NEEDS_SUPERVISOR",
        "SKIPPED"
      ]
    },
    "auditor_tool": {
      "type": "string",
      "enum": [
        "agy",
        "antigravity",
        "claude-code-cli",
        "copilot-cli",
        "gemini-cli",
        "pal-mcp-clink",
        "none"
      ]
    },
    "auditor_model": {
      "type": "string",
      "enum": [
        "sonnet",
        "claude-sonnet-4.6",
        "opus",
        "gemini",
        "gemini-3.1-pro-high",
        "unknown"
      ]
    },
    "invocation": {
      "type": [
        "string",
        "null"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "report_path": {
      "type": "string",
      "pattern": "^proof/[^/]+/AUDITOR(_REPAIR(_[0-9]+)?)?_REPORT\\.md$"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/finding"
      }
    },
    "fixes_applied": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remaining_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skip_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "instruction_like_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detected",
        "match_count",
        "truncated",
        "matches"
      ],
      "properties": {
        "detected": {
          "type": "boolean"
        },
        "match_count": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "text_sha256"
            ],
            "properties": {
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "category": {
                "type": "string",
                "enum": [
                  "IGNORE_OR_OVERRIDE_INSTRUCTION",
                  "FORCED_VERDICT_REQUEST",
                  "ROLE_OR_SYSTEM_PROMPT_CLAIM",
                  "OUTPUT_CONTRACT_OVERRIDE",
                  "SUPPRESS_FINDINGS_REQUEST",
                  "FAKE_AUDIT_RESULT"
                ]
              },
              "text_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "diff_side": {
                "description": "Which model-visible candidate coordinate produced the match.",
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "ADDED",
                      "DELETED",
                      "METADATA"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "description": "Deterministic scanner evidence for instruction-like candidate content. Matches store hashes only (no raw candidate text). Detection is evidence, not automatic failure."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SKIPPED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "auditor_tool": {
            "const": "none"
          },
          "auditor_model": {
            "const": "unknown"
          },
          "invocation": {
            "type": "null"
          },
          "exit_code": {
            "type": "null"
          },
          "skip_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "status": {
              "const": "SKIPPED"
            }
          },
          "required": [
            "status"
          ]
        }
      },
      "then": {
        "properties": {
          "auditor_tool": {
            "type": "string",
            "not": {
              "const": "none"
            }
          },
          "auditor_model": {
            "type": "string",
            "not": {
              "const": "unknown"
            }
          },
          "invocation": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "skip_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "auditor_model": {
            "const": "gemini-3.1-pro-high"
          }
        },
        "required": [
          "auditor_model"
        ]
      },
      "then": {
        "properties": {
          "auditor_tool": {
            "const": "agy"
          }
        }
      }
    }
  ],
  "definitions": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "title",
        "status",
        "body"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "BLOCKING",
            "HIGH",
            "MEDIUM",
            "LOW",
            "INFO"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "OPEN",
            "RESOLVED",
            "ACCEPTED_RISK"
          ]
        },
        "body": {
          "type": "string"
        }
      }
    }
  }
}
