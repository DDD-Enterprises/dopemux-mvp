{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dopemux.dev/schemas/supervisor/project-mandate.v1.schema.json",
  "title": "Trusted local project mandate v1",
  "description": "Shape only. Runtime checks authorization, current expiry, graph, physical paths, executable and source/output identity. No native MacroPacket or ExecutionBinding registration is implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mandate_id",
    "issuer_ref",
    "project_id",
    "project_root",
    "expires_at",
    "active_seconds",
    "spend_limit_micros",
    "max_parallel",
    "repair_limit",
    "stop_conditions",
    "gates",
    "route",
    "steps",
    "success_steps"
  ],
  "properties": {
    "schema_version": {
      "const": "dopemux.project_mandate.v1"
    },
    "mandate_id": {
      "$ref": "#/$defs/id"
    },
    "issuer_ref": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "project_root": {
      "type": "string",
      "pattern": "^/"
    },
    "expires_at": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "active_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "spend_limit_micros": {
      "const": 0
    },
    "max_parallel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "repair_limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "security",
        "workflow",
        "spending"
      ],
      "properties": {
        "security": {
          "const": "PASS"
        },
        "workflow": {
          "const": "PASS"
        },
        "spending": {
          "const": "PASS"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "kind",
        "model_class",
        "executable",
        "valid_until"
      ],
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "local_command"
        },
        "model_class": {
          "const": "deterministic"
        },
        "executable": {
          "type": "string",
          "pattern": "^/"
        },
        "valid_until": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "kind",
          "argv",
          "effects",
          "write_paths",
          "depends_on",
          "timeout_seconds",
          "heavy"
        ],
        "properties": {
          "step_id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "implementation",
              "test",
              "validation",
              "repair"
            ]
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "effects": {
            "type": "array",
            "items": {
              "enum": [
                "read",
                "write",
                "test"
              ]
            },
            "uniqueItems": true
          },
          "write_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "heavy": {
            "type": "boolean"
          },
          "when_failed": {
            "$ref": "#/$defs/id"
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "capture_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          }
        }
      }
    },
    "success_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    }
  }
}
