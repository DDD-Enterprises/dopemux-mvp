{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/DDD-Enterprises/dopemux-mvp/schemas/dcp/dcp_routing_proof_extension.schema.json",
  "title": "DcpRoutingProofExtension",
  "description": "Additive proof extension for routing decisions (NOT replacement of existing proof families)",
  "type": "object",
  "additionalProperties": false,
  "required": ["extension_id", "classification", "routing_decision", "execution_lane", "model_slot", "backend", "runner_invocation", "audit_route", "operator_approval", "red_lane_flags", "stop_conditions"],
  "properties": {
    "extension_id": {
      "type": "string",
      "pattern": "^DCP-PROOF-[0-9A-Z]{6}$",
      "description": "Unique proof extension identifier"
    },
    "classification": {
      "$ref": "dcp_routing_classification.schema.json",
      "description": "Classification snapshot"
    },
    "routing_decision": {
      "$ref": "dcp_routing_decision.schema.json",
      "description": "Decision snapshot"
    },
    "execution_lane": {
      "$ref": "dcp_execution_lane.schema.json",
      "description": "Lane snapshot"
    },
    "model_slot": {
      "$ref": "dcp_model_slot.schema.json",
      "description": "Model slot evidence snapshot"
    },
    "backend": {
      "$ref": "dcp_backend_runner.schema.json",
      "description": "Backend runner snapshot"
    },
    "runner_invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "model", "authority"],
      "properties": {
        "tool": {
          "type": "string",
          "enum": ["opencode", "claude_code", "gemini_cli", "codex_cli", "validation_tool", "none"],
          "description": "Implementation tool used"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Model used (e.g., grok-4.3)"
        },
        "authority": {
          "type": "string",
          "enum": ["backend_only", "validation_only", "read_only", "adapter", "advisory", "forbidden", "unknown"],
          "description": "Authority posture of runner"
        }
      },
      "description": "Runner invocation record"
    },
    "audit_route": {
      "$ref": "dcp_audit_route.schema.json",
      "description": "Audit route snapshot"
    },
    "operator_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "approver", "timestamp"],
      "properties": {
        "approved": {
          "type": "boolean",
          "description": "Whether operator approval was granted"
        },
        "approver": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Approver identity or reference"
        },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "description": "ISO8601 approval timestamp"
        }
      },
      "description": "Operator approval record"
    },
    "red_lane_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Red lane flags that must be addressed"
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "$ref": "dcp_stop_condition.schema.json"
      },
      "description": "Stop conditions active for this proof extension"
    }
  }
}
