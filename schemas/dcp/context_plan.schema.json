{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dopemux.dev/schemas/dcp/context_plan.schema.json",
  "title": "DCP Context Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "project_id",
    "authority_order",
    "capability_requirement_refs",
    "mandatory_evidence_refs",
    "context_budget",
    "retrieval_policy",
    "state",
    "execution_authority",
    "mutation_authority"
  ],
  "properties": {
    "schema_version": {"const": "dcp-context-plan.v0"},
    "plan_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "authority_order": {
      "const": ["RUNTIME_SOURCE", "ACCEPTED_AUTHORITY", "DERIVED_EVIDENCE"]
    },
    "capability_requirement_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "mandatory_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "context_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_bytes", "mandatory_evidence_truncation_allowed"],
      "properties": {
        "max_bytes": {"type": "integer", "minimum": 1},
        "mandatory_evidence_truncation_allowed": {"const": false}
      }
    },
    "retrieval_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dereference_required", "advisory_results_are_authority"],
      "properties": {
        "dereference_required": {"const": true},
        "advisory_results_are_authority": {"const": false}
      }
    },
    "state": {"enum": ["PLANNED", "BLOCKED"]},
    "execution_authority": {"const": false},
    "mutation_authority": {"const": false}
  }
}
