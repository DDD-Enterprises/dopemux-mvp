{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frozen.dopemux.local/TP-UAG-C0-DCP-UAG-DOPETASK-AUTHORITY-INTERFACE-FREEZE-001-R2/schemas/model_transport_receipt.schema.json",
  "title": "ModelTransportReceipt",
  "description": "Final UAG model-transport receipt. Identity stages remain separate. policy_resolved_identity and uag_resolved_identity MUST NOT be collapsed. tool_execution_authority is NONE. exactly_once_claim is FORBIDDEN.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "logical_request_id",
    "attempt_ids",
    "authorization_ref",
    "compatibility_profile_ref",
    "requested_identity",
    "configured_identity",
    "policy_resolved_identity",
    "uag_resolved_identity",
    "attempted_identity",
    "gateway_reported_identity",
    "proxy_reported_identity",
    "provider_reported_identity",
    "provider_attested_identity",
    "terminal_stream_state",
    "unknowns",
    "conflicts",
    "tool_execution_authority",
    "exactly_once_claim",
    "provider_internal_retries",
    "private_state_retained",
    "private_state_replay_scope",
    "cross_restart_private_state_replay"
  ],
  "properties": {
    "schema_version": {
      "const": "dopemux-model-transport-receipt.v1"
    },
    "logical_request_id": {
      "$ref": "common_defs.schema.json#/definitions/nonempty"
    },
    "attempt_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common_defs.schema.json#/definitions/nonempty"
      }
    },
    "session_binding_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "authorization_ref": {
      "$ref": "common_defs.schema.json#/definitions/digestRef"
    },
    "compatibility_profile_ref": {
      "$ref": "common_defs.schema.json#/definitions/nonempty"
    },
    "requested_identity": {
      "allOf": [
        {
          "$ref": "common_defs.schema.json#/definitions/identityStage"
        },
        {
          "properties": {
            "stage": {
              "const": "requested"
            }
          },
          "required": [
            "stage"
          ]
        }
      ]
    },
    "configured_identity": {
      "allOf": [
        {
          "$ref": "common_defs.schema.json#/definitions/identityStage"
        },
        {
          "properties": {
            "stage": {
              "const": "configured"
            }
          },
          "required": [
            "stage"
          ]
        }
      ]
    },
    "policy_resolved_identity": {
      "allOf": [
        {
          "$ref": "common_defs.schema.json#/definitions/identityStage"
        },
        {
          "properties": {
            "stage": {
              "const": "policy_resolved"
            }
          },
          "required": [
            "stage"
          ]
        }
      ]
    },
    "uag_resolved_identity": {
      "allOf": [
        {
          "$ref": "common_defs.schema.json#/definitions/identityStage"
        },
        {
          "properties": {
            "stage": {
              "const": "uag_resolved"
            }
          },
          "required": [
            "stage"
          ]
        }
      ]
    },
    "attempted_identity": {
      "allOf": [
        {
          "$ref": "common_defs.schema.json#/definitions/identityStage"
        },
        {
          "properties": {
            "stage": {
              "const": "attempted"
            }
          },
          "required": [
            "stage"
          ]
        }
      ]
    },
    "gateway_reported_identity": {
      "allOf": [
        {
          "$ref": "common_defs.schema.json#/definitions/identityStage"
        },
        {
          "properties": {
            "stage": {
              "const": "gateway_reported"
            }
          },
          "required": [
            "stage"
          ]
        }
      ]
    },
    "proxy_reported_identity": {
      "allOf": [
        {
          "$ref": "common_defs.schema.json#/definitions/identityStage"
        },
        {
          "properties": {
            "stage": {
              "const": "proxy_reported"
            }
          },
          "required": [
            "stage"
          ]
        }
      ]
    },
    "provider_reported_identity": {
      "allOf": [
        {
          "$ref": "common_defs.schema.json#/definitions/identityStage"
        },
        {
          "properties": {
            "stage": {
              "const": "provider_reported"
            }
          },
          "required": [
            "stage"
          ]
        }
      ]
    },
    "provider_attested_identity": {
      "$ref": "common_defs.schema.json#/definitions/providerAttestedIdentityStage"
    },
    "provider_request_ids": {
      "type": "array",
      "items": {
        "$ref": "common_defs.schema.json#/definitions/nonempty"
      }
    },
    "terminal_stream_state": {
      "$ref": "common_defs.schema.json#/definitions/nonempty"
    },
    "retry_and_fallback_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id",
          "semantic_state"
        ],
        "properties": {
          "attempt_id": {
            "$ref": "common_defs.schema.json#/definitions/nonempty"
          },
          "semantic_state": {
            "$ref": "common_defs.schema.json#/definitions/attemptSemanticState"
          },
          "provider_non_acceptance_evidence_ref": {
            "$ref": "common_defs.schema.json#/definitions/providerNonAcceptanceEvidenceRef"
          },
          "notes": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "semantic_state"
              ],
              "properties": {
                "semantic_state": {
                  "const": "NON_ACCEPTANCE_PROVEN"
                }
              }
            },
            "then": {
              "required": [
                "provider_non_acceptance_evidence_ref"
              ]
            }
          },
          {
            "if": {
              "required": [
                "provider_non_acceptance_evidence_ref"
              ]
            },
            "then": {
              "required": [
                "semantic_state"
              ],
              "properties": {
                "semantic_state": {
                  "const": "NON_ACCEPTANCE_PROVEN"
                }
              }
            }
          }
        ]
      }
    },
    "request_ledger_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "Reference to the UAGRequestLedger entry for this logical request. Correlation and context evidence only. It proves what UAG sent and observed; it never proves provider non-acceptance and is never sufficient for NON_ACCEPTANCE_PROVEN."
    },
    "provider_non_acceptance_evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "common_defs.schema.json#/definitions/providerNonAcceptanceEvidenceRef"
      },
      "description": "Receipt-level roll-up of every provider non-acceptance evidence reference cited by retry_and_fallback_history. CCI-009 requires completeness of this roll-up."
    },
    "tool_projection_ledger_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "usage_evidence": {
      "type": [
        "object",
        "null"
      ]
    },
    "cost_evidence": {
      "type": [
        "object",
        "null"
      ]
    },
    "semantic_loss_report": {
      "$ref": "common_defs.schema.json#/definitions/semanticLossReport"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "common_defs.schema.json#/definitions/unknownItem"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "common_defs.schema.json#/definitions/conflictItem"
      }
    },
    "private_state_retained": {
      "type": "boolean"
    },
    "private_state_replay_scope": {
      "$ref": "common_defs.schema.json#/definitions/privateStateReplayScope"
    },
    "tool_execution_authority": {
      "$ref": "common_defs.schema.json#/definitions/noneExecutionAuthority"
    },
    "exactly_once_claim": {
      "$ref": "common_defs.schema.json#/definitions/exactlyOnceClaim"
    },
    "provider_internal_retries": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "INDEPENDENTLY_EVIDENCED"
      ]
    },
    "resolved_identity": {
      "description": "FORBIDDEN collapsed field. Must not be present."
    },
    "cross_restart_private_state_replay": {
      "$ref": "common_defs.schema.json#/definitions/crossRestartPrivateStateReplay"
    }
  },
  "not": {
    "required": [
      "resolved_identity"
    ]
  }
}
