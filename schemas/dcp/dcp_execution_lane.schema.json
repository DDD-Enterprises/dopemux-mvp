{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/DDD-Enterprises/dopemux-mvp/schemas/dcp/dcp_execution_lane.schema.json",
  "title": "DcpExecutionLane",
  "description": "Execution lane definition with backend authority constraints",
  "type": "object",
  "additionalProperties": false,
  "required": ["lane_id", "lane_name", "backend_authority", "allowed_risk_classes"],
  "properties": {
    "lane_id": {
      "type": "string",
      "pattern": "^DCP-LANE-[0-9A-Z]{6}$",
      "description": "Unique lane identifier"
    },
    "lane_name": {
      "type": "string",
      "enum": ["design_only", "dry_run", "read_only", "test_only", "implementation", "cross_boundary", "security_auth_ci", "live_write", "forbidden"],
      "description": "Human-readable lane name"
    },
    "backend_authority": {
      "type": "string",
      "enum": ["backend_only", "validation_only", "read_only", "adapter", "advisory", "forbidden", "unknown"],
      "description": "Backend authority level for this lane"
    },
    "allowed_risk_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["R0_READ", "R1_DOCS", "R2_TESTS", "R3_CODE", "R4_CROSS_BOUNDARY", "R5_SECURITY_AUTH_CI", "R6_LIVE_WRITE", "R7_FORBIDDEN"]
      },
      "minItems": 1,
      "description": "Risk classes permitted in this lane"
    },
    "model_slot_evidence_required": {
      "type": "boolean",
      "description": "Whether model slot evidence is required for this lane"
    }
  }
}
