{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LTAIP Task Orchestrator REST Epic Load",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_runtime",
    "endpoint",
    "root_epic",
    "epics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source_runtime": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    },
    "root_epic": {
      "$ref": "#/definitions/entry"
    },
    "epics": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/definitions/entry"
      }
    }
  },
  "definitions": {
    "adhd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimated_complexity",
        "required_energy_level",
        "can_work_parallel"
      ],
      "properties": {
        "estimated_complexity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "required_energy_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "can_work_parallel": {
          "type": "boolean"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "business_value",
        "acceptance_criteria",
        "priority",
        "status",
        "tags",
        "adhd_metadata",
        "idempotency_key"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "business_value": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "in-planning",
            "ready",
            "in-progress",
            "done"
          ]
        },
        "created_from_idea_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adhd_metadata": {
          "$ref": "#/definitions/adhd"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_ref",
        "packet_id",
        "stage08_epic_id",
        "depends_on",
        "load_status",
        "request"
      ],
      "properties": {
        "client_ref": {
          "type": "string"
        },
        "packet_id": {
          "type": "string"
        },
        "stage08_epic_id": {
          "type": "string"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "load_status": {
          "enum": [
            "READY",
            "BLOCKED",
            "CONDITIONAL"
          ]
        },
        "request": {
          "$ref": "#/definitions/request"
        }
      }
    }
  }
}
