{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PR Steward Review Quiescence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "repository",
    "pr_number",
    "head_sha",
    "verdict",
    "is_quiescent",
    "blocking_reasons",
    "unresolved_thread_count",
    "unresolved_blocking_thread_count",
    "producers",
    "evidence_references",
    "mutation_performed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "QUIESCENT",
        "NEEDS_IMPLEMENTER",
        "BLOCKED",
        "UNKNOWN"
      ]
    },
    "is_quiescent": {
      "type": "boolean"
    },
    "blocking_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_thread_count": {
      "type": "integer",
      "minimum": 0
    },
    "unresolved_blocking_thread_count": {
      "type": "integer",
      "minimum": 0
    },
    "producers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/producer_status"
      }
    },
    "evidence_references": {
      "type": "object",
      "additionalProperties": true
    },
    "mutation_performed": {
      "type": "boolean",
      "const": false
    }
  },
  "definitions": {
    "producer_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_id",
        "mandatory",
        "status",
        "strategy_used",
        "evidence"
      ],
      "properties": {
        "producer_id": {
          "type": "string"
        },
        "mandatory": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "COMPLETED",
            "PENDING",
            "MISSING",
            "STALE",
            "FAILED",
            "NOT_REQUIRED",
            "UNKNOWN"
          ]
        },
        "strategy_used": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      }
    }
  }
}
