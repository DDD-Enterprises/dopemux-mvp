{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dopemux.dev/schemas/audit_broker/auditor_certification.schema.json",
  "title": "Audit Broker Auditor Certification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "certification_id",
    "request_ref",
    "snapshot_ref",
    "subject",
    "capability_requirement_refs",
    "subject_scope",
    "snapshot_freshness",
    "capability_state",
    "identity_alignment",
    "independence",
    "judgment_authorized",
    "repository_mutation_authorized",
    "task_mutation_authorized"
  ],
  "properties": {
    "schema_version": {"const": "audit-broker-auditor-certification.v0"},
    "certification_id": {"type": "string", "minLength": 1},
    "request_ref": {"type": "string", "minLength": 1},
    "snapshot_ref": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "head_sha", "tree_sha", "digest"],
      "properties": {
        "packet_id": {"type": "string", "minLength": 1},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "capability_requirement_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "subject_scope": {"const": "AUDIT_ONLY"},
    "snapshot_freshness": {"const": "CURRENT"},
    "capability_state": {"const": "SATISFIED"},
    "identity_alignment": {"const": "MATCHED"},
    "independence": {"const": "VERIFIED"},
    "judgment_authorized": {"const": true},
    "repository_mutation_authorized": {"const": false},
    "task_mutation_authorized": {"const": false}
  }
}
