{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dopemux.dev/schemas/audit_broker/audit_request.schema.json",
  "title": "Audit Broker Audit Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "subject",
    "required_capabilities",
    "requested_identity",
    "substitution_allowed",
    "certification_ref",
    "mandatory_evidence_refs",
    "repository_mutation_authorized",
    "task_mutation_authorized"
  ],
  "properties": {
    "schema_version": {"const": "audit-broker-audit-request.v0"},
    "request_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "head_sha", "digest"],
      "properties": {
        "packet_id": {"type": "string", "minLength": 1},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "requested_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1}
      }
    },
    "substitution_allowed": {"const": false},
    "certification_ref": {"type": "string", "minLength": 1},
    "mandatory_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "repository_mutation_authorized": {"const": false},
    "task_mutation_authorized": {"const": false}
  }
}
