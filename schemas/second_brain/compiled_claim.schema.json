{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dopemux.dev/schemas/second_brain/compiled_claim.schema.json",
  "title": "Second Brain Compiled Claim",
  "$comment": "eligible_for_materialization input_ref resolution and provider-policy eligibility are enforced by JSON_SCHEMA + scripts/governance/validate_dcp_p0_contract_semantics.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "input_ref",
    "claim_text",
    "source_refs",
    "source_dereferenced",
    "contradiction_state",
    "authority_label",
    "eligible_for_materialization"
  ],
  "properties": {
    "schema_version": {"const": "sb-compiled-claim.v0"},
    "claim_id": {"type": "string", "minLength": 1},
    "input_ref": {"type": "string", "minLength": 1},
    "claim_text": {"type": "string", "minLength": 1},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_dereferenced": {"type": "boolean"},
    "contradiction_state": {"enum": ["NONE", "PRESENT", "UNKNOWN"]},
    "authority_label": {"const": "DERIVED_NON_CANONICAL"},
    "eligible_for_materialization": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"eligible_for_materialization": {"const": true}}},
      "then": {
        "properties": {
          "source_dereferenced": {"const": true},
          "contradiction_state": {"const": "NONE"}
        }
      }
    }
  ]
}
