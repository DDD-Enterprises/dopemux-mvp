{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dopemux.local/schemas/mcp/fleet-catalog-v2.schema.json",
  "title": "Dopemux MCP Fleet Catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "servers"],
  "properties": {
    "version": {
      "const": 2
    },
    "defaults": {
      "type": "object"
    },
    "profiles": {
      "type": "object"
    },
    "servers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sharing_class",
          "target_class",
          "transport",
          "plane",
          "authority_role",
          "lifecycle",
          "management_model",
          "identity_scope",
          "state_authority",
          "mutation_class",
          "endpoint_policy",
          "probe",
          "idle_policy",
          "flip_gate"
        ],
        "properties": {
          "sharing_class": { "type": "string" },
          "target_class": { "type": "string" },
          "transport": { "type": "string" },
          "plane": { "type": "string" },
          "authority_role": { "type": "string" },
          "lifecycle": { "type": "string" },
          "management_model": { "type": "string" },
          "identity_scope": { "type": "string" },
          "state_authority": { "type": "string" },
          "mutation_class": { "type": "string" },
          "endpoint_policy": { "type": "string" },
          "probe": { "type": "string" },
          "idle_policy": { "type": "string" },
          "flip_gate": {
            "type": "array",
            "items": { "type": "string" }
          },
          "agents": { "type": ["string", "object"] },
          "workflows": { "type": "array" },
          "tools": { "type": "object" },
          "admin_tools": { "type": "array" },
          "aux_surfaces": { "type": "array" },
          "managed": { "type": "boolean" },
          "url": { "type": "string" },
          "url_template": { "type": "string" },
          "port_var": { "type": "string" },
          "default_port_base": { "type": "integer" },
          "reserved_port": { "type": "integer" },
          "extra_port_vars": { "type": "array" },
          "docker_compose_service": { "type": "string" },
          "command": { "type": "string" },
          "args": { "type": "array" },
          "requires_env": { "type": "array" },
          "optional_env": { "type": "array" },
          "doctor_args": { "type": "array" },
          "env_template": { "type": "object" },
          "description": { "type": "string" },
          "tool_aliases": { "type": "array" }
        }
      }
    }
  }
}
