{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dopemux.local/schemas/mcp/fleet-catalog.schema.json",
  "title": "Dopemux MCP Fleet Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaults", "servers"],
  "properties": {
    "version": {
      "const": 1
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_worktree"],
      "properties": {
        "per_worktree": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "profiles": {
      "description": "Named MCP exposure profiles (ADR-DMX-MCPPROF-001). Values match schemas/mcp-profile.schema.json. No implicit `all` profile.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "not": {
          "enum": ["all", "*", "any", "full", "everything"]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "servers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/server"
      }
    }
  },
  "$defs": {
    "profile": {
      "description": "MCP exposure profile (ADR-DMX-MCPPROF-001). Keep in sync with schemas/mcp-profile.schema.json.",
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "servers"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "intended_use": {
          "type": "string",
          "minLength": 1
        },
        "servers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "const": "all"
            }
          }
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read_only": {
              "type": "boolean",
              "const": true
            },
            "toolsets": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "repos",
                  "issues",
                  "pull_requests",
                  "code_security",
                  "secret_protection",
                  "dependabot",
                  "actions",
                  "discussions",
                  "notifications",
                  "users",
                  "orgs",
                  "context"
                ]
              }
            }
          }
        },
        "tool_exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tool_include": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "admin": {
          "type": "boolean",
          "default": false
        },
        "inventory_baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visible_tool_count"],
          "properties": {
            "visible_tool_count": {
              "type": "integer",
              "minimum": 0
            },
            "rationale": {
              "type": "string"
            }
          }
        }
      }
    },
    "envVar": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "agentExposure": {
      "description": "Per-agent exposure of this server (ADR-MCPINT-001/-002). `full` = direct config; `full-sequenced` = full parity gated on ADR-MCPINT-002 preconditions (IDENTITY-005 + actor-auth); `read-plane` = read-only via the universal read plane (dcp-readonly-facade projection and/or read-safe direct config) once deployed; `facade` = remote facade access per ADR-DCP-MCP-RO-0009; `none` = no exposure.",
      "enum": ["full", "full-sequenced", "read-plane", "facade", "none"]
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "transport"],
      "properties": {
        "scope": {
          "enum": ["singleton", "per-worktree"]
        },
        "state_scope": {
          "enum": ["per-repo", "per-worktree", "single_active_project", "multi_project_singleton"]
        },
        "transport": {
          "enum": ["http", "sse", "stdio", "external"]
        },
        "plane": {
          "enum": [
            "automation",
            "code-intelligence",
            "dcp-read",
            "domain-read",
            "gateway",
            "memory",
            "pm",
            "reasoning",
            "research",
            "retrieval",
            "security",
            "vcs",
            "workflow"
          ]
        },
        "authority_role": {
          "enum": [
            "browser-inspection",
            "chronicle-authority",
            "code-intelligence",
            "connector-discovery",
            "deep-research",
            "desktop-automation",
            "docker-gateway",
            "docs-lookup",
            "domain-read-facade",
            "github-read",
            "pm-adapter",
            "read-plane-projection",
            "reasoning-infrastructure",
            "retrieval-projection",
            "security-scan",
            "structured-context-authority",
            "task-scheduler",
            "web-search",
            "workflow-authority"
          ]
        },
        "lifecycle": {
          "enum": ["active", "decision-required", "operator-managed", "planned-active"]
        },
        "management_model": {
          "enum": [
            "compose-service",
            "docker-exec",
            "docker-mcp-gateway",
            "external",
            "operator-managed",
            "repo-local",
            "wrapper-singleton"
          ]
        },
        "identity_scope": {
          "enum": [
            "external-provider",
            "host-session",
            "per-call-workspace",
            "per-repo",
            "per-worktree",
            "singleton"
          ]
        },
        "follow_on_decision": {
          "enum": ["delete-or-host-run", "none", "wire-or-retire"]
        },
        "port_policy": {
          "enum": ["reserved_singleton"]
        },
        "managed": {
          "description": "false = host-level external surface documented for completeness; the repo does not manage its transport, lifecycle, or config (ADR-MCPINT-001 §4).",
          "type": "boolean"
        },
        "agents": {
          "description": "Per-agent exposure matrix (ADR-MCPINT-001 catalog v2). The string `none` means this server has no agent matrix row (infra/PM-sync entries). Rendering is owned by MCPINT-FND-CODEGEN-005; ADR-MCPINT-002 is the policy constraining when the generator may honor a row.",
          "oneOf": [
            {
              "type": "string",
              "const": "none"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "claude": {
                  "$ref": "#/$defs/agentExposure"
                },
                "codex": {
                  "$ref": "#/$defs/agentExposure"
                },
                "opencode": {
                  "$ref": "#/$defs/agentExposure"
                },
                "gemini": {
                  "$ref": "#/$defs/agentExposure"
                },
                "copilot": {
                  "$ref": "#/$defs/agentExposure"
                },
                "chatgpt": {
                  "$ref": "#/$defs/agentExposure"
                }
              }
            }
          ]
        },
        "workflows": {
          "description": "Refs into docs/03-reference/mcp/workflows.yaml (named tool sequences; MCPINT-DOC-003). Refs only — workflow content is never duplicated in the catalog.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tools": {
          "description": "Pointer into the committed mcp_tool_surfaces.json snapshot (ADR-MCPINT-001): the snapshot is the only place tool names live. `snapshot_key` must exist under the snapshot's `servers`; `schema_version` must match the snapshot's schema_version.",
          "type": "object",
          "additionalProperties": false,
          "required": ["snapshot_key", "schema_version"],
          "properties": {
            "snapshot_key": {
              "type": "string",
              "minLength": 1
            },
            "schema_version": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "admin_tools": {
          "description": "Operator-only tool names on this server's surface (e.g. conport fork_instance/promote/promote_all). Excluded from workflow docs and non-Claude exposure rows (tool-placement-map §3).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "aux_surfaces": {
          "description": "Runtime-observed auxiliary HTTP surfaces that are not the contractual MCP transport (e.g. gptr-mcp :3009 /messages SSE, P0 claim 12 / GPTR-TRANSPORT-TRUTH).",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "contractual"],
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "protocol": {
                "enum": ["http", "sse"]
              },
              "contractual": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "url_template": {
          "type": "string",
          "minLength": 1
        },
        "port_var": {
          "$ref": "#/$defs/envVar"
        },
        "default_port_base": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "reserved_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "extra_port_vars": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["var", "base"],
            "properties": {
              "var": {
                "$ref": "#/$defs/envVar"
              },
              "base": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "docker_compose_service": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires_env": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/envVar"
          },
          "uniqueItems": true
        },
        "optional_env": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/envVar"
          },
          "uniqueItems": true
        },
        "doctor_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env_template": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "tool_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "enum": ["http", "sse"]
              }
            },
            "required": ["transport"]
          },
          "then": {
            "anyOf": [
              {
                "required": ["url"]
              },
              {
                "required": ["url_template"]
              },
              {
                "properties": {
                  "lifecycle": {
                    "const": "planned-active"
                  }
                },
                "required": ["lifecycle"]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "stdio"
              }
            },
            "required": ["transport"]
          },
          "then": {
            "required": ["command"]
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "external"
              }
            },
            "required": ["transport"]
          },
          "then": {
            "required": ["managed"],
            "not": {
              "anyOf": [
                {
                  "required": ["url"]
                },
                {
                  "required": ["url_template"]
                },
                {
                  "required": ["command"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "per-worktree"
              },
              "default_port_base": {}
            },
            "required": ["scope", "default_port_base"]
          },
          "then": {
            "required": ["port_var"]
          }
        }
      ]
    }
  }
}
