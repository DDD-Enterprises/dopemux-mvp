{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dopemux.dev/schemas/project_control_plane/orchestrator_item.schema.json",
  "title": "Task Orchestrator Item Dry Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "item_id",
    "project_id",
    "title",
    "status",
    "dry_run_only",
    "notes",
    "handoff_contract"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pcp.orchestrator_item.v0"
    },
    "item_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queue",
        "work",
        "review",
        "terminal",
        "UNKNOWN"
      ]
    },
    "dry_run_only": {
      "type": "boolean",
      "const": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "body"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      }
    },
    "handoff_contract": {
      "type": "string"
    }
  }
}
