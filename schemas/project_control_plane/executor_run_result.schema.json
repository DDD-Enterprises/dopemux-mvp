{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dopemux.dev/schemas/project_control_plane/executor_run_result.schema.json",
  "title": "Executor Run Result Dry Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "status",
    "mutation_performed",
    "outputs",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pcp.executor_run_result.v0"
    },
    "request_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRY_RUN_COMPLETE",
        "BLOCKED",
        "UNKNOWN"
      ]
    },
    "mutation_performed": {
      "type": "boolean",
      "const": false
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
