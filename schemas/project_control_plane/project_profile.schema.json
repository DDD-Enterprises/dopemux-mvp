{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dopemux.dev/schemas/project_control_plane/project_profile.schema.json",
  "title": "Project Control Plane Project Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "project_kind",
    "repo",
    "authority_docs",
    "packet",
    "proof",
    "red_lane_policy",
    "forbidden_paths",
    "export_mode",
    "unknown_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pcp.project_profile.v0"
    },
    "project_id": {
      "type": "string"
    },
    "project_kind": {
      "type": "string",
      "enum": [
        "DOPEMUX",
        "DNH_CRM",
        "GENERIC",
        "UNKNOWN"
      ]
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "root_marker",
        "allowed_worktrees",
        "forbidden_worktrees",
        "runtime_imports_allowed"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "root_marker": {
          "type": "string"
        },
        "allowed_worktrees": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_worktrees": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime_imports_allowed": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "authority_docs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "required",
          "state"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "state": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "PRESENT",
              "ABSENT"
            ]
          }
        }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_packet_paths",
        "required",
        "unknown_code"
      ],
      "properties": {
        "active_packet_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required": {
          "type": "boolean"
        },
        "unknown_code": {
          "type": "string",
          "const": "BLOCKED_UNKNOWN_ACTIVE_PACKET"
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_roots",
        "freshness_required",
        "unknown_code"
      ],
      "properties": {
        "proof_roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "freshness_required": {
          "type": "boolean"
        },
        "unknown_code": {
          "type": "string",
          "const": "NEEDS_EVIDENCE_REFRESH"
        }
      }
    },
    "red_lane_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_ref",
        "default_on_unknown",
        "lanes"
      ],
      "properties": {
        "policy_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_on_unknown": {
          "type": "string",
          "enum": [
            "BLOCK",
            "NEEDS_SUPERVISOR"
          ]
        },
        "lanes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "glob",
          "reason",
          "result"
        ],
        "properties": {
          "glob": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "BLOCKED_UNKNOWN_ACTIVE_PACKET",
              "BLOCKED_FORBIDDEN_WORKTREE",
              "NEEDS_SUPERVISOR",
              "BLOCKED_RUNTIME_DB",
              "BLOCKED_NO_WRITE_CONTRACT",
              "BLOCKED_SCHEMA_INVALID",
              "NEEDS_EVIDENCE_REFRESH",
              "BLOCKED_UNACCEPTED_AUTHORITY",
              "PASS"
            ]
          }
        }
      }
    },
    "export_mode": {
      "type": "string",
      "enum": [
        "ARTIFACT_ONLY",
        "DRY_RUN_ONLY"
      ]
    },
    "unknown_policy": {
      "type": "string",
      "enum": [
        "FAIL_CLOSED",
        "NEEDS_SUPERVISOR"
      ]
    }
  }
}
