{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dope-context/index_workspace.request.schema.json",
  "title": "index_workspace Request",
  "description": "MCP tool: index_workspace — Index a workspace directory for code search. Derived from server.py:971-1023.",
  "type": "object",
  "properties": {
    "workspace_path": {
      "type": ["string", "null"],
      "description": "Absolute path to workspace root. Defaults to auto-detected workspace."
    },
    "workspace_paths": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "Optional list of paths to batch index."
    },
    "include_patterns": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "File patterns to include. Default: [\"*.py\", \"*.js\", \"*.ts\", \"*.tsx\"]"
    },
    "exclude_patterns": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "File patterns to exclude. Default: [\"*test*\", \"*__pycache__*\"]"
    },
    "max_files": {
      "type": ["integer", "null"],
      "description": "Maximum files to index."
    }
  },
  "additionalProperties": false
}
