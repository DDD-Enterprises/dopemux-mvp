{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dope-context/docs_search.request.schema.json",
  "title": "docs_search Request",
  "description": "MCP tool: docs_search — Search indexed documents. Derived from server.py:1776-1848.",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "description": "Natural language search query."
    },
    "top_k": {
      "type": "integer",
      "default": 10,
      "minimum": 1,
      "description": "Number of results to return."
    },
    "filter_doc_type": {
      "type": ["string", "null"],
      "description": "Filter by document type (md, pdf, html, txt)."
    },
    "workspace_path": {
      "type": ["string", "null"],
      "description": "Optional workspace path."
    },
    "max_content_length": {
      "type": "integer",
      "default": 2000,
      "description": "Max characters per doc."
    },
    "workspace_paths": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "Optional list of workspaces to query sequentially."
    }
  },
  "required": ["query"],
  "additionalProperties": false
}
