        },
        "required": ["user_id"]
      },
      "response_shape": {"workspaces": "[{workspace_summary_objects}]", "total": "integer", "user_id": "string", "response_time_ms": "number"}
    },
    {
      "name": "fork_instance",
      "source": "server.py:107",
      "request": {
