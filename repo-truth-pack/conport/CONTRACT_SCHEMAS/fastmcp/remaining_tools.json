    {
      "name": "promote_all",
      "source": "server.py:125",
      "request": {
        "type": "object",
        "properties": {
          "workspace_id": {"type": "string"}
        },
        "required": ["workspace_id"]
      },
      "response_shape": {"status": "promoted_all", "workspace_id": "string", "instance_id": "string", "count": "integer"}
