{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conport/fastmcp/remaining_tools.json",
  "title": "FastMCP Remaining Tools (10 of 13)",
  "description": "Contract schemas for the 10 remaining FastMCP tools. Source: server.py",
  "tools": [
    {
      "name": "update_progress",
      "source": "server.py:46",
      "request": {
        "type": "object",
        "properties": {
          "progress_id": {"type": "string", "format": "uuid"},
          "updates": {"type": "object", "description": "Fields to update: status, percentage, description, priority, actual_hours"}
