          "limit": {"type": "integer", "default": 10}
        },
        "required": []
      },
      "response_shape": {"workspace_id": "string|null", "decisions": "[{decision_objects}]", "count": "integer", "truncation_stats": "object|null"}
    },
    {
      "name": "get_recent_activity",
      "source": "server.py:80",
      "request": {
        "type": "object",
        "properties": {
