{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conport/fastmcp/get_progress.json",
  "title": "FastMCP get_progress",
  "description": "Get progress entries for a workspace (optionally filter by status). Source: server.py:36",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "workspace_id": {"type": "string", "description": "Workspace identifier"},
        "status": {"type": ["string", "null"], "description": "Filter by status", "default": null},
        "limit": {"type": "integer", "description": "Max entries to return", "default": 20}
      },
      "required": ["workspace_id"]
    },
    "response": {
      "type": "string",
      "description": "JSON-encoded string of progress result object",
      "contentMediaType": "application/json",
      "x-parsed-shape": {
        "type": "object",
        "properties": {
          "workspace_id": {"type": ["string", "null"]},
          "progress": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {"type": "string", "format": "uuid"},
                "workspace_id": {"type": "string"},
                "description": {"type": "string"},
                "status": {"type": "string", "enum": ["PLANNED", "IN_PROGRESS", "COMPLETED", "BLOCKED", "CANCELLED"]},
                "percentage": {"type": "integer", "minimum": 0, "maximum": 100},
                "linked_decision_id": {"type": ["string", "null"], "format": "uuid"},
                "priority": {"type": "string", "enum": ["low", "medium", "high", "urgent"]},
                "estimated_hours": {"type": ["number", "null"]},
                "actual_hours": {"type": ["number", "null"]},
                "created_at": {"type": "string", "format": "date-time"},
                "updated_at": {"type": "string", "format": "date-time"},
                "completed_at": {"type": ["string", "null"], "format": "date-time"}
              }
            }
          },
          "count": {"type": "integer"},
          "truncation_stats": {
            "type": ["object", "null"],
            "properties": {
              "original_count": {"type": "integer"},
              "returned_count": {"type": "integer"},
              "estimated_tokens": {"type": "integer"},
              "truncated": {"type": "boolean"}
            }
          }
        }
      }
    },
    "error": {
      "type": "string",
      "description": "On HTTP error, raises aiohttp.ClientResponseError"
    }
  }
}
