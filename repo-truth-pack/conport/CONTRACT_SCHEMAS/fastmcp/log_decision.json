{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conport/fastmcp/log_decision.json",
  "title": "FastMCP log_decision",
  "description": "Log an architectural or technical decision. Source: server.py:65. VARIANT: conport_mcp_stdio.py sends 'summary' instead of 'topic'.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "workspace_id": {"type": "string"},
        "topic": {"type": "string", "description": "Decision topic"},
        "decision": {"type": "string", "description": "Decision text"},
        "rationale": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}, "default": []}
      },
      "required": ["workspace_id", "topic", "decision", "rationale"]
    },
    "response": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-parsed-shape": {
        "type": "object",
        "properties": {
          "status": {"type": "string", "const": "logged"},
          "decision": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "format": "uuid"},
              "workspace_id": {"type": "string"},
              "summary": {"type": "string"},
              "rationale": {"type": "string"},
              "alternatives": {"type": "array"},
              "tags": {"type": "array", "items": {"type": "string"}},
              "confidence_level": {"type": "string"},
              "decision_type": {"type": "string"},
              "created_at": {"type": "string", "format": "date-time"},
              "updated_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    }
  }
}
