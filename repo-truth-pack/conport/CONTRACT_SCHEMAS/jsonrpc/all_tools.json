{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conport/jsonrpc/all_tools.json",
  "title": "JSON-RPC Tool Contracts",
  "description": "All 12 JSON-RPC tools. 9 discoverable via tools/list, 3 undiscoverable. Source: enhanced_server.py",
  "meta": {
    "endpoint": "POST /mcp",
    "protocol": "JSON-RPC 2.0",
    "source": "enhanced_server.py:1681-1917"
  },
  "request_envelope": {
    "type": "object",
    "properties": {
      "jsonrpc": {"type": "string", "const": "2.0"},
      "id": {"type": ["integer", "string", "null"]},
      "method": {"type": "string", "description": "tools/call, tool/call, or conport_* directly"},
      "params": {
        "type": "object",
        "description": "For tools/call: {name, arguments}. For direct: tool arguments."
      }
    },
    "required": ["jsonrpc", "method"]
  },
  "response_envelope_success": {
    "type": "object",
    "properties": {
      "jsonrpc": {"type": "string", "const": "2.0"},
      "id": {"type": ["integer", "string", "null"]},
      "result": {"type": "object"}
    },
    "required": ["jsonrpc", "id", "result"]
  },
  "response_envelope_error": {
    "type": "object",
    "properties": {
      "jsonrpc": {"type": "string", "const": "2.0"},
      "id": {"type": ["integer", "string", "null"]},
      "error": {
        "type": "object",
        "properties": {
          "code": {"type": "integer"},
          "message": {"type": "string"},
          "data": {}
        },
        "required": ["code", "message"]
      }
    },
    "required": ["jsonrpc", "id", "error"]
  },
  "tools": {
    "conport_get_context": {
      "discoverable": true,
      "inputSchema": {
        "type": "object",
        "properties": {"workspace_id": {"type": "string"}},
        "required": ["workspace_id"]
      },
      "result_shape": {
        "workspace_id": "string",
        "instance_id": "string|null",
        "active_context": "string",
        "last_activity": "string",
        "session_time": "string",
        "focus_state": "string",
        "session_milestone": "string|null",
        "updated_at": "ISO-8601"
      }
    },
    "conport_update_context": {
      "discoverable": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {"type": "string"},
          "active_context": {"type": "string"},
          "last_activity": {"type": "string"},
          "session_time": {"type": "string"},
          "focus_state": {"type": "string"},
          "session_milestone": {"type": "string"}
        },
        "required": ["workspace_id"]
      },
      "result_shape": {"status": "success", "workspace_id": "string", "updated": "{context_object}"}
    },
    "conport_log_decision": {
      "discoverable": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {"type": "string"},
          "summary": {"type": "string"},
          "rationale": {"type": "string"},
          "alternatives": {"type": "array", "items": {"type": "string"}},
          "tags": {"type": "array", "items": {"type": "string"}},
          "confidence_level": {"type": "string", "enum": ["low", "medium", "high"]},
          "decision_type": {"type": "string"}
        },
        "required": ["workspace_id", "summary", "rationale"]
      },
      "result_shape": {"status": "logged", "decision": "{decision_object}"}
    },
    "conport_get_decisions": {
      "discoverable": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {"type": "string"},
          "limit": {"type": "integer", "default": 10}
        },
        "required": ["workspace_id"]
      },
      "result_shape": {"workspace_id": "string|null", "decisions": "[{decision_objects}]", "count": "integer", "truncation_stats": "object|null"}
    },
    "conport_log_progress": {
      "discoverable": true,
      "note": "Default status is 'IN_PROGRESS' here (enhanced_server.py:1150), vs 'PLANNED' in FastMCP",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {"type": "string"},
          "description": {"type": "string"},
          "status": {"type": "string", "default": "IN_PROGRESS"},
          "percentage": {"type": "integer", "default": 0},
          "priority": {"type": "string", "default": "medium"},
          "estimated_hours": {"type": "number"},
          "actual_hours": {"type": "number"},
          "linked_decision_id": {"type": "string"}
        },
        "required": ["workspace_id", "description"]
      },
      "result_shape": {"status": "logged", "progress": "{progress_entry_object}"}
    },
    "conport_get_progress": {
      "discoverable": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {"type": "string"},
          "status": {"type": "string"},
          "limit": {"type": "integer", "default": 20}
        },
        "required": ["workspace_id"]
      },
      "result_shape": {"workspace_id": "string|null", "progress": "[{progress_objects}]", "count": "integer", "truncation_stats": "object|null"}
    },
    "conport_update_progress": {
      "discoverable": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "progress_id": {"type": "string"},
          "status": {"type": "string"},
          "percentage": {"type": "integer"},
          "description": {"type": "string"},
          "priority": {"type": "string"},
          "actual_hours": {"type": "number"}
        },
        "required": ["progress_id"]
      },
      "result_shape": {"status": "updated", "progress": "{progress_entry_object}"}
    },
    "conport_get_recent_activity": {
      "discoverable": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {"type": "string"},
          "hours": {"type": "integer", "default": 24}
        },
        "required": ["workspace_id"]
      },
      "result_shape": {"workspace_id": "string", "activities": "[{activity_objects}]", "hours_back": "integer"}
    },
    "conport_get_active_work": {
      "discoverable": true,
      "inputSchema": {
        "type": "object",
        "properties": {"workspace_id": {"type": "string"}},
        "required": ["workspace_id"]
      },
      "result_shape": {"workspace_id": "string", "active_work": "[{work_items}]", "count": "integer"}
    },
    "conport_fork_instance": {
      "discoverable": false,
      "note": "UNDISCOVERABLE: In dispatch_map but NOT in _get_tool_schemas()",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {"type": "string"},
          "source_instance": {"type": ["string", "null"]},
          "target_instance": {"type": ["string", "null"]}
        },
        "required": ["workspace_id"]
      },
      "result_shape": {"status": "forked", "workspace_id": "string", "source_instance": "string|null", "target_instance": "string", "count": "integer"},
      "error_cases": [
        {"condition": "missing workspace_id", "error": "workspace_id required"},
        {"condition": "no target_instance detected", "error": "target_instance not detected"}
      ]
    },
    "conport_promote": {
      "discoverable": false,
      "note": "UNDISCOVERABLE: In dispatch_map but NOT in _get_tool_schemas()",
      "inputSchema": {
        "type": "object",
        "properties": {"progress_id": {"type": "string"}},
        "required": ["progress_id"]
      },
      "result_shape": {"status": "promoted", "progress_id": "string"},
      "error_cases": [
        {"condition": "missing progress_id", "error": "progress_id required"},
        {"condition": "not found", "error": "not found"}
      ]
    },
    "conport_promote_all": {
      "discoverable": false,
      "note": "UNDISCOVERABLE: In dispatch_map but NOT in _get_tool_schemas()",
      "inputSchema": {
        "type": "object",
        "properties": {"workspace_id": {"type": "string"}},
        "required": ["workspace_id"]
      },
      "result_shape": {"status": "promoted_all", "workspace_id": "string", "instance_id": "string", "count": "integer"},
      "error_cases": [
        {"condition": "missing workspace_id", "error": "workspace_id required"},
        {"condition": "no instance detected", "error": "No current instance detected"}
      ]
    }
  }
}
