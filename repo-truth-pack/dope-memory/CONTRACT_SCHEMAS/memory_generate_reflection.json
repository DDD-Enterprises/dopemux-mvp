{
  "$id": "dope-memory/memory_generate_reflection",
  "title": "memory_generate_reflection contract",
  "description": "Generate a deterministic reflection card from recent work. Phase 2 tool. Derived from MemoryGenerateReflectionRequest (dope_memory_main.py:833) and DopeMemoryMCPServer.memory_generate_reflection (dope_memory_main.py:571).",
  "request": {
    "type": "object",
    "properties": {
      "workspace_id": { "type": "string", "default": "default" },
      "instance_id": { "type": "string", "default": "A" },
      "session_id": { "type": ["string", "null"], "default": null },
      "window_hours": {
        "type": "integer",
        "default": 2,
        "minimum": 1,
        "maximum": 24,
        "description": "Hours to look back for reflection window"
      }
    },
    "required": []
  },
  "response": {
    "type": "object",
    "properties": {
      "reflection_id": {
        "type": ["string", "null"],
        "description": "UUID of the generated reflection card. Null if no activity in window."
      },
      "trajectory": {
        "type": "string",
        "description": "1-sentence trajectory summary, e.g. 'Active in debugging'"
      },
      "top_decisions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "summary": { "type": "string" }
          },
          "required": ["id", "summary"]
        },
        "maxItems": 3
      },
      "top_blockers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "summary": { "type": "string" }
          },
          "required": ["id", "summary"]
        },
        "maxItems": 3
      },
      "progress": {
        "type": "object",
        "properties": {
          "total_entries": { "type": "integer" },
          "categories": { "type": "object", "additionalProperties": { "type": "integer" } },
          "active_session": { "type": "string" }
        }
      },
      "next_suggested": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["resolve_blocker", "implement_decision", "complete_task", "continue_work"] },
            "summary": { "type": "string" },
            "entry_id": { "type": "string" }
          },
          "required": ["type", "summary", "entry_id"]
        },
        "maxItems": 3
      }
    },
    "required": ["reflection_id", "trajectory", "top_decisions", "top_blockers", "progress", "next_suggested"]
  },
  "errors": {
    "400": { "description": "Tool execution error" },
    "422": { "description": "Pydantic validation error" },
    "503": { "description": "MCP server not initialized" }
  }
}
