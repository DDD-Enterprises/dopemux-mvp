{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dope-memory/memory_search",
  "title": "memory_search contract",
  "description": "Search work log entries with trajectory boost. Derived from MemorySearchRequest (dope_memory_main.py:740) and DopeMemoryMCPServer.memory_search (dope_memory_main.py:137).",
  "request": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "default": "",
        "description": "Keyword search query (LIKE on summary, lowercased)"
      },
      "workspace_id": {
        "type": "string",
        "default": "default",
        "description": "Workspace identifier. Defaults to DOPE_MEMORY_WORKSPACE_ID env var."
      },
      "instance_id": {
        "type": "string",
        "default": "A",
        "description": "Instance identifier. Defaults to DOPE_MEMORY_INSTANCE_ID env var."
      },
      "session_id": {
        "type": ["string", "null"],
        "default": null,
        "description": "Optional session filter"
      },
      "category": {
        "type": ["string", "null"],
        "default": null,
        "enum": ["planning", "implementation", "review", "debugging", "research", "deployment", "architecture", "documentation", null]
      },
      "entry_type": {
        "type": ["string", "null"],
        "default": null,
        "enum": ["decision", "blocker", "resolution", "milestone", "error", "workflow_transition", "manual_note", "task_event", null]
      },
      "workflow_phase": {
        "type": ["string", "null"],
        "default": null,
        "enum": ["planning", "implementation", "review", "audit", "deployment", "maintenance", null]
      },
      "tags_any": {
        "type": ["array", "null"],
        "items": { "type": "string" },
        "default": null,
        "description": "Match entries containing any of these tags (JSON array overlap)"
      },
      "time_range": {
        "type": ["string", "null"],
        "default": null,
        "enum": ["today", "week", "month", "all", null]
      },
      "top_k": {
        "type": "integer",
        "default": 3,
        "minimum": 1,
        "maximum": 20,
        "description": "Max results to return (ADHD Top-3 boundary default)"
      },
      "cursor": {
        "type": ["string", "null"],
        "default": null,
        "description": "Base64-encoded pagination cursor from previous response next_token"
      },
      "include_superseded": {
        "type": "boolean",
        "default": false,
        "description": "If true, include superseded entries with chain annotations"
      }
    },
    "required": []
  },
  "response": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "ts_utc": { "type": "string", "format": "date-time" },
            "summary": { "type": "string" },
            "category": { "type": "string" },
            "entry_type": { "type": "string" },
            "workflow_phase": { "type": ["string", "null"] },
            "outcome": { "type": "string" },
            "importance_score": { "type": "integer", "minimum": 1, "maximum": 10 },
            "tags": { "type": "array", "items": { "type": "string" } },
            "_boost_applied": { "type": "number", "description": "Trajectory boost factor applied (0.0-0.5)" },
            "is_head": { "type": "boolean", "description": "Only present when include_superseded=true" },
            "superseded_by": { "type": ["string", "null"], "description": "Only present when include_superseded=true" },
            "supersedes": { "type": ["string", "null"], "description": "Only present when include_superseded=true" },
            "chain_position": {
              "type": ["object", "null"],
              "properties": {
                "position": { "type": "integer" },
                "depth": { "type": "integer" }
              },
              "description": "Only present when include_superseded=true"
            }
          },
          "required": ["id", "ts_utc", "summary", "category", "entry_type", "outcome", "importance_score", "tags"]
        }
      },
      "more_count": { "type": "integer", "minimum": 0 },
      "next_token": { "type": ["string", "null"] }
    },
    "required": ["items", "more_count", "next_token"]
  },
  "errors": {
    "400": { "description": "Tool execution error", "body": { "detail": "string" } },
    "422": { "description": "Pydantic validation error (auto-generated by FastAPI)" },
    "503": { "description": "MCP server not initialized", "body": { "detail": "MCP server not initialized" } }
  }
}
