{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dope-memory/memory_trajectory",
  "title": "memory_trajectory contract",
  "description": "Get current trajectory state with time-decay boost factor. Derived from MemoryTrajectoryRequest (dope_memory_main.py:851) and DopeMemoryMCPServer.memory_trajectory (dope_memory_main.py:688).",
  "request": {
    "type": "object",
    "properties": {
      "workspace_id": { "type": "string", "default": "default" },
      "instance_id": { "type": "string", "default": "A" }
    },
    "required": []
  },
  "response": {
    "type": "object",
    "properties": {
      "current_stream": {
        "type": "string",
        "description": "Current activity stream, e.g. 'Active in debugging' or 'idle'"
      },
      "current_goal": {
        "type": "object",
        "description": "Current goal context (from trajectory_state.current_goal_json)"
      },
      "last_steps": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "summary": { "type": "string" },
            "ts_utc": { "type": "string" },
            "entry_type": { "type": "string" },
            "category": { "type": "string" }
          }
        },
        "maxItems": 3,
        "description": "Last 3 high-signal steps (newest first)"
      },
      "boost_factor": {
        "type": "number",
        "minimum": 1.0,
        "maximum": 2.0,
        "description": "Time-decay boost factor. 2.0 = just updated, decays to 1.0 over 24 hours. Returns 1.0 when no trajectory exists."
      }
    },
    "required": ["current_stream", "current_goal", "last_steps", "boost_factor"]
  },
  "errors": {
    "400": { "description": "Tool execution error" },
    "422": { "description": "Pydantic validation error" },
    "503": { "description": "MCP server not initialized" }
  }
}
