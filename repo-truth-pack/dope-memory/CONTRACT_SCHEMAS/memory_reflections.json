{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dope-memory/memory_reflections",
  "title": "memory_reflections contract",
  "description": "Fetch recent reflection cards with staleness detection. Derived from MemoryReflectionsRequest (dope_memory_main.py:842) and DopeMemoryMCPServer.memory_reflections (dope_memory_main.py:663).",
  "request": {
    "type": "object",
    "properties": {
      "workspace_id": { "type": "string", "default": "default" },
      "instance_id": { "type": "string", "default": "A" },
      "session_id": { "type": ["string", "null"], "default": null },
      "limit": { "type": "integer", "default": 3, "minimum": 1, "maximum": 10 }
    },
    "required": []
  },
  "response": {
    "type": "object",
    "properties": {
      "reflections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "reflection_id": { "type": "string" },
            "ts_utc": { "type": "string", "format": "date-time" },
            "window_start": { "type": "string", "format": "date-time" },
            "window_end": { "type": "string", "format": "date-time" },
            "trajectory_summary": { "type": "string" },
            "top_decisions": { "type": "array", "items": { "type": "object" } },
            "top_blockers": { "type": "array", "items": { "type": "object" } },
            "progress_summary": { "type": "object" },
            "suggested_next": { "type": "array", "items": { "type": "object" } },
            "source_entry_ids": { "type": "array", "items": { "type": "string" } },
            "stale_entries": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Source entry IDs that have been superseded since reflection was generated"
            },
            "regeneration_recommended": {
              "type": "boolean",
              "description": "True if any source entries are stale (Packet F §7.1)"
            }
          },
          "required": ["reflection_id", "ts_utc", "window_start", "window_end", "trajectory_summary", "top_decisions", "top_blockers", "progress_summary", "suggested_next", "source_entry_ids", "stale_entries", "regeneration_recommended"]
        }
      },
      "count": { "type": "integer" }
    },
    "required": ["reflections", "count"]
  },
  "errors": {
    "400": { "description": "Tool execution error" },
    "422": { "description": "Pydantic validation error" },
    "503": { "description": "MCP server not initialized" }
  }
}
