{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/find_test_file",
  "title": "Find Test File",
  "description": "Locates the corresponding test file for a given implementation file, or vice versa, with ADHD-friendly suggestions.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string",
          "description": "Path to the implementation or test file"
        }
      },
      "required": [
        "file_path"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "found": {
          "type": "boolean"
        },
        "test_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "implementation_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "relationship": {
          "type": "string"
        },
        "suggestion": {
          "type": "string"
        },
        "adhd_tip": {
          "type": "string"
        }
      },
      "required": [
        "found",
        "test_file",
        "implementation_file",
        "relationship",
        "suggestion",
        "adhd_tip"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns found=false with suggestion for manual lookup"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 2
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": null
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": false
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
