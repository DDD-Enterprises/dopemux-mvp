{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/get_reading_order",
  "title": "Get Reading Order",
  "description": "Computes an optimal reading order for a set of files based on complexity, dependencies, and ADHD-optimized session planning with Pomodoro integration.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "List of file paths to order for reading"
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional list of symbols to focus on"
        }
      },
      "required": [
        "files"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "total_files": {
          "type": "integer"
        },
        "reading_order": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "complexity_score": {
                "type": "number"
              },
              "reading_minutes": {
                "type": "number"
              },
              "level": {
                "type": "string"
              }
            },
            "required": [
              "file",
              "complexity_score",
              "reading_minutes",
              "level"
            ]
          }
        },
        "session_plan": {
          "type": "object",
          "properties": {
            "total_reading_minutes": {
              "type": "number"
            },
            "pomodoro_sessions_needed": {
              "type": "integer"
            }
          },
          "required": [
            "total_reading_minutes",
            "pomodoro_sessions_needed"
          ]
        },
        "adhd_guidance": {
          "type": "object"
        }
      },
      "required": [
        "total_files",
        "reading_order",
        "session_plan",
        "adhd_guidance"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns files in original order with default complexity on error"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 2
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": null
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": false
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
