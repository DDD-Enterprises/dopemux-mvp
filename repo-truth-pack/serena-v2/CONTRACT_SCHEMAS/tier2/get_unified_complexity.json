{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/get_unified_complexity",
  "title": "Get Unified Complexity",
  "description": "Returns a unified complexity score combining multiple analysis sources (tree-sitter, LSP, heuristic) with fallback chain.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string",
          "description": "Path to the source file"
        },
        "symbol": {
          "type": "string",
          "description": "Optional symbol to analyze"
        },
        "user_id": {
          "type": "string",
          "default": "default",
          "description": "User identifier for ADHD profile lookup"
        }
      },
      "required": [
        "file_path"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "fallback_score": {
          "type": "number"
        },
        "interpretation": {
          "type": "string"
        }
      },
      "required": [
        "file_path",
        "symbol",
        "fallback_score",
        "interpretation"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns fallback heuristic score on analysis failure"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 2
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": null
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": false
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
