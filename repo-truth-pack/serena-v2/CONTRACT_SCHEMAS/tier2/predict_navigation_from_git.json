{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/predict_navigation_from_git",
  "title": "Predict Navigation From Git",
  "description": "Analyzes git commit history to predict likely navigation targets from the current file based on co-change patterns.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "current_file": {
          "type": "string",
          "description": "Path to the current file"
        },
        "days_back": {
          "type": "integer",
          "default": 90,
          "minimum": 1,
          "description": "Number of days of git history to analyze"
        }
      },
      "required": [
        "current_file"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "current_file": {
          "type": "string"
        },
        "current_directory": {
          "type": "string"
        },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "directory": {
                "type": "string"
              },
              "commit_count": {
                "type": "integer"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reasoning": {
                "type": "string"
              }
            },
            "required": [
              "directory",
              "commit_count",
              "confidence",
              "reasoning"
            ]
          }
        },
        "git_analysis": {
          "type": "object"
        },
        "performance": {
          "type": "object"
        }
      },
      "required": [
        "current_file",
        "current_directory",
        "suggestions",
        "git_analysis",
        "performance"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns empty suggestions when git history unavailable"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 2
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": null
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": false
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
