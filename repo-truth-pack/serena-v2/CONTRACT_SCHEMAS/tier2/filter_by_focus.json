{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/filter_by_focus",
  "title": "Filter By Focus",
  "description": "Filters a list of items based on the user's current ADHD attention state, reducing cognitive overload during scattered states.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "attention_state": {
          "type": "string",
          "enum": [
            "focused",
            "scattered",
            "transitioning"
          ],
          "description": "Current ADHD attention state"
        },
        "items": {
          "type": "array",
          "items": {},
          "description": "Array of items to filter"
        }
      },
      "required": [
        "attention_state",
        "items"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "attention_state": {
          "type": "string",
          "enum": [
            "focused",
            "scattered",
            "transitioning"
          ]
        },
        "original_count": {
          "type": "integer"
        },
        "filtered_count": {
          "type": "integer"
        },
        "removed_count": {
          "type": "integer"
        },
        "items": {
          "type": "array",
          "items": {}
        },
        "adhd_guidance": {
          "type": "object",
          "properties": {
            "max_items_for_state": {
              "type": "integer"
            },
            "recommendation": {
              "type": "string"
            }
          },
          "required": [
            "max_items_for_state",
            "recommendation"
          ]
        }
      },
      "required": [
        "attention_state",
        "original_count",
        "filtered_count",
        "removed_count",
        "items",
        "adhd_guidance"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns original items unfiltered on error"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 2
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": null
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": false
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
