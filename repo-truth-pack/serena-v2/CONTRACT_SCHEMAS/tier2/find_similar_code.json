{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/find_similar_code",
  "title": "Find Similar Code",
  "description": "Searches for semantically similar code blocks using vector embeddings with ADHD-aware result limiting.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Code or description to find similar blocks for"
        },
        "top_k": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "description": "Maximum number of similar results"
        },
        "user_id": {
          "type": "string",
          "default": "default",
          "description": "User identifier for ADHD profile lookup"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "found": {
          "type": "integer"
        },
        "top_k": {
          "type": "integer"
        },
        "adhd_adjusted": {
          "type": "boolean"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "performance": {
          "type": "object"
        }
      },
      "required": [
        "query",
        "found",
        "top_k",
        "adhd_adjusted",
        "results",
        "performance"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns empty results array with found=0"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 2
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": null
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": false
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
