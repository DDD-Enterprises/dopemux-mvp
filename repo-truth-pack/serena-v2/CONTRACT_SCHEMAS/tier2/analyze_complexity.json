{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/analyze_complexity",
  "title": "Analyze Complexity",
  "description": "Performs deep complexity analysis on a file or symbol, returning cyclomatic complexity, nesting depth, and ADHD-optimized reading guidance.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string",
          "description": "Path to the source file to analyze"
        },
        "symbol_name": {
          "type": "string",
          "description": "Optional specific symbol to analyze within the file"
        }
      },
      "required": [
        "file_path"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "complexity": {
          "type": "object",
          "properties": {
            "score": {
              "type": "number"
            },
            "level": {
              "type": "string"
            },
            "recommendation": {
              "type": "string"
            }
          },
          "required": [
            "score",
            "level",
            "recommendation"
          ]
        },
        "metrics": {
          "type": "object",
          "properties": {
            "cyclomatic_complexity": {
              "type": "integer"
            },
            "nesting_depth": {
              "type": "integer"
            },
            "lines_of_code": {
              "type": "integer"
            },
            "function_count": {
              "type": "integer"
            }
          },
          "required": [
            "cyclomatic_complexity",
            "nesting_depth",
            "lines_of_code",
            "function_count"
          ]
        },
        "adhd_guidance": {
          "type": "object",
          "properties": {
            "safe_reading_minutes": {
              "type": "number"
            },
            "break_after_minutes": {
              "type": "number"
            },
            "chunk_if_exceeds_minutes": {
              "type": "number"
            }
          },
          "required": [
            "safe_reading_minutes",
            "break_after_minutes",
            "chunk_if_exceeds_minutes"
          ]
        },
        "performance": {
          "type": "object",
          "properties": {
            "latency_ms": {
              "type": "number"
            },
            "mode": {
              "type": "string"
            }
          },
          "required": [
            "latency_ms",
            "mode"
          ]
        }
      },
      "required": [
        "file",
        "symbol",
        "complexity",
        "metrics",
        "adhd_guidance",
        "performance"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns error with partial metrics when analysis fails"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 2
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": null
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": false
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
