{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/suggest_next_step",
  "title": "Suggest Next Step",
  "description": "Suggests the next logical navigation step based on the current file and symbol context, reducing decision fatigue.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "current_file": {
          "type": "string",
          "description": "Path to the file currently being viewed"
        },
        "current_symbol": {
          "type": "string",
          "description": "Optional symbol name for more targeted suggestions"
        }
      },
      "required": [
        "current_file"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "current_file": {
          "type": "string"
        },
        "current_symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "type",
              "target",
              "reason",
              "confidence"
            ]
          }
        },
        "mode": {
          "type": "string"
        },
        "adhd_guidance": {
          "type": "object"
        }
      },
      "required": [
        "current_file",
        "current_symbol",
        "suggestions",
        "mode",
        "adhd_guidance"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns empty suggestions array on error"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 2
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": null
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": false
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
