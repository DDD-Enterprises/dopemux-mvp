{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/get_navigation_patterns",
  "title": "Get Navigation Patterns",
  "description": "Returns current navigation pattern learning status and recommendations. Currently in learning phase with limited pattern data.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "days_back": {
          "type": "integer",
          "default": 7,
          "minimum": 1,
          "description": "Number of days of history to analyze"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "learning_phase"
        },
        "message": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        },
        "current_capabilities": {
          "type": "object"
        },
        "phase_3_features": {
          "type": "object"
        }
      },
      "required": [
        "status",
        "message",
        "recommendation",
        "current_capabilities",
        "phase_3_features"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns learning_phase status with default message"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 3
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": null
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": false
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
