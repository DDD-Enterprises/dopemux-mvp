{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/snooze_untracked_work",
  "title": "Snooze Untracked Work",
  "description": "Temporarily snoozes notifications for untracked work for a configurable duration.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "work_id": {
          "type": "string",
          "description": "Identifier of the work to snooze"
        },
        "duration": {
          "type": "string",
          "enum": [
            "short",
            "medium",
            "long"
          ],
          "default": "medium",
          "description": "Snooze duration (short=15min, medium=1hr, long=4hr)"
        }
      },
      "required": [
        "work_id"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "work_id": {
          "type": "string"
        },
        "snooze_until": {
          "type": "string",
          "format": "date-time"
        },
        "duration_seconds": {
          "type": "integer"
        },
        "persisted_to_conport": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "message",
        "work_id",
        "snooze_until",
        "duration_seconds",
        "persisted_to_conport"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns error when work_id not found"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 0
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": "F1"
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": true
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
