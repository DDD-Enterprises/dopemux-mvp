{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/mark_abandoned",
  "title": "Mark Abandoned",
  "description": "Marks an abandoned work item with a resolution action and updates pattern learning.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "work_name": {
          "type": "string",
          "description": "Name of the abandoned work item"
        },
        "action_taken": {
          "type": "string",
          "enum": [
            "commit",
            "delete",
            "archive"
          ],
          "description": "Resolution action taken"
        }
      },
      "required": [
        "work_name",
        "action_taken"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "work_name": {
          "type": "string"
        },
        "action_taken": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "pattern_learning": {
          "type": "object"
        }
      },
      "required": [
        "status",
        "work_name",
        "action_taken",
        "message",
        "pattern_learning"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns error when work_name not found"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 0
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": "F6"
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": true
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
