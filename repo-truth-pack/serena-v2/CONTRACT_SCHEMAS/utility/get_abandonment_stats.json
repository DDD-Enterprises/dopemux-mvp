{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/get_abandonment_stats",
  "title": "Get Abandonment Stats",
  "description": "Returns aggregate statistics about abandoned work including severity breakdown and trends.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "summary": {
          "type": "object",
          "properties": {
            "total_abandoned": {
              "type": "integer"
            },
            "by_severity": {
              "type": "object"
            },
            "avg_days_idle": {
              "type": "number"
            },
            "oldest_work": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "total_abandoned",
            "by_severity",
            "avg_days_idle",
            "oldest_work"
          ]
        }
      },
      "required": [
        "status",
        "summary"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns zero-value summary on database read failure"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 0
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": "F6"
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": true
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
