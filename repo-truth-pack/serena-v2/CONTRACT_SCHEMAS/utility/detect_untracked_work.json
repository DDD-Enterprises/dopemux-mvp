{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/detect_untracked_work",
  "title": "Detect Untracked Work",
  "description": "Analyzes git state and ConPort records to detect work that may not be properly tracked, with confidence scoring.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "session_number": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "description": "Session number to check"
        },
        "show_details": {
          "type": "boolean",
          "default": false,
          "description": "Include detailed breakdown in response"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "work_name": {
          "type": "string"
        },
        "confidence": {
          "type": "object",
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "threshold": {
              "type": "number"
            },
            "passes_threshold": {
              "type": "boolean"
            }
          },
          "required": [
            "score",
            "threshold",
            "passes_threshold"
          ]
        },
        "git_summary": {
          "type": "object"
        },
        "conport_status": {
          "type": "object"
        },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auto_track": {
          "type": "boolean"
        },
        "performance": {
          "type": "object"
        }
      },
      "required": [
        "status",
        "work_name",
        "confidence",
        "git_summary",
        "conport_status",
        "suggestions",
        "auto_track",
        "performance"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns status with error details when git analysis fails"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 0
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": "F1"
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": true
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
