{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/suggest_branch_organization",
  "title": "Suggest Branch Organization",
  "description": "Analyzes file changes to suggest logical branch groupings for better work organization with ADHD-friendly guidance.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "min_cluster_size": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "description": "Minimum files in a cluster to suggest a branch"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "clusters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "branch_name": {
                "type": "string"
              },
              "file_count": {
                "type": "integer"
              },
              "directory": {
                "type": "string"
              }
            },
            "required": [
              "branch_name",
              "file_count",
              "directory"
            ]
          }
        },
        "next_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adhd_guidance": {
          "type": "object"
        }
      },
      "required": [
        "status",
        "clusters",
        "next_steps",
        "adhd_guidance"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns empty clusters when git state is clean"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 0
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": "F4"
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": false
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
