{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/get_metrics_dashboard",
  "title": "Get Metrics Dashboard",
  "description": "Returns a comprehensive metrics dashboard with configurable detail level and optional trend data.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "days": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of days of data to include"
        },
        "level": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ],
          "description": "Detail level: 1=summary, 2=detailed, 3=full"
        },
        "include_trends": {
          "type": "boolean",
          "description": "Include trend analysis"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "dashboard": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "status",
        "dashboard",
        "metadata"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns partial dashboard with available metrics on failure"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 0
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": "F7"
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": false
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
