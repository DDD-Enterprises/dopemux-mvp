{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/save_metrics_snapshot",
  "title": "Save Metrics Snapshot",
  "description": "Captures and persists a point-in-time snapshot of all key metrics for historical tracking.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "confidence": {
              "type": "number"
            },
            "pattern_boost": {
              "type": "number"
            },
            "abandonment_rate": {
              "type": "number"
            },
            "pass_rate": {
              "type": "number"
            }
          },
          "required": [
            "confidence",
            "pattern_boost",
            "abandonment_rate",
            "pass_rate"
          ]
        }
      },
      "required": [
        "status",
        "key",
        "snapshot"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns error when snapshot persistence fails"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 0
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": "F7"
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": false
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
