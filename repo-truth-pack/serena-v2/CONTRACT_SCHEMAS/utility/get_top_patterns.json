{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/get_top_patterns",
  "title": "Get Top Patterns",
  "description": "Returns the most frequent patterns of a given type, useful for understanding codebase navigation habits.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "pattern_type": {
          "type": "string",
          "enum": [
            "file_extension",
            "directory",
            "branch_prefix"
          ],
          "default": "file_extension",
          "description": "Type of pattern to retrieve"
        },
        "limit": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "description": "Maximum patterns to return"
        },
        "min_probability": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum probability threshold"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "pattern_type": {
          "type": "string"
        },
        "patterns_found": {
          "type": "integer"
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "status",
        "pattern_type",
        "patterns_found",
        "patterns"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns empty patterns array on failure"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 0
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": "F5"
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": false
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
