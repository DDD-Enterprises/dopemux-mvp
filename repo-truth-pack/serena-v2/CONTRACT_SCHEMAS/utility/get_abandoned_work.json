{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/get_abandoned_work",
  "title": "Get Abandoned Work",
  "description": "Identifies potentially abandoned work items based on idle time and activity scoring.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "min_days_idle": {
          "type": "integer",
          "default": 7,
          "minimum": 1,
          "description": "Minimum days idle to consider abandoned"
        },
        "min_score": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum abandonment score"
        },
        "limit": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "description": "Maximum items to return"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "abandoned_count": {
          "type": "integer"
        },
        "abandoned_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "work_name": {
                "type": "string"
              },
              "days_idle": {
                "type": "integer"
              },
              "abandonment_score": {
                "type": "number"
              },
              "severity": {
                "type": "string"
              },
              "suggested_action": {
                "type": "string"
              }
            },
            "required": [
              "work_name",
              "days_idle",
              "abandonment_score",
              "severity",
              "suggested_action"
            ]
          }
        }
      },
      "required": [
        "status",
        "abandoned_count",
        "abandoned_items"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns empty abandoned_items array on failure"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 0
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": "F6"
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": true
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
