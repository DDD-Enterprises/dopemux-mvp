{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/update_untracked_work_config",
  "title": "Update Untracked Work Config",
  "description": "Updates configuration for untracked work detection. All parameters are optional; only provided values are changed.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable or disable untracked work detection"
        },
        "confidence_threshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Minimum confidence to trigger alerts"
        },
        "grace_period_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180,
          "description": "Minutes before alerting on new untracked work"
        },
        "quiet_hours_enabled": {
          "type": "boolean",
          "description": "Enable quiet hours"
        },
        "quiet_hours_start": {
          "type": "string",
          "description": "Quiet hours start time (HH:MM format)"
        },
        "quiet_hours_end": {
          "type": "string",
          "description": "Quiet hours end time (HH:MM format)"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "updates": {
          "type": "object"
        },
        "current_config": {
          "type": "object"
        },
        "persisted_to_conport": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "message",
        "updates",
        "current_config",
        "persisted_to_conport"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns error with unchanged config on failure"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 0
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": "F1"
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": true
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
