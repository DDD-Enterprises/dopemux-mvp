{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/track_untracked_work",
  "title": "Track Untracked Work",
  "description": "Creates a tracked task from previously detected untracked work, integrating with ConPort for persistence.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "work_name": {
          "type": "string",
          "description": "Name/identifier of the work to track"
        },
        "custom_description": {
          "type": "string",
          "description": "Optional custom description for the task"
        },
        "complexity": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Optional complexity score"
        }
      },
      "required": [
        "work_name"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "task_created"
        },
        "message": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "task_data": {
          "type": "object"
        },
        "next_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "message",
        "task_id",
        "task_data",
        "next_steps"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns error when task creation fails"
        },
        "recoverable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 0
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": "F1"
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": true
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
