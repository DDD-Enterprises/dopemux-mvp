{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serena-v2/contracts/get_context",
  "title": "Get Context",
  "description": "Retrieves source code context around a specific line with optional complexity analysis and ADHD-safe reading time estimates.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string",
          "description": "Path to the source file"
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "Center line number (1-based)"
        },
        "context_lines": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "Number of context lines above and below"
        },
        "include_complexity": {
          "type": "boolean",
          "default": true,
          "description": "Whether to include complexity analysis"
        }
      },
      "required": [
        "file_path",
        "line"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "center_line": {
          "type": "integer"
        },
        "range": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            },
            "total_lines": {
              "type": "integer"
            }
          },
          "required": [
            "start",
            "end",
            "total_lines"
          ]
        },
        "context": {
          "type": "string"
        },
        "complexity": {
          "type": "object",
          "properties": {
            "score": {
              "type": "number"
            },
            "available": {
              "type": "boolean"
            },
            "safe_reading_minutes": {
              "type": "number"
            }
          },
          "required": [
            "score",
            "available",
            "safe_reading_minutes"
          ]
        },
        "performance": {
          "type": "object",
          "properties": {
            "latency_ms": {
              "type": "number"
            }
          },
          "required": [
            "latency_ms"
          ]
        }
      },
      "required": [
        "file",
        "center_line",
        "range",
        "context",
        "complexity",
        "performance"
      ]
    },
    "error_behavior": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "const": "Returns error when file cannot be read"
        },
        "recoverable": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "description",
        "recoverable"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "const": 1
        },
        "feature": {
          "type": [
            "string",
            "null"
          ],
          "const": null
        },
        "registration_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "handler_line": {
          "type": [
            "integer",
            "null"
          ],
          "const": null
        },
        "multi_workspace": {
          "type": "boolean",
          "const": false
        },
        "conport_integration": {
          "type": "boolean",
          "const": false
        },
        "adhd_optimization": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "tier",
        "feature",
        "registration_line",
        "handler_line",
        "multi_workspace",
        "conport_integration",
        "adhd_optimization"
      ]
    }
  }
}
