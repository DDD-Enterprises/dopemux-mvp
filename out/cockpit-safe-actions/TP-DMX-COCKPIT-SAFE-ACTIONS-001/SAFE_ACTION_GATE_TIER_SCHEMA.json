        "authority_domain == unknown / conflicting",
        "source_provenance missing"
      ],
      "allowed_sources": [
        "Command Palette Inspect outcome",
        "Contextual surface read-only display",
        "Overview drift summary read-only"
      ],
      "forbidden_behaviors": [
        "primary action button",
        "silent refresh that mutates state",
        "any execute affordance"
      ]
