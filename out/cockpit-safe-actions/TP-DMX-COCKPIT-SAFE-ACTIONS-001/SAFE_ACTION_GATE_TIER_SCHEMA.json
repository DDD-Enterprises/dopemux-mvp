{
  "schema_id": "dopemux.cockpit.safe_action_gate.tier.v1",
  "packet_id": "TP-DMX-COCKPIT-SAFE-ACTIONS-001",
  "title": "Safe Action Gate Tier Schema",
  "description": "Per-tier schema for the Cockpit Safe Action Gate. Tiers are normative and carried verbatim from SAFE_ACTION_GATE_SPEC.md §1 and COMMAND_PALETTE_INDEX_SCHEMA.json:fields.gate_tier. The Safe Action Gate never reclassifies a tier; the upstream surface (Command Palette or Settings/Admin/Runtime) carries the tier. Tier determines confirmation, preflight, proof, and refusal behavior.",
  "fail_closed_rule": "If any required preflight field for the row's tier is UNKNOWN at gate-open time, the gate refuses confirmation and routes the action to the Unknown/Drift Queue with the missing-field reason. Confirmation is never offered when required fields are missing.",
  "source_artifacts": [
    "out/cockpit-ia-reconcile/TP-DMX-COCKPIT-IA-RECONCILE-001/SAFE_ACTION_GATE_SPEC.md",
    "out/cockpit-ia-reconcile/TP-DMX-COCKPIT-IA-RECONCILE-001/COMMAND_EXPOSURE_POLICY.json",
    "out/cockpit-ia-reconcile/TP-DMX-COCKPIT-IA-RECONCILE-001/SCREEN_CONTRACT_MATRIX.json",
    "out/cockpit-ia-reconcile/TP-DMX-COCKPIT-IA-RECONCILE-001/UNKNOWN_DRIFT_QUEUE_SPEC.md",
    "out/cockpit-ia-reconcile/TP-DMX-COCKPIT-IA-RECONCILE-001/SETTINGS_ADMIN_RUNTIME_SPEC.md",
    "out/cockpit-command-palette/TP-DMX-COCKPIT-COMMAND-PALETTE-001/COMMAND_PALETTE_INDEX_SCHEMA.json",
    "out/cockpit-command-palette/TP-DMX-COCKPIT-COMMAND-PALETTE-001/PALETTE_TO_SAFE_ACTION_GATE_HANDOFF.md"
  ],
  "tier_invariants": [
    "Tiers are immutable inside the gate: the upstream surface carries the tier; the gate never reclassifies.",
    "Only T1–T6 reach a confirm affordance; T0/T0i never confirm; TX/TU never execute.",
    "Every executable tier (T1–T6) requires non-empty side_effects, expected_proof, and rollback_or_abort.",
    "Every refusal_condition is fail-closed; the gate never silently bypasses a refusal.",
    "Every tier records a gate event/receipt regardless of outcome (confirm, abort, refuse, stale-proof)."
  ],
  "tiers": {
    "T0": {
