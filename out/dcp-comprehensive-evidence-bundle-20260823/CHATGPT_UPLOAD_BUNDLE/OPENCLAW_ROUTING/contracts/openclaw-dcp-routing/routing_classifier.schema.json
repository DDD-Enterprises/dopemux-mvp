{
  "$id": "https://dcp.local/schemas/routing_classifier.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "privacy_class": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "human_approval_status": {
            "enum": [
              "missing",
              "denied",
              "expired",
              "scope_limited"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_class": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "audit_requirement": {
            "enum": [
              "independent",
              "deep",
              "security",
              "release"
            ]
          }
        }
      }
    }
  ],
  "definitions": {
    "audit_requirement": {
      "enum": [
        "none",
        "light",
        "embedded",
        "independent",
        "deep",
        "security",
        "release"
      ],
      "type": "string"
    },
    "privacy_class": {
      "enum": [
        "PUBLIC_SANDBOX",
        "PUBLIC_REPO",
        "PRIVATE_REPO_NO_SECRETS",
        "PRIVATE_REPO_POSSIBLE_SECRETS",
        "SECRET_BEARING",
        "CLIENT_DATA",
        "SECURITY_SENSITIVE",
        "RELEASE_AUTHORITY",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "provider": {
      "enum": [
        "openai",
        "anthropic",
        "google",
        "openrouter",
        "local",
        "manual",
        "multiple",
        "unknown"
      ],
      "type": "string"
    },
    "risk_class": {
      "enum": [
        "R0_READ",
        "R1_DRAFT",
        "R2_TEST_ONLY",
        "R3_LOCAL_EDIT",
        "R4_MULTI_FILE_EDIT",
        "R5_SECURITY_OR_AUTHORITY",
        "R6_RELEASE_OR_PRODUCTION",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "runner": {
      "enum": [
        "openclaw",
        "codex",
        "claude_code",
        "gemini_antigravity",
        "openrouter_generic",
        "direct_api",
        "manual_app",
        "shell_local",
        "dopetask",
        "unknown"
      ],
      "type": "string"
    },
    "tool": {
      "enum": [
        "none",
        "read",
        "search",
        "shell",
        "edit",
        "write",
        "network",
        "browser",
        "mcp",
        "github",
        "ci",
        "multimodal",
        "web",
        "local_filesystem"
      ],
      "type": "string"
    }
  },
  "properties": {
    "audit_requirement": {
      "$ref": "#/definitions/audit_requirement"
    },
    "authority_boundary": {
      "items": {
        "enum": [
          "dopemux_operator",
          "dopetask_execution",
          "task_orchestrator_workflow",
          "leantime_pm_metadata",
          "conport_structured_context",
          "dope_memory_chronicle",
          "dope_context_retrieval",
          "dopecon_bridge_adapter",
          "adhd_engine_operator_support",
          "repo_truth_extractor",
          "agent_helper",
          "unknown"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "command_execution_required": {
      "type": "boolean"
    },
    "cost_ceiling": {
      "additionalProperties": false,
      "properties": {
        "max_usd": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "requires_approval_above": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "tier": {
          "enum": [
            "free",
            "cheap",
            "standard",
            "premium",
            "unbounded",
            "unknown"
          ],
          "type": "string"
        }
      },
      "required": [
        "tier",
        "max_usd",
        "requires_approval_above"
      ],
      "type": "object"
    },
    "deadline_latency_need": {
      "enum": [
        "interactive",
        "batch",
        "ci_blocking",
        "overnight",
        "unknown"
      ],
      "type": "string"
    },
    "edit_write_required": {
      "type": "boolean"
    },
    "expected_token_size": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "total_tokens": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "type": "object"
    },
    "files_touched_expected": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "human_approval_status": {
      "enum": [
        "approved",
        "denied",
        "missing",
        "not_required",
        "expired",
        "scope_limited"
      ],
      "type": "string"
    },
    "local_benchmark_certification": {
      "additionalProperties": false,
      "properties": {
        "block_if_missing": {
          "type": "boolean"
        },
        "certification_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "certified": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "required",
        "certified",
        "certification_refs",
        "block_if_missing"
      ],
      "type": "object"
    },
    "model_provider_availability": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "type": "boolean"
          },
          "last_checked_at": {
            "format": "date-time",
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "provider": {
            "$ref": "#/definitions/provider"
          }
        },
        "required": [
          "provider",
          "available",
          "last_checked_at",
          "notes"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "prior_failure_state": {
      "items": {
        "enum": [
          "none",
          "schema_failure",
          "test_failure",
          "patch_failure",
          "hallucinated_files",
          "provider_outage",
          "openrouter_provider_drift",
          "privacy_mismatch",
          "missing_evidence",
          "auditor_disagreement",
          "release_uncertainty"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "privacy_class": {
      "$ref": "#/definitions/privacy_class"
    },
    "proof_requirement": {
      "enum": [
        "minimal",
        "standard",
        "implementation",
        "security",
        "release",
        "unknown"
      ],
      "type": "string"
    },
    "repo_project": {
      "additionalProperties": false,
      "properties": {
        "branch_or_ref": {
          "minLength": 1,
          "type": "string"
        },
        "is_private": {
          "type": "boolean"
        },
        "project_id": {
          "minLength": 1,
          "type": "string"
        },
        "repo": {
          "minLength": 1,
          "type": "string"
        },
        "worktree": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "repo",
        "project_id",
        "branch_or_ref",
        "worktree",
        "is_private"
      ],
      "type": "object"
    },
    "required_context_size": {
      "additionalProperties": false,
      "properties": {
        "estimated_input_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "requires_long_context": {
          "type": "boolean"
        },
        "retrieval_first_required": {
          "type": "boolean"
        }
      },
      "required": [
        "estimated_input_tokens",
        "requires_long_context",
        "retrieval_first_required"
      ],
      "type": "object"
    },
    "required_tools": {
      "items": {
        "$ref": "#/definitions/tool"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "risk_class": {
      "$ref": "#/definitions/risk_class"
    },
    "runner_compatibility": {
      "items": {
        "$ref": "#/definitions/runner"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "secret_scan_state": {
      "enum": [
        "clean",
        "possible_secrets",
        "confirmed_secrets",
        "not_scanned",
        "unknown"
      ],
      "type": "string"
    },
    "structured_output_required": {
      "additionalProperties": false,
      "properties": {
        "authority_level": {
          "enum": [
            "none",
            "draft",
            "machine_authority",
            "release_authority"
          ],
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "schema_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "required",
        "schema_id",
        "authority_level"
      ],
      "type": "object"
    },
    "task_description": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "task_description",
    "repo_project",
    "files_touched_expected",
    "privacy_class",
    "risk_class",
    "required_tools",
    "required_context_size",
    "structured_output_required",
    "command_execution_required",
    "edit_write_required",
    "expected_token_size",
    "deadline_latency_need",
    "cost_ceiling",
    "model_provider_availability",
    "prior_failure_state",
    "audit_requirement",
    "human_approval_status",
    "proof_requirement",
    "runner_compatibility",
    "authority_boundary",
    "secret_scan_state",
    "local_benchmark_certification"
  ],
  "title": "OpenClaw DCP Routing Classifier Input",
  "type": "object"
}
