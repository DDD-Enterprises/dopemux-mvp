{
  "$id": "https://dcp.local/schemas/pr_steward_merge_readiness.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY"
          }
        }
      },
      "then": {
        "properties": {
          "audit_refs": {
            "minItems": 1
          },
          "blocking_thread_unresolved": {
            "const": false
          },
          "checks": {
            "items": {
              "properties": {
                "conclusion": {
                  "const": "success"
                },
                "matches_head_sha": {
                  "const": true
                },
                "status": {
                  "const": "completed"
                }
              },
              "required": [
                "matches_head_sha"
              ]
            },
            "minItems": 1
          },
          "checks_stale_to_head": {
            "const": false
          },
          "diff_escapes_packet_allowlist": {
            "const": false
          },
          "failed_checks": {
            "maxItems": 0
          },
          "proof_bundle_refs": {
            "minItems": 1
          },
          "proof_stale": {
            "const": false
          },
          "review_threads": {
            "items": {
              "not": {
                "properties": {
                  "blocking": {
                    "const": true
                  },
                  "resolved": {
                    "const": false
                  }
                }
              }
            }
          },
          "security_release_gate_lacks_approval": {
            "const": false
          },
          "unclassified_review_items": {
            "maxItems": 0
          },
          "unknown_reviewers_or_bots": {
            "maxItems": 0
          },
          "unresolved_blockers": {
            "maxItems": 0
          }
        },
        "required": [
          "proof_bundle_refs",
          "audit_refs",
          "checks",
          "unknown_reviewers_or_bots",
          "unclassified_review_items",
          "failed_checks",
          "checks_stale_to_head",
          "proof_stale",
          "blocking_thread_unresolved",
          "diff_escapes_packet_allowlist",
          "security_release_gate_lacks_approval",
          "unresolved_blockers"
        ]
      }
    }
  ],
  "definitions": {
    "review_classification": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "AUTO_APPLIED",
            "MUST_FIX",
            "OPTIONAL_DEFERRED",
            "OUT_OF_SCOPE_FOLLOWUP",
            "REJECTED_WITH_REASON",
            "NEEDS_SUPERVISOR",
            "UNKNOWN_REVIEWER_NEEDS_CLASSIFICATION"
          ],
          "type": "string"
        },
        "item_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "classification",
        "reason"
      ],
      "type": "object"
    },
    "review_item": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "body_ref": {
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "author",
        "body_ref",
        "created_at"
      ],
      "type": "object"
    },
    "review_thread": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/definitions/review_item"
          },
          "type": "array"
        },
        "resolved": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "resolved",
        "blocking",
        "items"
      ],
      "type": "object"
    }
  },
  "properties": {
    "audit_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "base_branch": {
      "minLength": 1,
      "type": "string"
    },
    "blocking_thread_unresolved": {
      "type": "boolean"
    },
    "bot_comments": {
      "items": {
        "$ref": "#/definitions/review_item"
      },
      "type": "array"
    },
    "branch": {
      "minLength": 1,
      "type": "string"
    },
    "changed_files": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "conclusion": {
            "enum": [
              "success",
              "failure",
              "neutral",
              "cancelled",
              "skipped",
              "timed_out",
              "action_required",
              "pending",
              "unknown"
            ],
            "type": "string"
          },
          "head_sha": {
            "type": "string"
          },
          "matches_head_sha": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "in_progress",
              "completed",
              "unknown"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "conclusion",
          "head_sha"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "checks_stale_to_head": {
      "type": "boolean"
    },
    "commits": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "sha": {
            "type": "string"
          }
        },
        "required": [
          "sha",
          "message"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "diff_escapes_packet_allowlist": {
      "type": "boolean"
    },
    "failed_checks": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "head_sha": {
      "pattern": "^[a-fA-F0-9]{7,40}$",
      "type": "string"
    },
    "issue_comments": {
      "items": {
        "$ref": "#/definitions/review_item"
      },
      "type": "array"
    },
    "pr_number": {
      "minimum": 1,
      "type": "integer"
    },
    "proof_bundle_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "proof_stale": {
      "type": "boolean"
    },
    "repo": {
      "minLength": 1,
      "type": "string"
    },
    "review_comments": {
      "items": {
        "$ref": "#/definitions/review_item"
      },
      "type": "array"
    },
    "review_item_classifications": {
      "items": {
        "$ref": "#/definitions/review_classification"
      },
      "type": "array"
    },
    "review_threads": {
      "items": {
        "$ref": "#/definitions/review_thread"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "security_release_gate_lacks_approval": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "READY",
        "BLOCKED",
        "NEEDS_SUPERVISOR"
      ],
      "type": "string"
    },
    "unclassified_review_items": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "unknown_reviewers_or_bots": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "unresolved_blockers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "pr_number",
    "repo",
    "branch",
    "head_sha",
    "base_branch",
    "changed_files",
    "commits",
    "checks",
    "review_comments",
    "review_threads",
    "issue_comments",
    "bot_comments",
    "proof_bundle_refs",
    "audit_refs",
    "review_item_classifications",
    "unknown_reviewers_or_bots",
    "unclassified_review_items",
    "failed_checks",
    "checks_stale_to_head",
    "proof_stale",
    "blocking_thread_unresolved",
    "diff_escapes_packet_allowlist",
    "security_release_gate_lacks_approval",
    "unresolved_blockers",
    "status",
    "created_at"
  ],
  "title": "PR Steward Merge Readiness",
  "type": "object"
}
