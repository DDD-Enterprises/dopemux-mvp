{
  "$defs": {
    "access_path": {
      "enum": [
        "direct_api",
        "openrouter_paid",
        "openrouter_free",
        "local_self_hosted",
        "codex",
        "claude_code",
        "gemini_cli",
        "manual_app"
      ],
      "type": "string"
    },
    "audit_requirement": {
      "enum": [
        "none",
        "light",
        "embedded",
        "independent",
        "deep",
        "security",
        "release"
      ],
      "type": "string"
    },
    "blocked_reason": {
      "enum": [
        "UNKNOWN_PRIVACY_CLASS",
        "UNKNOWN_RISK_CLASS",
        "OPENROUTER_FREE_FORBIDDEN",
        "CONSUMER_APP_AUTHORITY_FORBIDDEN",
        "PREVIEW_SOLE_HIGH_RISK_AUTHORITY",
        "MISSING_BENCHMARK_CERTIFICATION",
        "MISSING_SCHEMA_VALIDATION",
        "MISSING_PROOF_REQUIREMENT",
        "MISSING_HUMAN_APPROVAL",
        "AUDIT_INDEPENDENCE_VIOLATION",
        "PROVIDER_MODEL_DRIFT",
        "FALLBACK_WEAKENS_GUARD",
        "PRIVACY_MISMATCH",
        "LIVE_WRITE_RUNNER_FORBIDDEN"
      ],
      "type": "string"
    },
    "lane_id": {
      "enum": [
        "public_read",
        "public_draft",
        "test_only",
        "local_edit",
        "multi_file_edit",
        "protected_authority",
        "release_supervisor",
        "unknown_fail_closed"
      ],
      "type": "string"
    },
    "privacy_class": {
      "enum": [
        "PUBLIC_SANDBOX",
        "PUBLIC_REPO",
        "PRIVATE_REPO_NO_SECRETS",
        "PRIVATE_REPO_POSSIBLE_SECRETS",
        "SECRET_BEARING",
        "CLIENT_DATA",
        "SECURITY_SENSITIVE",
        "RELEASE_AUTHORITY",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "proof_requirement": {
      "enum": [
        "minimal",
        "standard",
        "implementation",
        "security",
        "release",
        "unknown"
      ],
      "type": "string"
    },
    "risk_class": {
      "enum": [
        "R0_READ",
        "R1_DRAFT",
        "R2_TEST_ONLY",
        "R3_LOCAL_EDIT",
        "R4_MULTI_FILE_EDIT",
        "R5_SECURITY_OR_AUTHORITY",
        "R6_RELEASE_OR_PRODUCTION",
        "UNKNOWN"
      ],
      "type": "string"
    }
  },
  "$id": "https://schemas.dopemux.local/dcp_extension/routing/route_decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "SELECTED"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "access_path": {
            "$ref": "#/$defs/access_path"
          },
          "blocked_reasons": {
            "maxItems": 0
          },
          "selected_model": {
            "minLength": 1,
            "type": "string"
          },
          "selected_provider": {
            "enum": [
              "openai",
              "anthropic",
              "google",
              "openrouter",
              "local",
              "manual",
              "multiple"
            ],
            "type": "string"
          },
          "selected_route_id": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "BLOCKED",
              "ESCALATED",
              "NEEDS_SUPERVISOR"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "access_path": {
            "type": "null"
          },
          "blocked_reasons": {
            "minItems": 1
          },
          "selected_model": {
            "type": "null"
          },
          "selected_provider": {
            "type": "null"
          },
          "selected_route_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "privacy_class": {
            "const": "UNKNOWN"
          }
        },
        "required": [
          "privacy_class"
        ]
      },
      "then": {
        "properties": {
          "blocked_reasons": {
            "minItems": 1
          },
          "decision": {
            "enum": [
              "BLOCKED",
              "ESCALATED",
              "NEEDS_SUPERVISOR"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_class": {
            "const": "UNKNOWN"
          }
        },
        "required": [
          "risk_class"
        ]
      },
      "then": {
        "properties": {
          "blocked_reasons": {
            "minItems": 1
          },
          "decision": {
            "enum": [
              "BLOCKED",
              "ESCALATED",
              "NEEDS_SUPERVISOR"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "access_path": {
            "const": "openrouter_free"
          }
        },
        "required": [
          "access_path"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "properties": {
                "lane_id": {
                  "enum": [
                    "protected_authority",
                    "release_supervisor",
                    "unknown_fail_closed"
                  ]
                }
              },
              "required": [
                "lane_id"
              ]
            },
            {
              "properties": {
                "privacy_class": {
                  "enum": [
                    "PRIVATE_REPO_NO_SECRETS",
                    "PRIVATE_REPO_POSSIBLE_SECRETS",
                    "SECRET_BEARING",
                    "CLIENT_DATA",
                    "SECURITY_SENSITIVE",
                    "RELEASE_AUTHORITY",
                    "UNKNOWN"
                  ]
                }
              },
              "required": [
                "privacy_class"
              ]
            },
            {
              "properties": {
                "risk_class": {
                  "enum": [
                    "R5_SECURITY_OR_AUTHORITY",
                    "R6_RELEASE_OR_PRODUCTION",
                    "UNKNOWN"
                  ]
                }
              },
              "required": [
                "risk_class"
              ]
            },
            {
              "properties": {
                "proof_requirement": {
                  "enum": [
                    "security",
                    "release"
                  ]
                }
              },
              "required": [
                "proof_requirement"
              ]
            },
            {
              "properties": {
                "audit_requirement": {
                  "enum": [
                    "independent",
                    "deep",
                    "security",
                    "release"
                  ]
                }
              },
              "required": [
                "audit_requirement"
              ]
            }
          ]
        }
      }
    }
  ],
  "description": "Contracts-only DCP route decision. This schema records selected or blocked routing decisions; it does not authorize runtime routing or provider execution.",
  "properties": {
    "access_path": {
      "anyOf": [
        {
          "$ref": "#/$defs/access_path"
        },
        {
          "type": "null"
        }
      ]
    },
    "audit_requirement": {
      "$ref": "#/$defs/audit_requirement"
    },
    "benchmark_certification_ref": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "blocked_reasons": {
      "items": {
        "$ref": "#/$defs/blocked_reason"
      },
      "type": "array",
      "uniqueItems": true
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "decision": {
      "enum": [
        "SELECTED",
        "BLOCKED",
        "ESCALATED",
        "NEEDS_SUPERVISOR"
      ],
      "type": "string"
    },
    "decision_id": {
      "pattern": "^rd_[A-Za-z0-9_.:-]+$",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "human_gate_required": {
      "type": "boolean"
    },
    "lane_id": {
      "$ref": "#/$defs/lane_id"
    },
    "live_write_runner_selected": {
      "const": false,
      "type": "boolean"
    },
    "privacy_class": {
      "$ref": "#/$defs/privacy_class"
    },
    "proof_requirement": {
      "$ref": "#/$defs/proof_requirement"
    },
    "risk_class": {
      "$ref": "#/$defs/risk_class"
    },
    "schema_version": {
      "const": "dcp.routing.route_decision.v0",
      "type": "string"
    },
    "selected_model": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "selected_provider": {
      "enum": [
        "openai",
        "anthropic",
        "google",
        "openrouter",
        "local",
        "manual",
        "multiple",
        "unknown",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "selected_route_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "task_ref": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "task_ref",
    "lane_id",
    "privacy_class",
    "risk_class",
    "decision",
    "selected_route_id",
    "selected_provider",
    "selected_model",
    "access_path",
    "live_write_runner_selected",
    "blocked_reasons",
    "proof_requirement",
    "audit_requirement",
    "human_gate_required",
    "benchmark_certification_ref",
    "evidence_refs",
    "created_at"
  ],
  "title": "DCP Routing Extension Route Decision Contract",
  "type": "object"
}
