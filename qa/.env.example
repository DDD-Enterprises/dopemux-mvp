# qa/.env.example — Template env file for the dopemux-qa isolated stack.
# Copy to qa/.env and fill in values before running the QA harness.
# All ports are offset +40 from live defaults to avoid collision with
# any running A–E instance stacks.

# ── Compose project identity (NEVER change this) ──────────────────────────────
COMPOSE_PROJECT_NAME=dopemux-qa
DOPEMUX_INSTANCE_ID=E

# ── QA docker network ─────────────────────────────────────────────────────────
QA_NETWORK=dopemux-qa-network

# ── QA workspace path (used by install + cli tests) ───────────────────────────
QA_WORKSPACE_PATH=/tmp/dopemux-qa-workspace

# ── Database (Postgres) ───────────────────────────────────────────────────────
# Live default: 5432   QA offset: +40
QA_POSTGRES_PORT=5472
POSTGRES_PORT=5472
POSTGRES_DB=dopemux_qa
POSTGRES_USER=dopemux
POSTGRES_PASSWORD=dopemux_qa_password

# ── Redis (events stream) ─────────────────────────────────────────────────────
# Live default: 6379   QA offset: +40
QA_REDIS_EVENTS_PORT=6419
REDIS_EVENTS_PORT=6419

# ── Redis (primary / cache) ───────────────────────────────────────────────────
# Live default: 6380   QA offset: +40
QA_REDIS_PRIMARY_PORT=6420
REDIS_PRIMARY_PORT=6420

# ── ConPort HTTP API ──────────────────────────────────────────────────────────
# Live default: 3004   QA offset: +40
QA_CONPORT_HTTP_PORT=3044
CONPORT_HTTP_PORT=3044

# ── ConPort MCP endpoint ──────────────────────────────────────────────────────
# Live default: 3005   QA offset: +40
QA_CONPORT_MCP_PORT=3045
CONPORT_MCP_PORT=3045

# ── ConPort info/introspection port ──────────────────────────────────────────
# Live default: 4004   (no QA offset needed — not exposed externally)
CONPORT_INFO_PORT=4004

# ── PAL (multi-model reasoning) ───────────────────────────────────────────────
# Live default: 3003   QA offset: +40
QA_PAL_PORT=3043
PAL_PORT=3043

# ── LiteLLM proxy ─────────────────────────────────────────────────────────────
# Live default: 4000   QA offset: +40
QA_LITELLM_PORT=4040
LITELLM_PORT=4040

# ── Dope-Context (semantic search) ───────────────────────────────────────────
# Live default: 3010   QA offset: +40
QA_DOPE_CONTEXT_PORT=3050
DOPE_CONTEXT_PORT=3050

# ── Qdrant vector DB (HTTP) ───────────────────────────────────────────────────
# Live default: 6333   QA offset: +40
QA_QDRANT_PORT=6373
QDRANT_PORT=6373

# ── Qdrant vector DB (gRPC) ───────────────────────────────────────────────────
# Live default: 6334   QA offset: +40
QA_QDRANT_GRPC_PORT=6374
QDRANT_GRPC_PORT=6374

# ── Redis UI (RedisInsight) ───────────────────────────────────────────────────
# Live default: 8081   (not offset — QA stack typically skips this service)
REDIS_UI_PORT=8081

# ── Leantime (project management) ────────────────────────────────────────────
# Live default: 8080   QA offset: +40
QA_LEANTIME_PORT=8120
LEANTIME_PORT=8120

# ── API keys — leave empty to keep live-lane tests disabled ──────────────────
# Set DPMX_LIVE_OK=1 and fill in keys to enable real-API test scenarios.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Live-lane gate ────────────────────────────────────────────────────────────
# 0 = skip all scenarios that make real LLM calls (default / CI safe)
# 1 = enable live-lane (requires valid API keys + explicit opt-in)
DPMX_LIVE_OK=0

# ── Spend cap for live-lane scenarios (USD) ───────────────────────────────────
DPMX_QA_SPEND_CAP_USD=0.10
