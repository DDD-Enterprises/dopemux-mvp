{
  "name": "cheaperinference-audit",
  "runner": "cheaperinference",
  "command": "cheaperinference",
  "additional_args": [
    "--no-interactive",
    "--output-format",
    "json"
  ],
  "env": {
    "CHEAPERINFERENCE_BASE_URL": "https://api.cheaperinference.com/v1"
  },
  "roles": {
    "codereviewer": {
      "prompt_path": "systemprompts/clink/default_codereviewer.txt",
      "role_args": []
    }
  }
}
