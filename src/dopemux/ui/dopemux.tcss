/* Dopemux Direction B Electric Refresh — shared Textual CSS
 *
 * Source of truth: claudedocs/design/tokens.json
 * Generated by: claudedocs/design/generate_tokens.py
 * Used by: dashboard.py, dashboard_detail.py
 */

$base: #020617;
$mantle: #041628;
$crust: #081832;
$text: #E2E8F0;
$text-dim: #94A3B8;
$text-muted: #808DA0;
$green: #00FF85;
$blue: #2FFFF0;
$mauve: #C07BFF;
$red: #FF2255;
$peach: #FFCF78;
$yellow: #FFE600;
$mint-dim: #4A9E94;

/* ── Global ── */

Screen {
    background: $base;
    color: $text;
}

/* ── DataTable ── */

DataTable {
    background: $mantle;
    color: $text;
    border: none;
}

DataTable > .datatable--header {
    background: $crust;
    color: $mauve;
    text-style: bold;
}

/* ── Panels ── */

#adhd-state {
    height: 6;
    border: solid $green;
    background: $mantle;
}

#productivity {
    height: 6;
    border: solid $blue;
    background: $mantle;
}

#services {
    height: 8;
    border: solid $mauve;
    background: $mantle;
}

#trends {
    height: 6;
    border: solid $peach;
    background: $mantle;
}

/* ── Detail view ── */

TabbedContent {
    background: $mantle;
    border: solid $blue;
}

TabPane {
    background: $mantle;
    padding: 1;
}

Log {
    background: $base;
    color: $text;
    border: solid $mint-dim;
    text-style: bold;
}

.status-active {
    color: $blue;
    text-style: bold;
}

.status-error {
    color: $red;
    text-style: bold;
}

.status-warning {
    color: $yellow;
    text-style: bold;
}

#demo-banner {
    height: 1;
    background: $yellow;
    color: $base;
    text-align: center;
    text-style: bold;
}
