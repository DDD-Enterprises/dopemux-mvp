{
  "mcpServers": {
    "MCP_DOCKER": {
      "args": [
        "mcp",
        "gateway",
        "run"
      ],
      "command": "docker",
      "description": "Docker MCP gateway \u2014 surfaces containerized MCPs from Docker MCP Toolkit",
      "type": "stdio"
    },
    "dope-context": {
      "description": "AST-aware semantic code & docs search; per-call workspace_path",
      "type": "http",
      "url": "http://localhost:3010/mcp"
    },
    "gpt-researcher": {
      "args": [
        "exec",
        "-i",
        "dopemux-mcp-gptr-mcp",
        "python",
        "/app/server.py"
      ],
      "command": "docker",
      "description": "Deep multi-source research (PR #575: gpt-researcher==0.14.8 pinned)",
      "env": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY:-}",
        "EXA_API_KEY": "${EXA_API_KEY:-}",
        "OPENAI_API_KEY": "${OPENAI_API_KEY:-}",
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY:-}",
        "TAVILY_API_KEY": "${TAVILY_API_KEY:-}"
      },
      "type": "stdio"
    },
    "pal-stdio": {
      "args": [
        "exec",
        "-i",
        "mcp-pal-stdio",
        "/app/.venv/bin/python",
        "server.py"
      ],
      "command": "docker",
      "description": "PAL via Docker MCP (thinkdeep, planner, consensus, debug, codereview, precommit) \u2014 the sole PAL MCP surface (P0 claim 11)",
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY:-}",
        "OPENAI_API_KEY": "${OPENAI_API_KEY:-}"
      },
      "type": "stdio"
    },
    "serena": {
      "description": "Semantic code intelligence (LSP + Tree-sitter); workspace auto-detected from cwd. Write-lane gating owned by DMX-ARCH-SERENA-SURFACE-003.",
      "type": "http",
      "url": "http://localhost:3006/mcp"
    }
  }
}
