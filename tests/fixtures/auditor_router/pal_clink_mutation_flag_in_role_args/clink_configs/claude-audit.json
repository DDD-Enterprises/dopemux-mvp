{
  "name": "claude-audit",
  "runner": "claude",
  "command": "claude",
  "additional_args": [
    "--permission-mode",
    "plan",
    "--model",
    "sonnet"
  ],
  "env": {},
  "roles": {
    "default": {
      "prompt_path": "systemprompts/clink/default_codereviewer.txt",
      "role_args": []
    },
    "codereviewer": {
      "prompt_path": "systemprompts/clink/default_codereviewer.txt",
      "role_args": [
        "--allow-all-tools"
      ]
    }
  }
}
